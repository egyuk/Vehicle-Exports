---
const aboutLinks = [
  { name: 'About us', href: '/about' },
  { name: 'Car Shipping to Kenya', href: '/import-uk-cars/kenya' },
  { name: 'Car Shipping to Ireland', href: '/car-shipping/ireland' },
  { name: 'Dealer Listings', href: '/carsforexport' },
  { name: 'Sale Agents', href: '/about' },
  { name: 'Blog List', href: '/car-export-news' },
  { name: 'FAQs', href: '/faq' },
];

const vehicleExportingLinks = [
  { name: 'UK Cars for Export or Shipping', href: '/carsforexport' },
  { name: 'Car Shipping to Kenya and Mombasa Import', href: '/import-uk-cars/kenya' },
  { name: 'UK Ambulance Exports', href: '/ambulance-emergency-shipping-exports-from-uk' },
  { name: 'USA Car Shipping Import', href: '/usa-import-america-car-shipping' },
  { name: 'Car Shipping to Hong Kong and Imports', href: '/shipping-export-uk-to-hong-kong' },
  { name: 'UK VAT Reclaiming on Exported Cars', href: '/how-to-reclaim-vat-on-vehicles-exported-from-eu-uk' },
  { name: 'UK Cars for Export or Shipping', href: '/carsforexport' },
];

const popularCars = [
  { name: 'KIA', href: '/carsforexport/kia' },
  { name: 'Ford', href: '/carsforexport/ford' },
  { name: 'Toyota', href: '/carsforexport/toyota' },
  { name: 'Land Rover', href: '/carsforexport/land-rover' },
  { name: 'Mercedes Benz', href: '/carsforexport/mercedes-benz' },
  { name: 'BMW', href: '/carsforexport/bmw' },
  { name: 'Nissan', href: '/carsforexport/nissan' },
];

const otherLinks = [
  { name: 'Import a Car from UK', href: '/import-uk-cars' },
  { name: 'Ship a Car from UK', href: '/car-shipping' },
  { name: 'New and Used Container Sales', href: '/container-sales' },
];

// Small print row along the bottom of the footer
const legalLinks = [
  { name: 'Privacy Notice', href: '#' },
  { name: 'Terms and Conditions', href: '#' },
  { name: 'Cookie Policy', href: '#' },
];

const companyNumber = '10399100';
---

<footer class="bg-white text-[var(--color-gray-text)] border-t border-[var(--color-gray-border)] font-[family-name:var(--font-heading)]">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-6 sm:gap-10">
      <!-- About UK Vehicle Exporters -->
      <div>
        <h3 class="text-[var(--color-dark)] font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">About UK Vehicle Exporters</h3>
        <ul class="space-y-3">
          {aboutLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-gray-text)] hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Vehicle Exporting -->
      <div>
        <h3 class="text-[var(--color-dark)] font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Vehicle Exporting</h3>
        <ul class="space-y-3">
          {vehicleExportingLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-gray-text)] hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popular Used Car -->
      <div>
        <h3 class="text-[var(--color-dark)] font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Popular Used Car</h3>
        <ul class="space-y-3">
          {popularCars.map(link => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-gray-text)] hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Other -->
      <div>
        <h3 class="text-[var(--color-dark)] font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Other</h3>
        <ul class="space-y-3">
          {otherLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-gray-text)] hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter — full width until the 5-column layout kicks in at lg -->
      <div class="col-span-2 lg:col-span-1">
        <h3 class="text-[var(--color-dark)] font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Newsletter</h3>
        <p class="text-sm text-[var(--color-gray-text)] mb-5">
          Stay on top of the latest car trends. Subscribe to our newsletter for updates and deals.
        </p>
        <form class="space-y-3" onsubmit="event.preventDefault()">
          <input
            type="email"
            placeholder="Your email address"
            class="w-full px-4 py-3 bg-[var(--color-gray-light)] border border-[var(--color-gray-border)] rounded-lg text-[var(--color-dark)] placeholder-gray-400 text-sm focus:outline-none focus:border-[var(--color-primary)] transition-colors"
          />
          <button type="submit" class="w-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-lg text-sm font-semibold transition-all">
            Send
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-[var(--color-gray-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-10">
      <!-- Legal links on the left, social icons on the right -->
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex flex-wrap gap-x-8 gap-y-3">
          {legalLinks.map(link => (
            <a href={link.href} class="text-[15px] text-[var(--color-dark)] hover:text-[var(--color-primary)] transition-colors">{link.name}</a>
          ))}
        </div>
        <!-- Social Icons -->
        <div class="flex items-center gap-4 shrink-0">
        <a href="https://www.facebook.com/UKVehicleExporters/" target="_blank" rel="noopener" class="w-[1.62rem] h-[1.62rem] bg-[var(--color-dark)] text-white hover:bg-[var(--color-primary)] rounded flex items-center justify-center transition-colors" aria-label="Facebook">
          <svg class="w-[0.72rem] h-[0.72rem]" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
        </a>
        <a href="https://www.youtube.com/@uk_vehicle_exporters" target="_blank" rel="noopener" class="w-[1.62rem] h-[1.62rem] bg-[var(--color-dark)] text-white hover:bg-[var(--color-primary)] rounded flex items-center justify-center transition-colors" aria-label="YouTube">
          <svg class="w-[0.72rem] h-[0.72rem]" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <a href="https://x.com/vehicle_exports" target="_blank" rel="noopener" class="w-[1.62rem] h-[1.62rem] bg-[var(--color-dark)] text-white hover:bg-[var(--color-primary)] rounded flex items-center justify-center transition-colors" aria-label="X">
          <svg class="w-[0.72rem] h-[0.72rem]" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://www.instagram.com/uk_vehicle_exporters/" target="_blank" rel="noopener" class="w-[1.62rem] h-[1.62rem] bg-[var(--color-dark)] text-white hover:bg-[var(--color-primary)] rounded flex items-center justify-center transition-colors" aria-label="Instagram">
          <svg class="w-[0.72rem] h-[0.72rem]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://uk.linkedin.com/company/uk-vehicle-exporters" target="_blank" rel="noopener" class="w-[1.62rem] h-[1.62rem] bg-[var(--color-dark)] text-white hover:bg-[var(--color-primary)] rounded flex items-center justify-center transition-colors" aria-label="LinkedIn">
          <svg class="w-[0.72rem] h-[0.72rem]" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="#" target="_blank" rel="noopener" class="w-[1.62rem] h-[1.62rem] bg-[var(--color-dark)] text-white hover:bg-[var(--color-primary)] rounded flex items-center justify-center transition-colors" aria-label="TikTok">
          <svg class="w-[0.72rem] h-[0.72rem]" fill="currentColor" viewBox="0 0 24 24"><path d="M16.6 5.82s.51.5 0 0A4.278 4.278 0 0115.54 3h-3.09v12.4a2.592 2.592 0 01-2.59 2.5c-1.42 0-2.59-1.16-2.59-2.5 0-1.4 1.24-2.5 2.59-2.5.27 0 .53.05.77.13V9.86a5.86 5.86 0 00-.77-.05A5.62 5.62 0 003.3 15.4a5.62 5.62 0 005.62 5.58 5.62 5.62 0 005.62-5.58V9.01a7.315 7.315 0 004.09 1.24V7.16s-1.71.08-2.03-1.34z"/></svg>
          </a>
          <a href="https://wa.me/447851068089" target="_blank" rel="noopener" class="w-[1.62rem] h-[1.62rem] bg-[var(--color-dark)] text-white hover:bg-[var(--color-primary)] rounded flex items-center justify-center transition-colors" aria-label="WhatsApp">
            <svg class="w-[0.72rem] h-[0.72rem]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.465 3.488"/></svg>
          </a>
        </div>
      </div>

      <!-- Company small print -->
      <p class="mt-8 text-sm leading-relaxed text-[var(--color-gray-text)]">
        UK Vehicle Exporters Ltd are <a href="/" class="hover:text-[var(--color-primary)] transition-colors">UK Car Exporters</a>, Vehicle Sourcing
        and Shipping Company registered in England, Northern Ireland and Wales, company number {companyNumber} with their registered office at
        Penstraze Business Centre, Truro, Cornwall, TR4 8PN. We handle Car Sourcing and Buying on you behalf, VAT-free supply and VAT reclaiming,
        inspections, UK customs clearance and shipping.
      </p>

      <!-- Copyright — update the year by hand each January -->
      <p class="mt-6 text-sm text-[var(--color-gray-text)]">
&copy; Copyright 2026 - UK Vehicle Exporters. All rights reserved.
      </p>
    </div>
  </div>
</footer>
