---
const currentYear = new Date().getFullYear();

const aboutLinks = [
  { name: 'About us', href: '/about' },
  { name: 'Car Shipping to Kenya', href: '/import-cars-kenya' },
  { name: 'Car Shipping to Ireland', href: '/car-shipping/ireland' },
  { name: 'Dealer Listings', href: '/carsforexport' },
  { name: 'Sale Agents', href: '/about' },
  { name: 'Contact us', href: '/contact' },
  { name: 'Blog List', href: '/car-export-news' },
  { name: 'FAQs', href: '/faq' },
];

const vehicleExportingLinks = [
  { name: 'UK Cars for Export or Shipping', href: '/carsforexport' },
  { name: 'Car Shipping to Kenya and Mombasa Import', href: '/import-cars-kenya' },
  { name: 'UK Ambulance Exports', href: '/ambulance-emergency-shipping-exports-from-uk' },
  { name: 'USA Car Shipping Import', href: '/usa-import-america-car-shipping' },
  { name: 'Car Shipping to Hong Kong and Imports', href: '/shipping-export-uk-to-hong-kong' },
  { name: 'UK VAT Reclaiming on Exported Cars', href: '/how-to-reclaim-vat-on-vehicles-exported-from-eu-uk' },
  { name: 'UK Cars for Export or Shipping', href: '/carsforexport' },
  { name: 'Contact Us', href: '/contact' },
];

const popularCars = [
  { name: 'KIA', href: '/carsforexport/kia' },
  { name: 'Ford', href: '/carsforexport/ford' },
  { name: 'Toyota', href: '/carsforexport/toyota' },
  { name: 'Land Rover', href: '/carsforexport/land-rover' },
  { name: 'Mercedes Benz', href: '/carsforexport/mercedes-benz' },
  { name: 'BMW', href: '/carsforexport/bmw' },
  { name: 'Nissan', href: '/carsforexport/nissan' },
];

const otherLinks = [
  { name: 'How it work', href: '/about' },
  { name: 'Terms and Conditions', href: '#' },
  { name: 'Privacy Policy', href: '#' },
  { name: 'Copyrights', href: '#' },
  { name: 'Help center', href: '/contact' },
  { name: 'Car sales trends', href: '/car-export-news' },
  { name: 'Personal loan', href: '/contact' },
];
---

<footer class="bg-[var(--color-dark)] text-gray-300">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-6 sm:gap-10">
      <!-- About UK Vehicle Exporters -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">About UK Vehicle Exporters</h3>
        <ul class="space-y-3">
          {aboutLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Vehicle Exporting -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Vehicle Exporting</h3>
        <ul class="space-y-3">
          {vehicleExportingLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popular Used Car -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Popular Used Car</h3>
        <ul class="space-y-3">
          {popularCars.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Other -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Other</h3>
        <ul class="space-y-3">
          {otherLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Newsletter</h3>
        <p class="text-sm text-gray-400 mb-5">
          Stay on top of the latest car trends. Subscribe to our newsletter for updates and deals.
        </p>
        <form class="space-y-3" onsubmit="event.preventDefault()">
          <input
            type="email"
            placeholder="Your email address"
            class="w-full px-4 py-3 bg-white/10 border border-white/10 rounded-lg text-white placeholder-gray-500 text-sm focus:outline-none focus:border-[var(--color-primary)] transition-colors"
          />
          <button type="submit" class="w-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-lg text-sm font-semibold transition-all">
            Send
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col items-center gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <span class="text-lg font-bold text-white font-[family-name:var(--font-heading)]">UK <span class="text-[var(--color-primary)]">Vehicle</span> Exporters</span>
      </a>
      <!-- Copyright -->
      <span class="text-sm text-gray-500">&copy; {currentYear} <a href="/" class="hover:text-[var(--color-primary)] transition-colors">UK Vehicle Exporters</a>. All rights reserved.</span>
      <!-- Social Icons -->
      <div class="flex items-center gap-4">
        <a href="https://www.facebook.com/UKVehicleExporters/" target="_blank" rel="noopener" class="w-10 h-10 bg-white/5 hover:bg-[var(--color-primary)] rounded-full flex items-center justify-center transition-colors" aria-label="Facebook">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
        </a>
        <a href="https://www.youtube.com/@uk_vehicle_exporters" target="_blank" rel="noopener" class="w-10 h-10 bg-white/5 hover:bg-[var(--color-primary)] rounded-full flex items-center justify-center transition-colors" aria-label="YouTube">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <a href="https://x.com/vehicle_exports" target="_blank" rel="noopener" class="w-10 h-10 bg-white/5 hover:bg-[var(--color-primary)] rounded-full flex items-center justify-center transition-colors" aria-label="X">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://www.instagram.com/uk_vehicle_exporters/" target="_blank" rel="noopener" class="w-10 h-10 bg-white/5 hover:bg-[var(--color-primary)] rounded-full flex items-center justify-center transition-colors" aria-label="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
