---
const currentYear = new Date().getFullYear();

const aboutLinks = [
  { name: 'About us', href: '/about' },
  { name: 'Car Shipping to Kenya', href: '/import-cars-kenya' },
  { name: 'Car Shipping to Ireland', href: '/car-shipping-to-ireland' },
  { name: 'Dealer Listings', href: '/cars' },
  { name: 'Sale Agents', href: '/about' },
  { name: 'Contact us', href: '/contact' },
  { name: 'Blog List', href: '/blog' },
  { name: 'FAQs', href: '/faq' },
];

const popularCars = [
  { name: 'KIA', href: '/cars/kia' },
  { name: 'Ford', href: '/cars/ford' },
  { name: 'Toyota', href: '/cars/toyota' },
  { name: 'Land Rover', href: '/cars/land-rover' },
  { name: 'Mercedes Benz', href: '/cars/mercedes-benz' },
  { name: 'BMW', href: '/cars/bmw' },
  { name: 'Nissan', href: '/cars/nissan' },
];

const otherLinks = [
  { name: 'How it work', href: '/about' },
  { name: 'Terms and Conditions', href: '#' },
  { name: 'Privacy Policy', href: '#' },
  { name: 'Copyrights', href: '#' },
  { name: 'Help center', href: '/contact' },
  { name: 'Car sales trends', href: '/blog' },
  { name: 'Personal loan', href: '/contact' },
];
---

<footer class="bg-[var(--color-dark)] text-gray-300">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-10">
      <!-- About Auto Deal -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">About Auto Deal</h3>
        <ul class="space-y-3">
          {aboutLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popular Used Car -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Popular Used Car</h3>
        <ul class="space-y-3">
          {popularCars.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Other -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Other</h3>
        <ul class="space-y-3">
          {otherLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-[var(--color-primary)] transition-colors flex items-center gap-2">

                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-5 font-[family-name:var(--font-heading)]">Newsletter</h3>
        <p class="text-sm text-gray-400 mb-5">
          Stay on top of the latest car trends. Subscribe to our newsletter for updates and deals.
        </p>
        <form class="space-y-3" onsubmit="event.preventDefault()">
          <input
            type="email"
            placeholder="Your email address"
            class="w-full px-4 py-3 bg-white/10 border border-white/10 rounded-lg text-white placeholder-gray-500 text-sm focus:outline-none focus:border-[var(--color-primary)] transition-colors"
          />
          <button type="submit" class="w-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-lg text-sm font-semibold transition-all">
            Send
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col items-center gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div class="w-9 h-9 bg-[var(--color-primary)] rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
        </div>
        <span class="text-lg font-bold text-white font-[family-name:var(--font-heading)]">Auto<span class="text-[var(--color-primary)]">Deal</span></span>
      </a>
      <!-- Copyright -->
      <span class="text-sm text-gray-500">&copy; {currentYear} AutoDeal. All rights reserved.</span>
      <!-- Social Icons -->
      <div class="flex items-center gap-4">
        <a href="#" class="w-10 h-10 bg-white/5 hover:bg-[var(--color-primary)] rounded-full flex items-center justify-center transition-colors" aria-label="Facebook">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
        </a>
        <a href="#" class="w-10 h-10 bg-white/5 hover:bg-[var(--color-primary)] rounded-full flex items-center justify-center transition-colors" aria-label="LinkedIn">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"/></svg>
        </a>
        <a href="#" class="w-10 h-10 bg-white/5 hover:bg-[var(--color-primary)] rounded-full flex items-center justify-center transition-colors" aria-label="Twitter">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
        </a>
        <a href="#" class="w-10 h-10 bg-white/5 hover:bg-[var(--color-primary)] rounded-full flex items-center justify-center transition-colors" aria-label="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
