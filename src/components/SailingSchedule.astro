---
// Country-filtered slice of the sailing schedule, in the same format as
// /export-sailing-schedule. Reads the same data file, so the weekly refresh
// updates every country page at once with no per-page maintenance.
//
//   <SailingSchedule country="Kenya" />
//   <SailingSchedule country="Ghana" heading="Sailings to Ghana" limit={8} />
import schedules from '../data/sailing-schedules.json';

interface Props {
  /** Matches the country after the comma in a destination, e.g. "Mombasa, Kenya". */
  country: string;
  heading?: string;
  intro?: string;
  limit?: number;
  background?: 'white' | 'gray';
  /**
   * true  - renders its own full-width section with padding and background.
   * false - renders bare, for dropping inside a page's existing content column
   *         (the country pages nest their sections in a narrower column).
   */
  standalone?: boolean;
  /** Anchor id, so a page's table of contents can link to it. */
  id?: string;
}

const {
  country,
  heading = `Sailings to ${country}`,
  intro,
  limit = 6,
  background = 'white',
  standalone = true,
  id,
} = Astro.props;

const { updated, sailings } = schedules;
const today = new Date().toISOString().slice(0, 10);

const fmtDate = (d: string) =>
  d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';

const transitDays = (ets: string, eta: string) =>
  ets && eta ? Math.round((new Date(eta).getTime() - new Date(ets).getTime()) / 86400000) : null;

// Match on the country portion so "Mombasa, Kenya" is found but a vessel or
// port that merely contains the word is not.
const matches = (destination: string) => {
  const parts = destination.split(',').map(p => p.trim());
  return parts.length > 1
    ? parts[parts.length - 1].toLowerCase() === country.toLowerCase()
    : destination.toLowerCase() === country.toLowerCase();
};

const upcoming = sailings
  .filter(s => matches(s.destination) && s.ets >= today)
  .sort((a, b) => a.ets.localeCompare(b.ets));

const rows = upcoming.slice(0, limit).map(s => ({ ...s, transit: transitDays(s.ets, s.eta) }));
const ports = [...new Set(upcoming.map(s => s.loadPort))];
const sectionBg = background === 'gray' ? 'bg-gray-50' : 'bg-white';
---

<section id={id} class={standalone ? `py-16 lg:py-20 ${sectionBg}` : ''}>
  <div class={standalone ? 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8' : ''}>
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)]">{heading}</h2>
        <p class="text-gray-600 mt-2 max-w-2xl leading-relaxed">
          {intro ?? (ports.length
            ? `Next sailings from ${ports.join(' and ')}. Dates are carrier estimates and must be reconfirmed before booking.`
            : 'Dates are carrier estimates and must be reconfirmed before booking.')}
        </p>
      </div>
      <span class="text-xs text-gray-400 shrink-0">Updated {fmtDate(updated)}</span>
    </div>

    {rows.length > 0 ? (
      <>
        <div class="border border-gray-200 rounded-xl overflow-x-auto">
          <!-- No Voyage column here: on a country page's narrower content column
               it pushed the table into sideways scrolling. The full schedule at
               /export-sailing-schedule still carries it. -->
          <table class="w-full text-sm min-w-[620px]">
            <thead>
              <tr class="bg-gray-50 text-left border-b border-gray-200">
                <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Departure</th>
                <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Load port</th>
                <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Destination</th>
                <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Arrival</th>
                <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Transit</th>
                <th class="px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Vessel</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(s => (
                <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50/70 transition-colors">
                  <td class="px-4 py-3 font-semibold text-gray-900 whitespace-nowrap">{fmtDate(s.ets)}</td>
                  <td class="px-4 py-3 text-gray-900 whitespace-nowrap">{s.loadPort}</td>
                  <td class="px-4 py-3 text-gray-900 font-medium whitespace-nowrap">{s.destination}</td>
                  <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{fmtDate(s.eta)}</td>
                  <td class="px-4 py-3 text-gray-500 whitespace-nowrap">{s.transit !== null ? `${s.transit} days` : '—'}</td>
                  <td class="px-4 py-3 text-gray-700 whitespace-nowrap">{s.vessel}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="flex flex-wrap items-center gap-4 mt-5">
          <a href="/export-sailing-schedule" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] hover:underline">
            Full sailing schedule
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
          {upcoming.length > rows.length && (
            <span class="text-sm text-gray-400">Showing {rows.length} of {upcoming.length} sailings</span>
          )}
          <a href="/contact" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-[var(--color-primary)] transition-colors">
            Export a car on above sailings
          </a>
        </div>
      </>
    ) : (
      <div class="border border-gray-200 rounded-xl bg-gray-50 px-5 py-6">
        <p class="text-gray-600 text-sm leading-relaxed">
          No confirmed sailings to {country} are listed at the moment. Sailings are added as carriers publish them —
          <a href="/contact" class="text-[var(--color-primary)] font-semibold hover:underline">get in touch</a> and we will
          confirm the next available departure, or
          <a href="/export-sailing-schedule" class="text-[var(--color-primary)] font-semibold hover:underline">browse all destinations</a>.
        </p>
      </div>
    )}
  </div>
</section>
