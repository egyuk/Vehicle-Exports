<style>
  /* Touch devices: .open (toggled by tap) mirrors the hover-revealed dropdown state.
     Only cancel the slide-in Y offset: the Shipping panel is centred on its nav
     item with -translate-x-1/2, so wiping the whole translate would shift it. */
  #main-nav :global(.group.open > div) {
    opacity: 1;
    pointer-events: auto;
    --tw-translate-y: 0;
  }
  #main-nav :global(.group.open > a > svg) {
    rotate: 180deg;
  }
</style>

<script>
  import { addScrollEffect } from '../scripts/scroll-effects';

  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');
  let menuOpen = false;

  function setMenu(open) {
    menuOpen = open;
    menu?.classList.toggle('-translate-y-full', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  }

  btn?.addEventListener('click', () => setMenu(!menuOpen));

  // Touch devices showing the desktop nav (e.g. iPad landscape) have no
  // hover, so the first tap opens a dropdown and the second follows the link.
  if (window.matchMedia('(hover: none)').matches) {
    const groups = [...document.querySelectorAll('#main-nav .group')];
    const closeAll = () => groups.forEach(g => g.classList.remove('open'));
    groups.forEach(g => {
      if (!g.querySelector(':scope > div')) return; // no dropdown panel
      g.querySelector(':scope > a')?.addEventListener('click', e => {
        if (!g.classList.contains('open')) {
          e.preventDefault();
          closeAll();
          g.classList.add('open');
        }
      });
    });
    document.addEventListener('click', e => {
      if (!groups.some(g => g.contains(e.target as Node))) closeAll();
    });
  }

  document.querySelectorAll('.mobile-dropdown-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const dropdown = btn.nextElementSibling;
      const arrow = btn.querySelector('svg');
      dropdown?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });
  });

  const mainNav = document.getElementById('main-nav');
  if (mainNav) {
    let isSticky = false;
    addScrollEffect(
      () => window.scrollY > 100,
      shouldStick => {
        if (shouldStick === isSticky) return;
        isSticky = shouldStick;
        mainNav.classList.toggle('header-sticky', shouldStick);
      }
    );
  }
</script>