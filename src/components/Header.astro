---
const navLinks = [
  {
    name: 'Our Export Services',
    href: '/car-shipping/destinations',
    mega: {
      columns: [
        {
          title: 'Exporting with UK Vehicle Exporters',
          links: [
            { name: 'About Us', href: '/about', desc: 'Who we are and how we work.' },
            { name: 'Complete Export Guide', href: '/car-export-news/complete-guide-exporting-vehicles-from-uk', desc: 'How UK vehicle export works, start to finish.' },
            { name: 'Shipping Costs Explained', href: '/car-export-news/understanding-vehicle-shipping-costs', desc: 'What shipping your vehicle really costs.' },
            { name: 'Vehicle History Checks', href: '/car-export-news/how-to-check-uk-vehicle-history-before-buying', desc: 'Buy with confidence, verified history.' },
            { name: 'Export FAQ', href: '/faq', desc: 'Answers to the questions we hear most.' },
          ],
        },
        {
          title: 'Vehicles to Export',
          links: [
            { name: 'All Vehicles', href: '/shipping-cars', desc: 'Every vehicle ready for export.' },
            { name: 'SUVs & 4x4s', href: '/shipping-cars/body/suv', desc: 'Our most exported category.' },
            { name: 'Pickup Trucks', href: '/shipping-cars/body/pickup-truck', desc: 'Workhorses built for any terrain.' },
            { name: 'Luxury & Performance', href: '/shipping-cars/body/coupe', desc: 'Prestige models, export ready.' },
          ],
        },
      ],
      featured: {
        tag: 'Experts in exporting worldwide',
        title: 'Free export quote',
        text: 'Tell us the vehicle and destination. We handle sourcing, VAT and shipping.',
        cta: 'Get a quote',
        href: '/contact',
      },
    },
  },
  {
    name: 'Car Shipping',
    href: '/car-shipping',
    dropdown: [
      { name: 'Shipping Rates', href: '/car-shipping/shipping-rates' },
      { name: 'Ireland', href: '/car-shipping/ireland' },
      { name: 'Kenya', href: '/import-uk-cars/kenya' },
    ],
  },
  {
    name: 'Process',
    href: '/process',
  },
  {
    name: 'Vehicle Sourcing',
    href: '/shipping-cars',
    mega: {
      columns: [
        {
          title: 'By Body Type',
          links: [
            { name: 'SUV & 4x4', href: '/shipping-cars/body/suv' },
            { name: 'Sedan', href: '/shipping-cars/body/sedan' },
            { name: 'Coupe', href: '/shipping-cars/body/coupe' },
            { name: 'Pickup Truck', href: '/shipping-cars/body/pickup-truck' },
          ],
        },
        {
          title: 'Browse Listings',
          links: [
            { name: 'All Vehicles', href: '/shipping-cars' },
            { name: 'Featured Vehicles', href: '/shipping-cars?featured=true' },
            { name: 'New Arrivals', href: '/shipping-cars?condition=New' },
            { name: 'Used Cars', href: '/shipping-cars?condition=Used' },
          ],
        },
      ],
      featured: {
        tag: 'In stock now',
        title: 'Ready to ship',
        text: 'Browse the latest UK vehicles prepared for worldwide export.',
        cta: 'View all stock',
        href: '/shipping-cars',
      },
    },
  },
  {
    name: 'Countries',
    href: '/car-shipping/destinations',
    columns: 2,
    dropdown: [
      { name: 'Australia', href: '/car-shipping/australia' },
      { name: 'Bangladesh', href: '/car-shipping/bangladesh' },
      { name: 'Barbados', href: '/car-shipping/barbados' },
      { name: 'Botswana', href: '/car-shipping/botswana' },
      { name: 'Canada', href: '/car-shipping/canada' },
      { name: 'Cayman Islands', href: '/car-shipping/cayman-islands' },
      { name: 'Cyprus', href: '/car-shipping/cyprus' },
      { name: 'Ghana', href: '/car-shipping/ghana' },
      { name: 'Great Britain', href: '/car-shipping/great-britain' },
      { name: 'Hong Kong', href: '/car-shipping/hong-kong' },
      { name: 'Indonesia', href: '/car-shipping/indonesia' },
      { name: 'Kenya', href: '/car-shipping/kenya' },
      { name: 'Malaysia', href: '/car-shipping/malaysia' },
      { name: 'Namibia', href: '/car-shipping/namibia' },
      { name: 'New Zealand', href: '/car-shipping/new-zealand' },
      { name: 'Singapore', href: '/car-shipping/singapore' },
      { name: 'South Africa', href: '/car-shipping/south-africa' },
      { name: 'Sri Lanka', href: '/car-shipping/sri-lanka' },
      { name: 'Tanzania', href: '/car-shipping/tanzania' },
      { name: 'Thailand', href: '/car-shipping/thailand' },
      { name: 'Trinidad and Tobago', href: '/car-shipping/trinidad-and-tobago' },
      { name: 'Uganda', href: '/car-shipping/uganda' },
      { name: 'USA', href: '/usa-import-america-car-shipping' },
      { name: 'All Destinations', href: '/car-shipping/destinations' },
    ],
  },
];
---

<header id="site-header" class="w-full z-50">
  <!-- Top Bar (hidden on mobile) -->
  <div class="hidden md:block bg-white border-b border-[var(--color-gray-border)] text-[var(--color-dark)] text-[15px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-end items-center h-[50px]">
      <div class="flex items-center gap-4">
        <!-- Icons sit outside the anchors so only the text is clickable -->
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <a href="tel:+441872491409" class="text-[var(--color-gray-text)] hover:text-[var(--color-primary)] transition-colors">01872-491-409</a>
        </span>
        <span class="text-[var(--color-gray-border)]">|</span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <a href="mailto:sales@vehicleexports.co.uk" class="text-[var(--color-gray-text)] hover:text-[var(--color-primary)] transition-colors">sales@vehicleexports.co.uk</a>
        </span>
        <span class="text-[var(--color-gray-border)]">|</span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
          <a href="/car-export-news" class="text-[var(--color-gray-text)] hover:text-[var(--color-primary)] transition-colors">UK Car Export News</a>
        </span>
      </div>
    </div>
  </div>

  <!-- Main Nav -->
  <nav id="main-nav" class="bg-white border-b border-gray-100 relative z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-[80px]">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 shrink-0">
          <span class="text-[23px] sm:text-lg xl:text-[26px] font-extrabold font-[family-name:var(--font-heading)] text-[var(--color-dark)] whitespace-nowrap">UK <span class="text-[var(--color-primary)]">Vehicle</span> Exporters</span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden lg:flex items-center gap-0">
          {navLinks.map(link => (
            <div class="relative group">
              <a href={link.href} class:list={["flex items-center gap-1.5 px-3 xl:px-5 py-2 text-[16px] font-medium hover:text-[var(--color-primary)] transition-colors", link.color || 'text-[var(--color-dark)]']}>
                {link.name}
                {(link.dropdown || link.mega) && (
                  <svg class="w-3.5 h-3.5 mt-0.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                )}
              </a>

              {/* Simple dropdown */}
              {link.dropdown && (
                <div class="absolute top-full left-0 pt-3 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class:list={["bg-white rounded-lg shadow-lg border border-gray-100 py-2 px-1", link.columns === 2 ? "min-w-[380px] columns-2 gap-x-1" : "min-w-[200px]"]}>
                    {link.dropdown.map(item => (
                      <a href={item.href} class="block break-inside-avoid rounded-lg px-3 py-2.5 text-sm text-gray-600 hover:text-[var(--color-primary)] hover:bg-gray-50 transition-colors">
                        {item.name}
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {/* Mega menu */}
              {link.mega && (
                <div class="absolute top-full left-0 pt-3 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class:list={["bg-white rounded-2xl shadow-2xl border border-gray-100 p-7 grid gap-7", link.mega.featured ? "grid-cols-[repeat(auto,minmax(0,1fr))]" : ""]} style={`width:${170 * link.mega.columns.length + (link.mega.featured ? 240 : 0)}px; grid-template-columns:repeat(${link.mega.columns.length}, minmax(0,1fr))${link.mega.featured ? ' 240px' : ''};`}>
                    {link.mega.columns.map(col => (
                      <div>
                        <h4 class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 mb-4 pb-2 border-b border-gray-100">{col.title}</h4>
                        <ul class="space-y-1">
                          {col.links.map(item => (
                            <li>
                              <a href={item.href} class="group/mi block rounded-lg px-3 py-2 -mx-3 hover:bg-orange-50/70 transition-colors">
                                <span class="block text-[15px] font-medium text-[var(--color-dark)] group-hover/mi:text-[var(--color-primary)] transition-colors">{item.name}</span>
                                {item.desc && <span class="block text-[12.5px] text-gray-400 mt-0.5 leading-snug">{item.desc}</span>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}

                    {link.mega.featured && (
                      <div class="rounded-xl bg-[var(--color-dark)] p-5 flex flex-col justify-between text-white overflow-hidden relative">
                        <div class="absolute -top-8 -right-8 w-28 h-28 rounded-full bg-[var(--color-primary)]/20"></div>
                        <div class="relative">
                          <span class="inline-block text-[var(--color-primary)] text-[11px] font-semibold uppercase tracking-wide mb-2">{link.mega.featured.tag}</span>
                          <h5 class="text-lg font-bold font-[family-name:var(--font-heading)] leading-tight mb-2">{link.mega.featured.title}</h5>
                          <p class="text-[13px] text-white/70 leading-snug">{link.mega.featured.text}</p>
                        </div>
                        <a href={link.mega.featured.href} class="relative mt-5 inline-flex items-center justify-center gap-1.5 bg-[var(--color-primary)] hover:bg-white hover:text-[var(--color-dark)] text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">
                          {link.mega.featured.cta}
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                      </div>
                    )}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Right Side -->
        <div class="flex items-center gap-5">
          <a href="/contact" class="hidden lg:inline-flex items-center gap-1 border border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white px-[11px] py-[5px] rounded-md text-[13px] font-semibold transition-all whitespace-nowrap">
            <svg class="w-[13px] h-[13px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Contact Us
          </a>
          <button id="mobile-menu-btn" class="lg:hidden p-2 text-gray-700 hover:text-[var(--color-primary)]" aria-label="Toggle menu">
            <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    </div>

  </nav>
</header>

<!-- Mobile Sidebar Overlay -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-black/50 z-[998] hidden lg:hidden" aria-hidden="true"></div>

<!-- Mobile Sidebar Drawer -->
<div id="mobile-menu" class="fixed top-0 left-0 h-full w-[280px] bg-white z-[999] transform -translate-x-full transition-transform duration-300 ease-in-out lg:hidden overflow-y-auto">
  <!-- Sidebar Header -->
  <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
    <a href="/" class="flex items-center gap-2">
      <span class="text-lg font-extrabold font-[family-name:var(--font-heading)] text-[var(--color-dark)]">UK <span class="text-[var(--color-primary)]">Vehicle</span> Exporters</span>
    </a>
    <button id="mobile-menu-close" class="p-2 text-gray-500 hover:text-gray-700" aria-label="Close menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Nav Links -->
  <div class="px-4 py-4 space-y-1">
    {navLinks.map(link => (
      <div class="mobile-nav-item">
        {link.mega ? (
          <div>
            <button class="mobile-dropdown-btn w-full flex justify-between items-center px-3 py-3 text-[var(--color-dark)] font-medium rounded-lg hover:bg-gray-50 transition-colors text-sm">
              {link.name}
              <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="mobile-dropdown hidden pl-3 space-y-3 mt-1 mb-1">
              {link.mega.columns.map(col => (
                <div>
                  <span class="block px-3 pt-1 text-[11px] font-semibold uppercase tracking-wider text-gray-400">{col.title}</span>
                  {col.links.map(item => (
                    <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-[var(--color-primary)] rounded-lg hover:bg-gray-50 transition-colors">
                      {item.name}
                    </a>
                  ))}
                </div>
              ))}
              {link.mega.featured && (
                <a href={link.mega.featured.href} class="block mx-3 mt-1 text-center bg-[var(--color-primary)] text-white px-4 py-2.5 rounded-lg text-sm font-semibold">
                  {link.mega.featured.cta}
                </a>
              )}
            </div>
          </div>
        ) : link.dropdown ? (
          <div>
            <button class="mobile-dropdown-btn w-full flex justify-between items-center px-3 py-3 text-[var(--color-dark)] font-medium rounded-lg hover:bg-gray-50 transition-colors text-sm">
              {link.name}
              <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="mobile-dropdown hidden pl-3 space-y-1 mt-1">
              {link.dropdown.map(item => (
                <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-[var(--color-primary)] rounded-lg hover:bg-gray-50 transition-colors">
                  {item.name}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link.href} class="block px-3 py-3 text-[var(--color-dark)] font-medium rounded-lg hover:bg-gray-50 transition-colors text-sm">
            {link.name}
          </a>
        )}
      </div>
    ))}
  </div>

  <!-- Bottom Actions -->
  <div class="px-4 pt-3 border-t border-gray-100">
    <a href="/contact" class="block text-center bg-[var(--color-primary)] text-white px-6 py-3 rounded-lg text-sm font-semibold mb-4">
      Contact Us
    </a>
  </div>

  <!-- Contact Details -->
  <div class="px-4 pt-4 border-t border-gray-100">
    <h4 class="text-[var(--color-dark)] font-semibold text-lg font-[family-name:var(--font-heading)] px-3 mb-4">Contact Us</h4>
    <div class="space-y-4 px-3 pb-6">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-gray-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <div>
          <span class="text-xs text-gray-400 block">Call us:</span>
          <a href="tel:+441872491409" class="text-sm font-semibold text-[var(--color-dark)]">01872 491409</a>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-gray-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <div>
          <span class="text-xs text-gray-400 block">Email:</span>
          <a href="mailto:sales@vehicleexports.co.uk" class="text-sm font-semibold text-[var(--color-dark)]">sales@vehicleexports.co.uk</a>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-gray-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <div>
          <span class="text-xs text-gray-400 block">Address:</span>
          <span class="text-sm font-semibold text-[var(--color-dark)]">Penstraze Business Centre</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { addScrollEffect } from '../scripts/scroll-effects';

  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-menu-overlay');
  const closeBtn = document.getElementById('mobile-menu-close');

  function openMenu() {
    menu?.classList.remove('-translate-x-full');
    overlay?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.add('-translate-x-full');
    overlay?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  document.querySelectorAll('.mobile-dropdown-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const dropdown = btn.nextElementSibling;
      const arrow = btn.querySelector('svg');
      dropdown?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });
  });

  const mainNav = document.getElementById('main-nav');
  if (mainNav) {
    let isSticky = false;
    addScrollEffect(
      () => window.scrollY > 100,
      shouldStick => {
        if (shouldStick === isSticky) return;
        isSticky = shouldStick;
        mainNav.classList.toggle('header-sticky', shouldStick);
      }
    );
  }
</script>