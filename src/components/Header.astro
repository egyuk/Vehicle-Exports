---
const navLinks = [
  { name: 'Home', href: '/', color: 'text-[var(--color-primary)]' },
  {
    name: 'Buy Car',
    href: '/cars',
    mega: {
      columns: [
        {
          title: 'By Body Type',
          links: [
            { name: 'SUV & 4x4', href: '/cars/body/suv' },
            { name: 'Sedan', href: '/cars/body/sedan' },
            { name: 'Coupe', href: '/cars/body/coupe' },
            { name: 'Pickup Truck', href: '/cars/body/pickup-truck' },
          ],
        },
        {
          title: 'Browse Listings',
          links: [
            { name: 'All Vehicles', href: '/cars' },
            { name: 'Featured Vehicles', href: '/cars?featured=true' },
            { name: 'New Arrivals', href: '/cars?condition=New' },
            { name: 'Used Cars', href: '/cars?condition=Used' },
          ],
        },
      ],
      featured: {
        tag: 'In stock now',
        title: 'Ready to ship',
        text: 'Browse the latest UK vehicles prepared for worldwide export.',
        cta: 'View all stock',
        href: '/cars',
      },
    },
  },
  {
    name: 'Car Export',
    href: '/countries',
    mega: {
      columns: [
        {
          title: 'Exporting with AutoDeal',
          links: [
            { name: 'Complete Export Guide', href: '/blog/complete-guide-exporting-vehicles-from-uk', desc: 'How UK vehicle export works, start to finish.' },
            { name: 'Shipping Costs Explained', href: '/blog/understanding-vehicle-shipping-costs', desc: 'What shipping your vehicle really costs.' },
            { name: 'Vehicle History Checks', href: '/blog/how-to-check-uk-vehicle-history-before-buying', desc: 'Buy with confidence, verified history.' },
            { name: 'Export FAQ', href: '/faq', desc: 'Answers to the questions we hear most.' },
          ],
        },
        {
          title: 'Vehicles to Export',
          links: [
            { name: 'All Vehicles', href: '/cars', desc: 'Every vehicle ready for export.' },
            { name: 'SUVs & 4x4s', href: '/cars/body/suv', desc: 'Our most exported category.' },
            { name: 'Pickup Trucks', href: '/cars/body/pickup-truck', desc: 'Workhorses built for any terrain.' },
            { name: 'Luxury & Performance', href: '/cars/body/coupe', desc: 'Prestige models, export ready.' },
          ],
        },
        {
          title: 'Where We Export To',
          links: [
            { name: 'Africa', href: '/countries/africa' },
            { name: 'Caribbean', href: '/countries/caribbean' },
            { name: 'Middle East', href: '/countries/middle-east' },
            { name: 'Europe & Malta', href: '/countries/europe' },
            { name: 'All Destinations', href: '/countries' },
          ],
        },
      ],
      featured: {
        tag: 'Experts in exporting worldwide',
        title: 'Free export quote',
        text: 'Tell us the vehicle and destination. We handle sourcing, VAT and shipping.',
        cta: 'Get a quote',
        href: '/contact',
      },
    },
  },
  {
    name: 'Blog',
    href: '/blog',
    dropdown: [
      { name: 'All Articles', href: '/blog' },
      { name: 'Export Guides', href: '/blog?category=Export+Guide' },
    ],
  },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
];
---

<header id="site-header" class="w-full z-50">
  <!-- Top Bar (hidden on mobile) -->
  <div class="hidden md:block bg-[var(--color-dark)] text-white text-[15px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center h-[50px]">
      <div class="hidden md:flex items-center gap-7 text-white/80">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
          London, United Kingdom
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Mon - Sat 8:00 - 18:00
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          +44 207 123 4567
        </span>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-white/60 hidden sm:inline">Follow us:</span>
        <div class="flex items-center gap-3">
          <a href="#" class="text-white/70 hover:text-[var(--color-primary)] transition-colors" aria-label="Facebook">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
          </a>
          <a href="#" class="text-white/70 hover:text-[var(--color-primary)] transition-colors" aria-label="LinkedIn">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"/></svg>
          </a>
          <a href="#" class="text-white/70 hover:text-[var(--color-primary)] transition-colors" aria-label="Twitter">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
          </a>
          <a href="#" class="text-white/70 hover:text-[var(--color-primary)] transition-colors" aria-label="Instagram">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Nav -->
  <nav id="main-nav" class="bg-white border-b border-gray-100 relative z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-[80px]">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 shrink-0">
          <div class="w-[58px] h-[58px] bg-[var(--color-primary)] rounded-xl flex items-center justify-center">
            <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
          </div>
          <span class="text-[32px] font-bold font-[family-name:var(--font-heading)] text-[var(--color-dark)]">Auto<span class="text-[var(--color-primary)]">Deal</span></span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden lg:flex items-center gap-0">
          {navLinks.map(link => (
            <div class="relative group">
              <a href={link.href} class:list={["flex items-center gap-1.5 px-5 py-2 text-[16px] font-medium hover:text-[var(--color-primary)] transition-colors", link.color || 'text-[var(--color-dark)]']}>
                {link.name}
                {(link.dropdown || link.mega) && (
                  <svg class="w-3.5 h-3.5 mt-0.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                )}
              </a>

              {/* Simple dropdown */}
              {link.dropdown && (
                <div class="absolute top-full left-0 pt-3 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2 min-w-[200px]">
                    {link.dropdown.map(item => (
                      <a href={item.href} class="block px-4 py-2.5 text-sm text-gray-600 hover:text-[var(--color-primary)] hover:bg-gray-50 transition-colors">
                        {item.name}
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {/* Mega menu */}
              {link.mega && (
                <div class="absolute top-full left-0 pt-3 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class:list={["bg-white rounded-2xl shadow-2xl border border-gray-100 p-7 grid gap-7", link.mega.featured ? "grid-cols-[repeat(auto,minmax(0,1fr))]" : ""]} style={`width:${170 * link.mega.columns.length + (link.mega.featured ? 240 : 0)}px; grid-template-columns:repeat(${link.mega.columns.length}, minmax(0,1fr))${link.mega.featured ? ' 240px' : ''};`}>
                    {link.mega.columns.map(col => (
                      <div>
                        <h4 class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 mb-4 pb-2 border-b border-gray-100">{col.title}</h4>
                        <ul class="space-y-1">
                          {col.links.map(item => (
                            <li>
                              <a href={item.href} class="group/mi block rounded-lg px-3 py-2 -mx-3 hover:bg-orange-50/70 transition-colors">
                                <span class="block text-[15px] font-medium text-[var(--color-dark)] group-hover/mi:text-[var(--color-primary)] transition-colors">{item.name}</span>
                                {item.desc && <span class="block text-[12.5px] text-gray-400 mt-0.5 leading-snug">{item.desc}</span>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}

                    {link.mega.featured && (
                      <div class="rounded-xl bg-[var(--color-dark)] p-5 flex flex-col justify-between text-white overflow-hidden relative">
                        <div class="absolute -top-8 -right-8 w-28 h-28 rounded-full bg-[var(--color-primary)]/20"></div>
                        <div class="relative">
                          <span class="inline-block text-[var(--color-primary)] text-[11px] font-semibold uppercase tracking-wide mb-2">{link.mega.featured.tag}</span>
                          <h5 class="text-lg font-bold font-[family-name:var(--font-heading)] leading-tight mb-2">{link.mega.featured.title}</h5>
                          <p class="text-[13px] text-white/70 leading-snug">{link.mega.featured.text}</p>
                        </div>
                        <a href={link.mega.featured.href} class="relative mt-5 inline-flex items-center justify-center gap-1.5 bg-[var(--color-primary)] hover:bg-white hover:text-[var(--color-dark)] text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">
                          {link.mega.featured.cta}
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                      </div>
                    )}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Right Side -->
        <div class="flex items-center gap-5">
          <div class="hidden lg:flex items-center gap-3 text-[16px]">
            <a href="#" class="text-gray-600 hover:text-[var(--color-primary)] transition-colors font-medium">Register</a>
            <span class="text-gray-300">/</span>
            <a href="#" class="text-gray-600 hover:text-[var(--color-primary)] transition-colors font-medium">Login</a>
          </div>
          <a href="/contact" class="hidden lg:inline-flex items-center gap-2 border-2 border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white px-10 py-3.5 rounded-xl text-[16px] font-semibold transition-all">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
            Add listing
          </a>
          <button id="mobile-menu-btn" class="lg:hidden p-2 text-gray-700 hover:text-[var(--color-primary)]" aria-label="Toggle menu">
            <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    </div>

  </nav>
</header>

<!-- Mobile Sidebar Overlay -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-black/50 z-[998] hidden lg:hidden" aria-hidden="true"></div>

<!-- Mobile Sidebar Drawer -->
<div id="mobile-menu" class="fixed top-0 left-0 h-full w-[280px] bg-white z-[999] transform -translate-x-full transition-transform duration-300 ease-in-out lg:hidden overflow-y-auto">
  <!-- Sidebar Header -->
  <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
    <a href="/" class="flex items-center gap-2">
      <div class="w-10 h-10 bg-[var(--color-primary)] rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
      </div>
      <span class="text-xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-dark)]">Auto<span class="text-[var(--color-primary)]">Deal</span></span>
    </a>
    <button id="mobile-menu-close" class="p-2 text-gray-500 hover:text-gray-700" aria-label="Close menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Nav Links -->
  <div class="px-4 py-4 space-y-1">
    {navLinks.map(link => (
      <div class="mobile-nav-item">
        {link.mega ? (
          <div>
            <button class="mobile-dropdown-btn w-full flex justify-between items-center px-3 py-3 text-[var(--color-dark)] font-medium rounded-lg hover:bg-gray-50 transition-colors text-sm">
              {link.name}
              <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="mobile-dropdown hidden pl-3 space-y-3 mt-1 mb-1">
              {link.mega.columns.map(col => (
                <div>
                  <span class="block px-3 pt-1 text-[11px] font-semibold uppercase tracking-wider text-gray-400">{col.title}</span>
                  {col.links.map(item => (
                    <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-[var(--color-primary)] rounded-lg hover:bg-gray-50 transition-colors">
                      {item.name}
                    </a>
                  ))}
                </div>
              ))}
              {link.mega.featured && (
                <a href={link.mega.featured.href} class="block mx-3 mt-1 text-center bg-[var(--color-primary)] text-white px-4 py-2.5 rounded-lg text-sm font-semibold">
                  {link.mega.featured.cta}
                </a>
              )}
            </div>
          </div>
        ) : link.dropdown ? (
          <div>
            <button class="mobile-dropdown-btn w-full flex justify-between items-center px-3 py-3 text-[var(--color-dark)] font-medium rounded-lg hover:bg-gray-50 transition-colors text-sm">
              {link.name}
              <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="mobile-dropdown hidden pl-3 space-y-1 mt-1">
              {link.dropdown.map(item => (
                <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-[var(--color-primary)] rounded-lg hover:bg-gray-50 transition-colors">
                  {item.name}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link.href} class="block px-3 py-3 text-[var(--color-dark)] font-medium rounded-lg hover:bg-gray-50 transition-colors text-sm">
            {link.name}
          </a>
        )}
      </div>
    ))}
  </div>

  <!-- Bottom Actions -->
  <div class="px-4 pt-3 mt-auto border-t border-gray-100">
    <div class="flex items-center gap-3 mb-4 px-3">
      <a href="#" class="text-sm text-gray-600 hover:text-[var(--color-primary)] font-medium">Register</a>
      <span class="text-gray-300">/</span>
      <a href="#" class="text-sm text-gray-600 hover:text-[var(--color-primary)] font-medium">Login</a>
    </div>
    <a href="/contact" class="block text-center bg-[var(--color-primary)] text-white px-6 py-3 rounded-lg text-sm font-semibold mb-4">
      Add listing
    </a>
  </div>

  <!-- Contact Details -->
  <div class="px-4 pt-4 border-t border-gray-100">
    <h4 class="text-[var(--color-dark)] font-semibold text-lg font-[family-name:var(--font-heading)] px-3 mb-4">Contact Us</h4>
    <div class="space-y-4 px-3 pb-6">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-gray-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <div>
          <span class="text-xs text-gray-400 block">Call us:</span>
          <a href="tel:+442071234567" class="text-sm font-semibold text-[var(--color-dark)]">+44 207 123 4567</a>
        </div>
      </div>
      <div class="flex items-start gap-3">
