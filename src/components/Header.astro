---
import { services } from '../data/services';
import { shippingServices } from '../data/shippingServices';
import { continentCountries } from '../data/destinations';

// The Shipping mega menu mirrors the Shipping Services list on /car-shipping;
// car shipping itself gets the photo banner above the cards instead of a card.
const shippingCards = shippingServices.map(s => ({ name: s.name, href: `/shipping/${s.slug}`, desc: s.shortDesc }));

// Countries grouped under unlinked continent headings, from the shared
// destinations data (continents with no countries yet are skipped).
const countryGroups = Object.entries(continentCountries)
  .filter(([, countries]) => countries.length > 0)
  .map(([title, countries]) => ({ title, links: countries }));

// The desktop panel lays the groups out in fixed columns, largest group first
// into the shortest column, so the tallest group sets the panel height. CSS
// columns could not split a group, so a group landing at the wrong point in
// the data order left the panel a whole group taller than it needed to be.
const COUNTRY_COLS = 5;
const countryColumns: (typeof countryGroups)[] = Array.from({ length: COUNTRY_COLS }, () => []);
const columnHeights = new Array(COUNTRY_COLS).fill(0);
for (const gr of [...countryGroups].sort((a, b) => b.links.length - a.links.length)) {
  const i = columnHeights.indexOf(Math.min(...columnHeights));
  countryColumns[i].push(gr);
  columnHeights[i] += gr.links.length + 1; // +1 for the heading
}
countryColumns.forEach(col => col.sort((a, b) => a.title.localeCompare(b.title)));

const navLinks = [
  {
    name: 'Car Export Services',
    href: '/services',
    mega: {
      // Rendered as a card grid (see the cards branch below) — one card per
      // service page, from the shared services data module.
      cards: services.map(s => ({ name: s.name, href: `/services/${s.slug}`, desc: s.shortDesc, image: s.image, mobileName: s.navName })),
      mobileHeading: 'Exporting cars from the UK worldwide',
      allLink: { name: 'All export services', desc: 'See everything we do, from sourcing to customs clearance.', href: '/services' },
      featured: {
        tag: 'Exporting Cars from the UK to Countries Worldwide',
        title: 'Free export quote',
        text: 'Tell us the car and destination, and we handle the sourcing, VAT and shipping.',
        cta: 'Get a quote',
        href: '/contact',
      },
    },
  },
  {
    name: 'Shipping',
    href: '/shipping',
    mega: {
      banner: {
        name: 'Car Shipping',
        href: '/car-shipping',
        desc: 'RoRo and container car shipping from the UK to any country — rates, ports and destinations.',
        image: '/assets/images/services/shipping.jpeg',
      },
      cards: shippingCards,
      cardCols: 3,
      mobileHeading: 'Shipping worldwide from the UK',
      allLink: { name: 'All shipping services', desc: 'Every way we ship from the UK, in one place.', href: '/shipping' },
      featured: {
        tag: 'Shipping Worldwide from the UK',
        title: 'Live sailing schedules',
        text: 'Hundreds of upcoming departures from UK ports — find the next sailing to your destination.',
        cta: 'View sailing schedule',
        href: '/uk-car-sailing-schedule',
      },
    },
  },
  {
    name: 'Process',
    href: '/process',
  },
  {
    name: 'Countries',
    href: '/car-shipping',
    mega: {
      groups: countryGroups,          // mobile menu, in data order
      groupColumns: countryColumns,   // desktop panel, packed by size
      mobileHeading: 'Shipping to countries worldwide',
      featured: {
        tag: 'Shipping Worldwide from the UK',
        title: "Don't see your country?",
        text: 'We ship to almost any destination worldwide — tell us where the vehicle is going and we will confirm the route.',
        cta: 'Get a quote',
        href: '/contact',
      },
    },
  },
];
---

<header id="site-header" class="w-full z-50">
  <!-- Top Bar (hidden on mobile) -->
  <div class="hidden md:block bg-white border-b border-[var(--color-gray-border)] text-[var(--color-dark)] text-[15px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-end items-center h-[50px]">
      <div class="flex items-center gap-4">
        <!-- Icons sit outside the anchors so only the text is clickable -->
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <a href="tel:+441872491409" class="text-[var(--color-gray-text)] hover:text-[var(--color-primary)] transition-colors">01872-491-409</a>
        </span>
        <span class="text-[var(--color-gray-border)]">|</span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <a href="mailto:sales@vehicleexports.co.uk" class="text-[var(--color-gray-text)] hover:text-[var(--color-primary)] transition-colors">sales@vehicleexports.co.uk</a>
        </span>
        <span class="text-[var(--color-gray-border)]">|</span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
          <a href="/car-export-news" class="text-[var(--color-gray-text)] hover:text-[var(--color-primary)] transition-colors">UK Car Export News</a>
        </span>
      </div>
    </div>
  </div>

  <!-- Main Nav -->
  <nav id="main-nav" class="bg-white border-b border-gray-100 relative z-50">
    <!-- relative: the Countries panel is too wide to hang off its own nav item
         without running past the left edge of the viewport, so it positions
         against this container instead and lines up with the content edge. -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-[80px]">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 shrink-0">
          <span class="text-[23px] sm:text-lg xl:text-[26px] font-extrabold font-[family-name:var(--font-heading)] text-[var(--color-dark)] whitespace-nowrap">UK <span class="text-[var(--color-primary)]">Vehicle</span> Exporters</span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden lg:flex items-center gap-0">
          {navLinks.map(link => (
            <div class:list={[link.mega?.groupColumns ? "static" : "relative", "group"]}>
              <a href={link.href} class:list={["flex items-center gap-1.5 px-3 xl:px-5 py-2 text-[16px] font-medium hover:text-[var(--color-primary)] transition-colors", link.color || 'text-[var(--color-dark)]']}>
                {link.name}
                {(link.dropdown || link.mega) && (
                  <svg class="w-3.5 h-3.5 mt-0.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                )}
              </a>

              {/* Simple dropdown */}
              {link.dropdown && (
                <div class="absolute top-full left-0 pt-3 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class:list={["bg-white rounded-lg shadow-lg border border-gray-100 py-2 px-1", link.columns === 2 ? "min-w-[380px] columns-2 gap-x-1" : "min-w-[200px]"]}>
                    {link.dropdown.map(item => (
                      <a href={item.href} class="block break-inside-avoid rounded-lg px-3 py-2.5 text-sm text-gray-600 hover:text-[var(--color-primary)] hover:bg-gray-50 transition-colors">
                        {item.name}
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {/* Mega menu — service cards / country groups variant.
                  The groups panel sits on the container (see the comment on
                  it); top-[60px] is where the nav link ends inside the 80px
                  row, i.e. the same place top-full puts the other panels. */}
              {link.mega && (link.mega.cards || link.mega.groups) && (
                <div class:list={["absolute pt-3 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50", link.mega.groupColumns ? "top-[60px] right-8" : link.mega.cardCols >= 3 ? "top-full left-1/2 -translate-x-1/2" : "top-full left-0"]}>
                  <div class:list={["bg-white rounded-2xl shadow-2xl border border-gray-100 p-6 grid gap-5", link.mega.groupColumns ? "w-[900px] xl:w-[1080px] grid-cols-[1fr_190px] xl:grid-cols-[1fr_220px]" : link.mega.featured ? (link.mega.cardCols >= 3 ? "w-[820px] xl:w-[920px] grid-cols-[1fr_190px] xl:grid-cols-[1fr_220px]" : "w-[680px] xl:w-[820px] grid-cols-[1fr_200px] xl:grid-cols-[1fr_240px]") : "w-[560px]"]}>
                    <div>
                    {link.mega.banner && (
                      <a href={link.mega.banner.href} class="group/mb relative block rounded-xl overflow-hidden mb-4">
                        <img src={link.mega.banner.image} alt="" width="640" height="120" loading="lazy" class="w-full h-[110px] object-cover group-hover/mb:scale-105 transition-transform duration-500" />
                        <span class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/45 to-black/10"></span>
                        <span class="absolute inset-0 p-5 flex flex-col justify-center">
                          <span class="text-white font-bold text-lg font-[family-name:var(--font-heading)] leading-tight">{link.mega.banner.name}</span>
                          <span class="text-white/85 text-[12.5px] leading-snug mt-1 max-w-[420px]">{link.mega.banner.desc}</span>
                        </span>
                      </a>
                    )}
                    {link.mega.groupColumns ? (
                      <div class="grid grid-cols-5 gap-4">
                        {link.mega.groupColumns.map(col => (
                          <div>
                            {col.map(gr => (
                              <div class="mb-4">
                                <h4 class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 mb-1.5 pb-1.5 border-b border-gray-100">{gr.title}</h4>
                                <ul>
                                  {gr.links.map(item => (
                                    <li>
                                      <a href={item.href} class="block rounded-md px-2 py-[2px] -mx-2 text-[13px] font-medium leading-snug text-[var(--color-dark)] hover:text-[var(--color-primary)] hover:bg-orange-50/70 transition-colors">{item.name}</a>
                                    </li>
                                  ))}
                                </ul>
                              </div>
                            ))}
                          </div>
                        ))}
                      </div>
                    ) : (
                    <div class:list={["grid", link.mega.cardCols === 4 ? "grid-cols-4 gap-x-3 gap-y-0.5" : link.mega.cardCols === 3 ? "grid-cols-3 gap-x-3 gap-2" : "grid-cols-2 gap-2"]}>
                      {link.mega.cards.map(item => (
                        <a href={item.href} class="group/mi block rounded-xl p-2.5 hover:bg-orange-50/70 transition-colors">
                          <span class="block text-[13.5px] font-semibold leading-snug text-[var(--color-dark)] group-hover/mi:text-[var(--color-primary)] transition-colors">{item.name}</span>
                          {item.image ? (
                            <span class="flex items-start gap-3 mt-2">
                              <img src={item.image} alt="" width="80" height="56" loading="lazy" class="w-20 h-14 shrink-0 rounded-lg object-cover" />
                              <span class="min-w-0 text-[12px] text-gray-400 leading-snug">{item.desc}</span>
                            </span>
                          ) : item.desc ? (
                            <span class="block mt-1.5 text-[12px] text-gray-400 leading-snug">{item.desc}</span>
                          ) : null}
                        </a>
                      ))}
                    </div>
                    )}
                    </div>

                    {link.mega.featured && (
                      <div class="rounded-xl bg-[var(--color-dark)] p-5 flex flex-col text-white overflow-hidden relative">
                        <div class="absolute -top-8 -right-8 w-28 h-28 rounded-full bg-[var(--color-primary)]/20"></div>
                        <div class="relative">
                          <span class="inline-block text-[var(--color-primary)] text-[11px] font-semibold uppercase tracking-wide mb-2">{link.mega.featured.tag}</span>
                          <h5 class="text-lg font-bold font-[family-name:var(--font-heading)] leading-tight mb-2">{link.mega.featured.title}</h5>
                          <p class="text-[13px] text-white/70 leading-snug">{link.mega.featured.text}</p>
                        </div>
                        <div class="relative mt-auto pt-5">
                          <a href={link.mega.featured.href} class="flex items-center justify-center gap-1.5 bg-[var(--color-primary)] hover:bg-white hover:text-[var(--color-dark)] text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">
                            {link.mega.featured.cta}
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                          </a>
                          <div class="mt-4 pt-4 border-t border-white/10 space-y-2">
                            <a href="tel:+441872491409" class="flex items-center gap-2 text-[13px] text-white/80 hover:text-white transition-colors">
                              <svg class="w-3.5 h-3.5 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                              01872 491409
                            </a>
                            <a href="mailto:sales@vehicleexports.co.uk" class="flex items-center gap-2 text-[13px] text-white/80 hover:text-white transition-colors">
                              <svg class="w-3.5 h-3.5 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                              sales@vehicleexports.co.uk
                            </a>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Right Side -->
        <div class="flex items-center gap-5">
          <a href="/contact" class="hidden lg:inline-flex items-center gap-1 border border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white px-[11px] py-[5px] rounded-md text-[13px] font-semibold transition-all whitespace-nowrap">
            <svg class="w-[13px] h-[13px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Contact Us
          </a>
          <button id="mobile-menu-btn" class="lg:hidden p-2 text-gray-700 hover:text-[var(--color-primary)]" aria-label="Toggle menu">
            <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    </div>

  </nav>
</header>

<!-- Mobile Menu — drops down from under the header; the wrapper clips the slide -->
<div id="mobile-menu-wrap" class="fixed left-0 top-[80px] bottom-0 w-full z-[999] overflow-hidden pointer-events-none lg:hidden">
<div id="mobile-menu" class="h-full w-full bg-white transform -translate-y-full transition-transform duration-300 ease-in-out overflow-y-auto flex flex-col pointer-events-auto">
  <!-- Nav Links -->
  <div class="px-4 py-4 space-y-1">
    {navLinks.map(link => (
      <div class="mobile-nav-item">
        {link.mega && (link.mega.cards || link.mega.groups) ? (
          <div>
            <button class="mobile-dropdown-btn w-full flex justify-between items-center px-3 py-3 text-[var(--color-dark)] font-medium rounded-lg hover:bg-gray-50 transition-colors text-sm">
              {link.name}
              <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="mobile-dropdown hidden px-3 pt-3 pb-5">
              {link.mega.mobileHeading && (
                <h4 class="text-[var(--color-primary)] text-lg font-bold font-[family-name:var(--font-heading)] leading-snug mb-5">{link.mega.mobileHeading}</h4>
              )}
              {link.mega.banner && (
                <a href={link.mega.banner.href} class="relative block rounded-xl overflow-hidden mb-5">
                  <img src={link.mega.banner.image} alt="" width="640" height="120" loading="lazy" class="w-full h-[100px] object-cover" />
                  <span class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/45 to-black/10"></span>
                  <span class="absolute inset-0 p-4 flex flex-col justify-center">
                    <span class="text-white font-bold text-base font-[family-name:var(--font-heading)] leading-tight">{link.mega.banner.name}</span>
                    <span class="text-white/85 text-[12px] leading-snug mt-1">{link.mega.banner.desc}</span>
                  </span>
                </a>
              )}
              {link.mega.groups ? (
                <div class="space-y-5">
                  {link.mega.groups.map(gr => (
                    <div>
                      <span class="block text-[11px] font-semibold uppercase tracking-wider text-gray-400 mb-2 pb-1.5 border-b border-gray-100">{gr.title}</span>
                      <div class="grid grid-cols-2 gap-x-5 gap-y-1.5">
                        {gr.links.map(item => (
                          <a href={item.href} class="block text-[14px] font-bold leading-snug text-[var(--color-dark)] py-0.5">{item.name}</a>
                        ))}
                      </div>
                    </div>
                  ))}
                  {link.mega.allLink && (
                    <a href={link.mega.allLink.href} class="block">
                      <span class="block text-[14px] font-bold leading-snug text-[var(--color-dark)]">{link.mega.allLink.name}</span>
                      <span class="block text-[12.5px] text-gray-500 mt-1.5 leading-snug">{link.mega.allLink.desc}</span>
                    </a>
                  )}
                </div>
              ) : (
              <div class="grid grid-cols-2 gap-x-5 gap-y-6">
                {link.mega.cards.map(item => (
                  <a href={item.href} class="block">
                    <span class="block text-[14px] font-bold leading-snug text-[var(--color-dark)]">{item.mobileName ?? item.name}</span>
                    {item.desc && <span class="block text-[12.5px] text-gray-500 mt-1.5 leading-snug">{item.desc}</span>}
                  </a>
                ))}
                {link.mega.allLink && (
                  <a href={link.mega.allLink.href} class="block col-span-2">
                    <span class="block text-[14px] font-bold leading-snug text-[var(--color-dark)]">{link.mega.allLink.name}</span>
                    <span class="block text-[12.5px] text-gray-500 mt-1.5 leading-snug">{link.mega.allLink.desc}</span>
                  </a>
                )}
              </div>
              )}
            </div>
          </div>
        ) : link.dropdown ? (
          <div>
            <button class="mobile-dropdown-btn w-full flex justify-between items-center px-3 py-3 text-[var(--color-dark)] font-medium rounded-lg hover:bg-gray-50 transition-colors text-sm">
              {link.name}
              <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="mobile-dropdown hidden pl-3 space-y-1 mt-1">
              {link.dropdown.map(item => (
                <a href={item.href} class="block px-3 py-2 text-sm text-gray-500 hover:text-[var(--color-primary)] rounded-lg hover:bg-gray-50 transition-colors">
                  {item.name}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link.href} class="block px-3 py-3 text-[var(--color-dark)] font-medium rounded-lg hover:bg-gray-50 transition-colors text-sm">
            {link.name}
          </a>
        )}
      </div>
    ))}
  </div>

  <!-- Bottom Actions -->
  <div class="px-4 pt-3 border-t border-gray-100">
    <a href="/contact" class="block text-center bg-[var(--color-primary)] text-white px-6 py-3 rounded-lg text-sm font-semibold mb-4">
      Contact Us
    </a>
  </div>

  <!-- Contact Details -->
  <div class="px-4 pt-4 border-t border-gray-100">
    <h4 class="text-[var(--color-dark)] font-semibold text-lg font-[family-name:var(--font-heading)] px-3 mb-4">Get in touch with us</h4>
    <div class="space-y-4 px-3 pb-6">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-gray-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <div>
          <span class="text-xs text-gray-400 block">Call us:</span>
          <a href="tel:+441872491409" class="text-sm font-semibold text-[var(--color-dark)]">01872 491409</a>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-gray-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <div>
