---
const agents = [
  {
    name: 'Ronal Son',
    role: 'Seller Staff',
    phone: '+44 207 123 4567',
    email: 'ronal@autodeal.uk',
    image: '/assets/images/agents/agent-1.jpg',
  },
  {
    name: 'Lanna Sio',
    role: 'Administrative Staff',
    phone: '+44 207 234 5678',
    email: 'lanna@autodeal.uk',
    image: '/assets/images/agents/agent-2.jpg',
  },
  {
    name: 'Jones Stonie',
    role: 'Manager',
    phone: '+44 207 345 6789',
    email: 'jones@autodeal.uk',
    image: '/assets/images/agents/agent-3.jpg',
  },
  {
    name: 'James Rome',
    role: 'Manager',
    phone: '+44 207 456 7890',
    email: 'james@autodeal.uk',
    image: '/assets/images/agents/agent-4.jpg',
  },
];
---

<section class="py-16 lg:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Our Team</span>
      <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">Meet Our Agents</h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {agents.map(agent => (
        <div class="bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg transition-all group">
          <!-- Agent Photo -->
          <div class="aspect-[3/4] overflow-hidden relative">
            <img
              src={agent.image}
              alt={agent.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <!-- Social icons overlay on image bottom -->
            <div class="absolute inset-x-0 bottom-0 flex items-center justify-center gap-2 bg-gradient-to-t from-black/60 to-transparent px-4 pb-4 pt-10 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
              <a href="https://www.facebook.com/UKVehicleExporters/" target="_blank" rel="noopener" class="w-8 h-8 bg-white/20 hover:bg-[var(--color-primary)] backdrop-blur-sm rounded-full flex items-center justify-center text-white transition-all" aria-label="Facebook">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
              </a>
              <a href="https://x.com/vehicle_exports" target="_blank" rel="noopener" class="w-8 h-8 bg-white/20 hover:bg-[var(--color-primary)] backdrop-blur-sm rounded-full flex items-center justify-center text-white transition-all" aria-label="X">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="https://www.youtube.com/@uk_vehicle_exporters" target="_blank" rel="noopener" class="w-8 h-8 bg-white/20 hover:bg-[var(--color-primary)] backdrop-blur-sm rounded-full flex items-center justify-center text-white transition-all" aria-label="YouTube">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
              <a href="https://www.instagram.com/uk_vehicle_exporters/" target="_blank" rel="noopener" class="w-8 h-8 bg-white/20 hover:bg-[var(--color-primary)] backdrop-blur-sm rounded-full flex items-center justify-center text-white transition-all" aria-label="Instagram">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            </div>
          </div>

          <!-- Name, Role & Icons -->
          <div class="p-4 flex items-center justify-between">
            <div>
              <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)] text-base">{agent.name}</h3>
              <p class="text-sm text-[var(--color-primary)] font-medium">{agent.role}</p>
            </div>
            <div class="flex gap-2">
              <a href={`tel:${agent.phone.replace(/\s+/g, '')}`} class="w-9 h-9 bg-gray-100 hover:bg-[var(--color-primary)] hover:text-white rounded-full flex items-center justify-center text-gray-400 transition-all" aria-label={`Call ${agent.name}`}>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </a>
              <a href={`mailto:${agent.email}`} class="w-9 h-9 bg-gray-100 hover:bg-[var(--color-primary)] hover:text-white rounded-full flex items-center justify-center text-gray-400 transition-all" aria-label={`Email ${agent.name}`}>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
