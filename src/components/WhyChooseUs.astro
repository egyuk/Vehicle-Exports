---
import { services } from '../data/services';

const benefits = [
  {
    title: 'UK Car Sourcing & Supply',
    description: 'We can source any new or used vehicle from any manufacturer in the UK for you, from our network of dealers, car classified websites, auctions or directly from manufacturers, and deliver to you in your country for guaranteed cheapest rates.',
    image: '/assets/images/services/sourcing.jpeg',
  },
  {
    title: 'UK Tax / VAT Free Car Exports',
    description: 'We specialise in the selection of vehicles that are eligible for VAT refunds and Tax deduction, provided that they are being exported outside of the EU. We have access to a large range of used "VAT Qualifying" and Brand New Tax-Free vehicles.',
    image: '/assets/images/services/vat-exports.jpeg',
  },
  {
    title: 'UK Vehicle Shipping & Exports',
    description: 'We offer specialist vehicle shipping services to any country from the UK, by either RoRo or Container methods, and can guarantee the best shipping prices. We can offer an all-inclusive shipping service where we collect your vehicle or goods from any UK address and ship them to your desired country.',
    image: '/assets/images/services/shipping.jpeg',
  },
  {
    title: 'Buy a Car on Your Behalf',
    description: 'We can also offer vehicle brokerage services and can purchase any vehicle on your behalf (from any UK Dealership or Seller) if you have sourced your own vehicle in the UK. This will avoid the pitfalls that befall many buyers who fall victim to fraudulent car sellers.',
    image: '/assets/images/services/brokerage.jpeg',
  },
  {
    title: 'UK Vehicle Collection & Delivery',
    description: 'We can collect any vehicle from any UK address and deliver them to any of the UK ports of departure (Southampton, Tilbury, Sheerness, Felixstowe, Immingham etc) at a rate of £1 per mile, driven on DVLA plates or on a carrier.',
    image: '/assets/images/services/collection-delivery.jpeg',
  },
  {
    title: 'UK Vehicle Customs Clearance',
    description: "We have access to the UK government's customs system and make declarations on exports as well as prepare all documentation needed at the UK Port of exit, including the Bill of Lading, Export Certificate etc.",
    image: '/assets/images/services/customs-clearance.jpeg',
  },
];

// Each homepage card links through to its service page, matched by image
// (titles match the services data too, but the image is the stable key).
// Shipping is the exception: its service page was folded into /car-shipping.
const hrefFor = (image: string) => {
  if (image === '/assets/images/services/shipping.jpeg') return '/car-shipping';
  const s = services.find(s => s.image === image);
  return s ? `/services/${s.slug}` : '/services';
};
---

<section class="pt-5 pb-5 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-3 font-[family-name:var(--font-heading)]">
      Why Choose UK Vehicle Exporters
    </h2>
    <p class="text-gray-500 text-sm mb-10">
      We source, supply and export vehicles worldwide, with every vehicle 198-point inspected before it leaves the UK.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {benefits.map(benefit => (
        <a href={hrefFor(benefit.image)} class="service-card block rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg transition-all group">
          <div class="aspect-[16/10] overflow-hidden">
            <img src={benefit.image} alt={benefit.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="p-5">
            <h3 class="font-bold text-[var(--color-primary)] text-lg font-[family-name:var(--font-heading)] leading-snug">{benefit.title}</h3>
            <p class="text-sm text-gray-600 mt-2 leading-relaxed">{benefit.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
