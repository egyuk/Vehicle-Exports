---
// The KRA duty calculator, lifted out of /import-uk-cars/kenya so it sits on
// the Kenya destination page itself. It is a component rather than inline
// markup because the block is long and the page it lives on is already 200
// lines of prose.
//
// Laid out for the country page's content column, which is ~794px wide at xl
// (the sidebar takes a third of the row) and full width below that. The
// original was a 3/2 split inside max-w-5xl and would have been cramped here,
// so the form and the result stack instead, with the two result cards side by
// side.
//
// Every id below, and the .rate-field class, is what the script at the bottom
// binds to - renaming one silently breaks the calculator, so they are kept
// exactly as they were.
---

<div id="calculator">
  <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Kenya Import Duty Calculator</h2>
  <p class="text-gray-600 leading-relaxed mb-6">
    Estimate the customs value and taxes for a specific make and model before you commit to buying, using KRA's
    official Current Retail Selling Price (CRSP) schedule and depreciation rules (July 2025).
  </p>

  <!-- Form -->
  <div class="bg-gray-50 rounded-2xl p-6 lg:p-8">
    <div id="loading-state" class="text-center py-12 text-gray-400 text-sm">Loading CRSP data…</div>

    <form id="calc-form" class="space-y-6 hidden">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="category" class="block text-sm font-semibold text-gray-900 mb-2">Vehicle category</label>
          <select id="category" class="w-full bg-white border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]">
            <option value="vehicles">Cars, SUVs, Vans &amp; Trucks</option>
            <option value="motorcycles">Motorcycles</option>
            <option value="tractors">Tractors &amp; Graders</option>
          </select>
        </div>
        <div>
          <label for="make" class="block text-sm font-semibold text-gray-900 mb-2">Make</label>
          <select id="make" class="w-full bg-white border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]">
            <option value="">Select make…</option>
          </select>
        </div>
      </div>

      <div>
        <label for="variant" class="block text-sm font-semibold text-gray-900 mb-2">Model / variant</label>
        <select id="variant" class="w-full bg-white border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" disabled>
          <option value="">Select make first…</option>
        </select>
      </div>

      <div>
        <span class="block text-sm font-semibold text-gray-900 mb-2">Import category</span>
        <div class="flex flex-col sm:flex-row gap-3">
          <label class="flex-1 flex items-center gap-2 bg-white border border-gray-200 rounded-lg px-3 py-2.5 text-sm cursor-pointer has-[:checked]:border-[var(--color-primary)] has-[:checked]:bg-orange-50/50">
            <input type="radio" name="importCategory" value="direct" checked class="accent-[var(--color-primary)]" />
            Direct import to Kenya
          </label>
          <label class="flex-1 flex items-center gap-2 bg-white border border-gray-200 rounded-lg px-3 py-2.5 text-sm cursor-pointer has-[:checked]:border-[var(--color-primary)] has-[:checked]:bg-orange-50/50">
            <input type="radio" name="importCategory" value="previouslyRegistered" class="accent-[var(--color-primary)]" />
            Previously registered in Kenya
          </label>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="age" class="block text-sm font-semibold text-gray-900 mb-2">Vehicle age (years)</label>
          <input id="age" type="number" min="0" max="30" step="1" value="3" class="w-full bg-white border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" />
          <p id="age-note" class="text-xs text-gray-400 mt-1"></p>
        </div>
        <div>
          <label for="extraDepreciation" class="block text-sm font-semibold text-gray-900 mb-2">Extra depreciation (%)</label>
          <input id="extraDepreciation" type="number" min="0" max="100" step="1" value="0" class="w-full bg-white border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" />
          <p class="text-xs text-gray-400 mt-1">Accident or condition adjustment — matches the "Extra Depreciation" field in KRA's TEMPLATE 2025. Leave at 0 unless applicable.</p>
        </div>
      </div>

      <div class="border-t border-gray-200 pt-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Duty category (KRA TEMPLATE 2025 tabs)</h3>
        <p class="text-xs text-gray-400 mb-3">
          Auto-suggested from the selected vehicle's engine size and fuel type — <strong class="text-gray-600">verify against the correct HS code</strong> before quoting. Rates below are locked to the KRA preset for the selected category; choose "Custom (manual rates)" to edit them.
        </p>
        <select id="dutyCategory" class="w-full bg-white border border-gray-200 rounded-lg px-3 py-2.5 text-sm mb-3 focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]">
          <option value="upTo1500">≤1500cc (incl. S/Cab pickups, lorries, buses)</option>
          <option value="over1500">&gt;1500cc, standard (excl. HS 8703.24.90 / 8703.33.90)</option>
          <option value="over3000">&gt;3000cc petrol / &gt;2500cc diesel (HS 8703.24.90 / 8703.33.90)</option>
          <option value="electric">100% electric</option>
          <option value="schoolBuses">School buses (public schools)</option>
          <option value="primeMovers">Prime movers (no excise)</option>
          <option value="trailers">Trailers (no excise)</option>
          <option value="ambulance">Ambulance</option>
          <option value="motorcycles">Motorcycles (flat excise fee)</option>
          <option value="specialPurpose">Special purpose vehicles</option>
          <option value="heavyMachinery">Heavy machinery</option>
          <option value="custom">Custom (manual rates)</option>
        </select>
        <div id="flat-excise-row" class="hidden mb-3">
          <label for="flatExcise" class="block text-xs text-gray-500 mb-1">Flat Excise Duty (KES)</label>
          <input id="flatExcise" type="number" step="1" value="12953" readonly class="rate-field w-full bg-white border border-gray-200 rounded-lg px-2.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] read-only:bg-gray-100 read-only:text-gray-500 read-only:cursor-not-allowed" />
          <p class="text-xs text-gray-400 mt-1">Motorcycles use a fixed KES excise fee per TEMPLATE 2025, not a percentage.</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <div>
            <label for="dutyRate" class="block text-xs text-gray-500 mb-1">Import Duty %</label>
            <input id="dutyRate" type="number" step="0.1" value="35" readonly class="rate-field w-full bg-white border border-gray-200 rounded-lg px-2.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] read-only:bg-gray-100 read-only:text-gray-500 read-only:cursor-not-allowed" />
          </div>
          <div id="excise-rate-field">
            <label for="exciseRate" class="block text-xs text-gray-500 mb-1">Excise Duty %</label>
            <input id="exciseRate" type="number" step="0.1" value="25" readonly class="rate-field w-full bg-white border border-gray-200 rounded-lg px-2.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] read-only:bg-gray-100 read-only:text-gray-500 read-only:cursor-not-allowed" />
          </div>
          <div>
            <label for="vatRate" class="block text-xs text-gray-500 mb-1">VAT %</label>
            <input id="vatRate" type="number" step="0.1" value="16" readonly class="rate-field w-full bg-white border border-gray-200 rounded-lg px-2.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] read-only:bg-gray-100 read-only:text-gray-500 read-only:cursor-not-allowed" />
          </div>
          <div>
            <label for="idfRate" class="block text-xs text-gray-500 mb-1">IDF %</label>
            <input id="idfRate" type="number" step="0.1" value="2.5" readonly class="rate-field w-full bg-white border border-gray-200 rounded-lg px-2.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] read-only:bg-gray-100 read-only:text-gray-500 read-only:cursor-not-allowed" />
          </div>
          <div>
            <label for="rdlRate" class="block text-xs text-gray-500 mb-1">RDL %</label>
            <input id="rdlRate" type="number" step="0.1" value="2" readonly class="rate-field w-full bg-white border border-gray-200 rounded-lg px-2.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] read-only:bg-gray-100 read-only:text-gray-500 read-only:cursor-not-allowed" />
          </div>
        </div>
      </div>
    </form>
  </div>

  <!-- Result -->
  <div id="result-empty" class="mt-6 bg-white border border-gray-200 rounded-2xl p-6 text-sm text-gray-400 text-center">
    Select a vehicle to see the estimated Kenya customs value and taxes.
  </div>

  <div id="result" class="hidden mt-6 space-y-4">
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="bg-white rounded-2xl p-6 border border-gray-200">
        <h3 class="font-semibold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">Customs Value</h3>
        <dl class="space-y-2.5 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-gray-500">Base CRSP value</dt><dd id="r-crsp" class="font-medium text-gray-900 text-right"></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500">Depreciation applied</dt><dd id="r-depreciation" class="font-medium text-gray-900 text-right"></dd></div>
          <div class="flex justify-between gap-3 border-t border-gray-200 pt-2.5"><dt class="text-gray-900 font-semibold">Customs (taxable) value</dt><dd id="r-customs-value" class="font-bold text-[var(--color-primary)] text-right"></dd></div>
        </dl>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-gray-200">
        <h3 class="font-semibold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">Estimated Taxes</h3>
        <dl class="space-y-2.5 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-gray-500">Import Duty</dt><dd id="r-duty" class="font-medium text-gray-900 text-right"></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500">Excise Duty</dt><dd id="r-excise" class="font-medium text-gray-900 text-right"></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500">VAT</dt><dd id="r-vat" class="font-medium text-gray-900 text-right"></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500">IDF</dt><dd id="r-idf" class="font-medium text-gray-900 text-right"></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500">RDL</dt><dd id="r-rdl" class="font-medium text-gray-900 text-right"></dd></div>
        </dl>
      </div>
    </div>

    <div class="bg-[var(--color-dark)] rounded-2xl p-6 text-white">
      <div class="text-xs text-white/60 uppercase tracking-wider font-semibold mb-1">Grand Total — taxes payable (KES)</div>
      <div id="r-total" class="text-2xl lg:text-3xl font-bold font-[family-name:var(--font-heading)]"></div>
      <p class="text-xs text-white/50 mt-2">Import Duty + Excise Duty + VAT + IDF + RDL only — matches KRA's "Grand Total" convention. Does not include the Customs Value itself.</p>
    </div>

    <div class="bg-blue-50 border border-blue-200 rounded-2xl p-4 text-xs text-blue-800 leading-relaxed">
      Formula verified against KRA's <strong>TEMPLATE 2025</strong> worked example (Audi Q7 3.0TFSI, 65% depreciation,
      &gt;3000cc category): Customs Value = (CRSP ÷ 1.25) × (1 − Depreciation) × (1 − Extra Depreciation) ÷ (1 + Import Duty) ÷ (1 + Excise Duty) ÷ (1 + VAT).
      Every tabulation tab is itself marked <strong>"GUIDELINE SUBJECT TO VERIFICATION"</strong> by KRA — confirm the
      selected duty category and current rates before quoting a customer.
    </div>

    <a href="/contact" class="block text-center bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
      Get a Full Export Quote
    </a>
  </div>

  <p class="text-xs text-gray-400 mt-6">
    Base CRSP values and depreciation schedule sourced from Kenya's Current Retail Selling Price schedule (July 2025).
    This tool provides an estimate only and is not a substitute for advice from KRA or a licensed clearing agent.
  </p>
</div>

<script>
  type Row = Record<string, any>;

  const state: {
    category: 'vehicles' | 'motorcycles' | 'tractors';
    data: Record<string, Row[]>;
    depreciation: { directImports: { ageLabel: string; depreciationRate: number }[]; previouslyRegistered: { ageLabel: string; depreciationRate: number }[] } | null;
  } = { category: 'vehicles', data: {}, depreciation: null };

  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const categorySelect = el('category') as HTMLSelectElement;
  const makeSelect = el('make') as HTMLSelectElement;
  const variantSelect = el('variant') as HTMLSelectElement;
  const ageInput = el('age') as HTMLInputElement;
  const ageNote = el('age-note');
  const dutyCategorySelect = el('dutyCategory') as HTMLSelectElement;

  const kes = (n: number) => 'KES ' + Math.round(n).toLocaleString('en-KE');

  // Rates per KRA TEMPLATE 2025 tabulation tab: [Import Duty %, Excise Duty % (or 'flat'), VAT %]
  const DUTY_PRESETS: Record<string, [number, number | 'flat', number]> = {
    upTo1500: [35, 20, 16],
    over1500: [35, 25, 16],
    over3000: [35, 35, 16],
    // Electric: TEMPLATE 2025's own Customs Value divisor uses 35% here despite the forward Import Duty being 25%
    // (the row label is also stale, still reading "35%"). We use the actual applied rate (25%) consistently.
    electric: [25, 10, 16],
    schoolBuses: [35, 25, 16],
    // Prime movers: same label/formula mismatch as Electric — forward duty is really 25%, we use that consistently.
    primeMovers: [25, 0, 16],
    trailers: [35, 0, 16],
    // Ambulance: TEMPLATE 2025's Customs Value formula never backs out the 25% Excise Duty it applies forward
    // (a genuine formula bug, not just a stale label) — we use the correct, internally-consistent divisor instead.
    ambulance: [0, 25, 16],
    motorcycles: [25, 'flat', 16],
    specialPurpose: [0, 0, 16],
    heavyMachinery: [0, 0, 16],
  };

  function setRateFieldsReadonly(readonly: boolean) {
    document.querySelectorAll<HTMLInputElement>('.rate-field').forEach(input => { input.readOnly = readonly; });
  }

  function applyDutyPreset(key: string) {
    if (key === 'custom') {
      setRateFieldsReadonly(false);
      return;
    }
    if (!DUTY_PRESETS[key]) return;
    setRateFieldsReadonly(true);
    const [duty, excise, vat] = DUTY_PRESETS[key];
    (el('dutyRate') as HTMLInputElement).value = String(duty);
    (el('vatRate') as HTMLInputElement).value = String(vat);
    const flatRow = el('flat-excise-row');
    const exciseField = el('excise-rate-field');
    if (excise === 'flat') {
      flatRow.classList.remove('hidden');
      exciseField.classList.add('hidden');
    } else {
      flatRow.classList.add('hidden');
      exciseField.classList.remove('hidden');
      (el('exciseRate') as HTMLInputElement).value = String(excise);
    }
  }

  function suggestDutyCategory(row: Row, category: string): string {
    if (category === 'motorcycles') return 'motorcycles';
    if (category === 'tractors') return 'heavyMachinery';
    const fuel = (row.fuel || '').toUpperCase();
    if (fuel.includes('ELECTRIC')) return 'electric';
    const cc = parseFloat(String(row.engineCapacity || '').replace(/[^0-9.]/g, ''));
    if (!Number.isFinite(cc)) return 'custom';
    if (cc <= 1500) return 'upTo1500';
    const isDiesel = fuel.includes('DIESEL');
    const overThreshold = isDiesel ? cc > 2500 : cc >= 3000;
    return overThreshold ? 'over3000' : 'over1500';
  }

  async function loadCategory(category: string) {
    if (!state.data[category]) {
      const res = await fetch(`/data/kenya-crsp/${category}.json`);
      state.data[category] = await res.json();
    }
    return state.data[category];
  }

  function label(row: Row, category: string) {
    if (category === 'tractors') {
      return `${row.model} (${row.horsepower} HP) — ${kes(row.crspKes)}`;
    }
    const bits = [row.transmission, row.engineCapacity, row.bodyType, row.fuel].filter(Boolean);
    return `${row.model}${bits.length ? ' — ' + bits.join(', ') : ''} — ${kes(row.crspKes)}`;
  }

  function makeKey(row: Row, category: string) {
    return category === 'tractors' ? row.brand : row.make;
  }

  async function populateMakes() {
    const rows = await loadCategory(state.category);
    const makes = [...new Set(rows.map(r => makeKey(r, state.category)).filter(Boolean))].sort();
    makeSelect.innerHTML = '<option value="">Select make…</option>' + makes.map(m => `<option value="${m}">${m}</option>`).join('');
    variantSelect.innerHTML = '<option value="">Select make first…</option>';
    variantSelect.disabled = true;
    hideResult();
  }

  async function populateVariants() {
    const rows = await loadCategory(state.category);
    const make = makeSelect.value;
    if (!make) {
      variantSelect.innerHTML = '<option value="">Select make first…</option>';
      variantSelect.disabled = true;
      hideResult();
      return;
    }
    const indexed = rows.map((r, i) => ({ r, i })).filter(({ r }) => makeKey(r, state.category) === make);
    variantSelect.innerHTML = '<option value="">Select model/variant…</option>' + indexed.map(({ r, i }) => `<option value="${i}">${label(r, state.category)}</option>`).join('');
    variantSelect.disabled = false;
    hideResult();
  }

  function hideResult() {
    el('result').classList.add('hidden');
    el('result-empty').classList.remove('hidden');
  }

  function depreciationFor(ageYears: number, importCategory: string) {
    if (!state.depreciation) return null;
    if (ageYears <= 1) return { rate: 0, label: 'Under 1 year (assumed no depreciation)' };
    const schedule = importCategory === 'direct' ? state.depreciation.directImports : state.depreciation.previouslyRegistered;
    for (const bracket of schedule) {
      const rangeMatch = bracket.ageLabel.match(/>(\d+)\s*<=\s*(\d+)/);
      if (rangeMatch) {
        const lower = parseInt(rangeMatch[1]);
        const upper = parseInt(rangeMatch[2]);
        if (ageYears > lower && ageYears <= upper) return { rate: bracket.depreciationRate, label: bracket.ageLabel };
      } else {
        const singleMatch = bracket.ageLabel.match(/(\d+)/);
        if (singleMatch && ageYears === parseInt(singleMatch[1])) return { rate: bracket.depreciationRate, label: bracket.ageLabel };
      }
    }
    const last = schedule[schedule.length - 1];
    return { rate: last.depreciationRate, label: `${last.ageLabel} (capped — beyond schedule)` };
  }

  function recalc() {
    const idx = variantSelect.value;
    if (idx === '') { hideResult(); return; }
    const rows = state.data[state.category];
    const row = rows[parseInt(idx)];
    const crsp = row.crspKes;
    const importCategory = (document.querySelector('input[name="importCategory"]:checked') as HTMLInputElement).value;
    const age = parseFloat(ageInput.value) || 0;

    const dep = depreciationFor(age, importCategory);
    if (!dep) return;

    if (importCategory === 'direct' && age > 8) {
      ageNote.textContent = 'Note: Kenya generally restricts direct import of vehicles older than 8 years — this estimate uses the oldest available bracket as a floor.';
      ageNote.className = 'text-xs text-amber-600 mt-1';
    } else {
      ageNote.textContent = `Matched depreciation bracket: ${dep.label}`;
      ageNote.className = 'text-xs text-gray-400 mt-1';
    }

    const isFlatExcise = !el('flat-excise-row').classList.contains('hidden');
    const extraDepRate = (parseFloat((el('extraDepreciation') as HTMLInputElement).value) || 0) / 100;
    const dutyRate = parseFloat((el('dutyRate') as HTMLInputElement).value) / 100 || 0;
    const exciseRate = isFlatExcise ? 0 : (parseFloat((el('exciseRate') as HTMLInputElement).value) / 100 || 0);
    const vatRate = parseFloat((el('vatRate') as HTMLInputElement).value) / 100 || 0;
    const idfRate = parseFloat((el('idfRate') as HTMLInputElement).value) / 100 || 0;
    const rdlRate = parseFloat((el('rdlRate') as HTMLInputElement).value) / 100 || 0;

    // Per KRA TEMPLATE 2025: CV = (CRSP / 1.25) * (1-dep) * (1-extraDep) / (1+duty) / (1+excise) / (1+vat)
    // Flat-excise categories (motorcycles) omit the excise term from the divisor since it isn't proportional to CV.
    const customsValue = (crsp / 1.25) * (1 - dep.rate) * (1 - extraDepRate) / (1 + dutyRate) / (1 + exciseRate) / (1 + vatRate);

    const duty = customsValue * dutyRate;
    const excise = isFlatExcise ? (parseFloat((el('flatExcise') as HTMLInputElement).value) || 0) : (customsValue + duty) * exciseRate;
    const vat = (customsValue + duty + excise) * vatRate;
    const idf = Math.max(customsValue * idfRate, 5000);
    const rdl = customsValue * rdlRate;
    const totalTaxes = duty + excise + vat + idf + rdl;

    (el('r-crsp') as HTMLElement).textContent = kes(crsp);
    (el('r-depreciation') as HTMLElement).textContent = `${(dep.rate * 100).toFixed(0)}%`;
    (el('r-customs-value') as HTMLElement).textContent = kes(customsValue);
    (el('r-duty') as HTMLElement).textContent = kes(duty);
    (el('r-excise') as HTMLElement).textContent = kes(excise);
    (el('r-vat') as HTMLElement).textContent = kes(vat);
    (el('r-idf') as HTMLElement).textContent = kes(idf);
    (el('r-rdl') as HTMLElement).textContent = kes(rdl);
    (el('r-total') as HTMLElement).textContent = kes(totalTaxes);

    el('result').classList.remove('hidden');
    el('result-empty').classList.add('hidden');
  }

  async function init() {
    const depRes = await fetch('/data/kenya-crsp/depreciation.json');
    state.depreciation = await depRes.json();
    await populateMakes();

    el('loading-state').classList.add('hidden');
    el('calc-form').classList.remove('hidden');

    categorySelect.addEventListener('change', () => { state.category = categorySelect.value as any; populateMakes(); });
    makeSelect.addEventListener('change', populateVariants);
    variantSelect.addEventListener('change', () => {
      const idx = variantSelect.value;
      if (idx !== '') {
        const row = state.data[state.category][parseInt(idx)];
        const suggested = suggestDutyCategory(row, state.category);
        if (DUTY_PRESETS[suggested]) {
          dutyCategorySelect.value = suggested;
          applyDutyPreset(suggested);
        } else {
          dutyCategorySelect.value = 'custom';
          applyDutyPreset('custom');
        }
      }
      recalc();
    });
    dutyCategorySelect.addEventListener('change', () => { applyDutyPreset(dutyCategorySelect.value); recalc(); });
    ageInput.addEventListener('input', recalc);
    el('extraDepreciation').addEventListener('input', recalc);
    document.querySelectorAll('input[name="importCategory"]').forEach(r => r.addEventListener('change', recalc));
    ['dutyRate', 'exciseRate', 'vatRate', 'idfRate', 'rdlRate', 'flatExcise'].forEach(id => el(id).addEventListener('input', recalc));
  }

  init();
</script>
