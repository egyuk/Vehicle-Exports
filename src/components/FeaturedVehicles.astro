---
import { getCollection } from 'astro:content';
import VehicleCard from './VehicleCard.astro';

const allVehicles = await getCollection('vehicles');
const vehicles = allVehicles
  .filter(v => v.data.featured)
  .sort((a, b) => b.data.price - a.data.price)
  .slice(0, 6);
---

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Top Picks</span>
        <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">Featured Vehicles</h2>
      </div>
      <a href="/shipping-cars" class="text-[var(--color-primary)] hover:text-[var(--color-primary-dark)] font-semibold text-sm flex items-center gap-1 transition-colors">
        View All Vehicles
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {vehicles.map(vehicle => (
        <VehicleCard
          slug={vehicle.id}
          make={vehicle.data.make}
          model={vehicle.data.model}
          title={vehicle.data.title}
          price={vehicle.data.price}
          mileage={vehicle.data.mileage}
          fuel={vehicle.data.fuel}
          transmission={vehicle.data.transmission}
          bodyType={vehicle.data.bodyType}
          year={vehicle.data.year}
          images={vehicle.data.images}
          featured={vehicle.data.featured}
          condition={vehicle.data.condition}
        />
      ))}
    </div>
  </div>
</section>
