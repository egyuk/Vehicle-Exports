---
// "Our Other Services" — the four service cards on every country page.
//
// The first three are the same everywhere. The fourth describes whatever
// pre-shipment work a given route needs, which is the one thing that genuinely
// varies (Australia wants biosecurity cleaning, Kenya wants a KEBS
// inspection), so it is overridable via the `inspection` prop.
//
// Note this stays UK-side on purpose: everything here is work we do before the
// vehicle sails. What happens after it lands belongs on /import-uk-cars/.
interface InspectionCard {
  title: string;
  text: string;
}

interface Props {
  /** Anchor id, matching the page's table of contents. */
  id?: string;
  /** Replaces the fourth card. Defaults to a generic pre-shipping inspection. */
  inspection?: InspectionCard;
}

const { id = 'why-ship', inspection } = Astro.props;

const fourth: InspectionCard = inspection ?? {
  title: 'Government Pre-Shipping Inspection',
  text: 'Where the destination country requires a pre-export roadworthiness inspection, we arrange it with the approved inspection agency before the sailing so the vehicle is not held up on arrival.',
};

const cards: InspectionCard[] = [
  {
    title: 'Car Sourcing / Buying on your behalf',
    text: "We source any new or used vehicle from our network of UK dealers, auctions and private sellers — or buy a specific car you've found on your behalf, protecting you from the pitfalls of paying an unknown seller from overseas.",
  },
  {
    title: 'Tax-Free & VAT-Free Vehicle Supply',
    text: 'We specialise in VAT-qualifying and brand-new tax-free vehicles, so eligible export buyers can have the 20% UK VAT deducted or reclaimed — often the single biggest saving on an exported car.',
  },
  {
    title: 'Pre-Purchase Inspections',
    text: 'Every vehicle we export goes through a rigorous multi-point inspection before shipping, and we can arrange an independent pre-purchase inspection of any car we source so you know its condition before you commit.',
  },
  fourth,
];
---

<div id={id}>
  <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Our Other Services</h2>
  <div class="grid sm:grid-cols-2 gap-6">
    {cards.map(card => (
      <div>
        <h4 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-2">{card.title}</h4>
        <p class="text-gray-600 leading-relaxed text-sm">{card.text}</p>
      </div>
    ))}
  </div>
</div>
