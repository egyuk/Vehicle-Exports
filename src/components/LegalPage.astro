---
import Layout from '../layouts/Layout.astro';

// Shared shell for the three legal pages (privacy, terms, cookies). They are
// long-form prose rather than marketing, so they get a narrower measure than
// the rest of the site and a plain hero without the quote CTAs — a customer
// reading the terms is not looking for a call to action.
//
// The company details below are the single source for all three pages and are
// taken from Companies House record 10399100, not from the marketing copy.
// TODO: add the ICO data protection register entry number to `ico` once it is
// confirmed, and surface it in the Privacy Notice's "Who we are" section.
interface Props {
  title: string;
  description: string;
  heading: string;
  /** Short form for the breadcrumb; the h1 carries the company name. */
  crumb?: string;
  updated: string;
}

const { title, description, heading, crumb, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">{crumb ?? heading}</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-bold text-white font-[family-name:var(--font-heading)]">{heading}</h1>
      <p class="text-gray-400 mt-2 text-sm">Last updated {updated}</p>
    </div>
  </section>

  <section class="py-10 lg:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 legal-prose">
      <slot />
    </div>
  </section>
</Layout>

<style is:global>
  /* Scoped to the legal pages so the long prose stays readable without every
     heading and list needing its own utility classes in three files. */
  .legal-prose h2 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.375rem;
    color: #111827;
    margin: 2.25rem 0 0.75rem;
  }
  .legal-prose h2:first-child { margin-top: 0; }
  .legal-prose h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.0625rem;
    color: #111827;
    margin: 1.5rem 0 0.5rem;
  }
  .legal-prose p,
  .legal-prose li {
    color: #4b5563;
    line-height: 1.75;
  }
  .legal-prose p { margin-bottom: 1rem; }
  .legal-prose ul { list-style: disc; padding-left: 1.25rem; margin-bottom: 1rem; }
  .legal-prose ol { list-style: decimal; padding-left: 1.25rem; margin-bottom: 1rem; }
  .legal-prose li { margin-bottom: 0.4rem; }
  .legal-prose a { color: var(--color-primary); font-weight: 600; }
  .legal-prose a:hover { text-decoration: underline; }
  .legal-prose strong { color: #111827; font-weight: 600; }
  .legal-prose table { width: 100%; border-collapse: collapse; margin-bottom: 1.25rem; font-size: 0.9375rem; }
  .legal-prose th,
  .legal-prose td { text-align: left; vertical-align: top; padding: 0.6rem 0.75rem; border-bottom: 1px solid #f3f4f6; color: #4b5563; }
  .legal-prose th { color: #111827; font-weight: 600; white-space: nowrap; }
  .legal-prose .note {
    background: #f9fafb;
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }
  .legal-prose .note p:last-child { margin-bottom: 0; }
  /* Wide tables scroll rather than pushing the page sideways on a phone. */
  .legal-prose .table-scroll { overflow-x: auto; }
</style>
