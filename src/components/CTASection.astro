---
---

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Left: Download App (Dark) -->
      <div class="relative bg-[var(--color-dark)] rounded-2xl overflow-hidden min-h-[280px]">
        <div class="absolute top-0 right-0 w-48 h-48 bg-white/5 rounded-full -translate-y-1/3 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/3"></div>
        <div class="relative flex items-center h-full">
          <!-- Text content -->
          <div class="p-8 lg:p-10 flex-1">
            <h3 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)] mb-3">
              Download our app
            </h3>
            <p class="text-gray-400 mb-6 text-sm leading-relaxed max-w-xs">
              Whether you're buying, selling, or simply researching cars, AutoDeal is the app for you.
            </p>
            <div class="flex gap-3">
              <a href="#" class="block">
                <img src="/assets/images/section/app-store.png" alt="App Store" class="h-10 hover:opacity-80 transition-opacity" />
              </a>
              <a href="#" class="block">
                <img src="/assets/images/section/google-play.png" alt="Google Play" class="h-10 hover:opacity-80 transition-opacity" />
              </a>
            </div>
          </div>
          <!-- Phone mockup image -->
          <div class="hidden sm:block w-[180px] lg:w-[200px] self-end shrink-0">
            <img src="/assets/images/section/phone-mockup.png" alt="" class="w-full h-auto object-contain" />
          </div>
        </div>
      </div>

      <!-- Right: Looking for a car? (Orange) -->
      <div class="relative bg-[var(--color-primary)] rounded-2xl overflow-hidden min-h-[280px]">
        <div class="absolute top-0 right-0 w-48 h-48 bg-white/10 rounded-full -translate-y-1/3 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/3"></div>
        <div class="relative flex items-center h-full">
          <!-- Text content -->
          <div class="p-8 lg:p-10 flex-1">
            <h3 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)] mb-3">
              Are you looking for a car?
            </h3>
            <p class="text-white/80 mb-6 text-sm leading-relaxed max-w-xs">
              Save time and effort as you no longer need to visit multiple stores to find the right car.
            </p>
            <a href="/cars" class="inline-flex items-center gap-2 bg-white text-[var(--color-primary)] px-6 py-3 rounded-lg font-semibold text-sm hover:bg-gray-100 transition-colors">
              Find cars
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </a>
          </div>
          <!-- Car image -->
          <div class="hidden sm:block w-[200px] lg:w-[240px] self-end shrink-0">
            <img src="/assets/images/section/cta-car.png" alt="" class="w-full h-auto object-contain" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
