---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(date);
}
---

<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)]">News to help choose your car</h2>
    </div>

    <div class="flex flex-nowrap overflow-x-auto gap-4 pb-4 snap-x snap-mandatory [-webkit-overflow-scrolling:touch] sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:pb-0">
      {posts.map(post => (
        <article class="bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg transition-all group flex shrink-0 w-[85vw] sm:w-auto sm:shrink snap-start">
          <!-- Image -->
          <a href={`/car-export-news/${post.data.slug}`} class="block w-[220px] lg:w-[280px] shrink-0">
            <div class="h-full bg-gray-100 overflow-hidden relative">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              ) : (
                <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)]/20 to-[var(--color-dark)]/20 flex items-center justify-center">
                  <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                </div>
              )}
              <div class="blog-date-badge">{formatDate(new Date(post.data.date))}</div>
            </div>
          </a>
          <!-- Text -->
          <div class="p-4 lg:p-5 flex flex-col justify-center flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2 text-xs text-gray-500">
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                {post.data.author}
              </span>
              <span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded text-xs">{post.data.category}</span>
            </div>
            <h3 class="font-semibold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors font-[family-name:var(--font-heading)] text-base lg:text-lg leading-tight mb-2 line-clamp-2">
              <a href={`/car-export-news/${post.data.slug}`}>{post.data.title}</a>
            </h3>
            <p class="text-xs text-gray-500 line-clamp-2 mb-3">{post.data.description}</p>
            <a href={`/car-export-news/${post.data.slug}`} class="text-[var(--color-primary)] font-semibold text-sm hover:underline">Read more</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
