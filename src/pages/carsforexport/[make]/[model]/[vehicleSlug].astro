---
import Layout from '../../../../layouts/Layout.astro';
import VehicleCard from '../../../../components/VehicleCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const vehicles = await getCollection('vehicles');
  return vehicles.map(vehicle => ({
    params: {
      make: vehicle.data.make.toLowerCase().replace(/ /g, '-'),
      model: vehicle.data.model.toLowerCase().replace(/ /g, '-'),
      vehicleSlug: vehicle.id,
    },
    props: { vehicle },
  }));
}

function slugify(str: string) {
  return str.toLowerCase().replace(/ /g, '-');
}

const { vehicle } = Astro.props;
const { Content } = await render(vehicle);
const { title, make, model, year, price, mileage, fuel, transmission, bodyType, color, description, images, condition, doors, driveType, engineSize, features } = vehicle.data;
const slug = vehicle.id;

const makeSlug = slugify(make);
const modelSlug = slugify(model);

const allVehicles = await getCollection('vehicles');
const related = allVehicles
  .filter(v => v.id !== slug && (v.data.make === make || v.data.bodyType === bodyType))
  .slice(0, 3);

const specs = [
  { label: 'Make', value: make },
  { label: 'Model', value: model },
  { label: 'Year', value: String(year) },
  { label: 'Body Type', value: bodyType },
  { label: 'Mileage', value: `${mileage.toLocaleString()} mi` },
  { label: 'Fuel Type', value: fuel },
  { label: 'Transmission', value: transmission },
  { label: 'Color', value: color || 'N/A' },
  { label: 'Condition', value: condition || 'Used' },
  { label: 'Doors', value: doors ? String(doors) : '4' },
  { label: 'Drive Type', value: driveType || 'N/A' },
  { label: 'Engine', value: engineSize || 'N/A' },
];

const hasImages = images && images.length > 0;
---

<Layout title={`${title} - UK Vehicle Exporters`} description={description}>
  <!-- Banner with Breadcrumb -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 overflow-x-auto scrollbar-hide" style="scrollbar-width: none;">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/carsforexport" class="hover:text-[var(--color-primary)] transition-colors">Cars for Export</a>
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href={`/carsforexport/${makeSlug}`} class="hover:text-[var(--color-primary)] transition-colors whitespace-nowrap">{make}</a>
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href={`/carsforexport/${makeSlug}/${modelSlug}`} class="hover:text-[var(--color-primary)] transition-colors whitespace-nowrap">{model}</a>
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white truncate">{title}</span>
      </nav>
    </div>
  </section>

  <section class="py-8 lg:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-[1fr_380px] lg:gap-10">

        <!-- Left Column -->
        <div class="min-w-0">
          <!-- Photo Gallery -->
          <div class="mb-8">
            {hasImages ? (
              <div>
                <div class="relative aspect-[16/10] rounded-2xl overflow-hidden bg-gray-100 mb-3">
                  <img id="main-image" src={images[0]} alt={title} class="w-full h-full object-cover" />
                  {images.length > 1 && (
                    <>
                      <button id="prev-btn" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center text-gray-700 hover:bg-white transition-all shadow-md">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                      </button>
                      <button id="next-btn" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center text-gray-700 hover:bg-white transition-all shadow-md">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                      </button>
                    </>
                  )}
                  <div class="absolute bottom-3 right-3 bg-black/50 text-white text-xs px-3 py-1 rounded-full backdrop-blur-sm">
                    <span id="img-counter">1</span> / {images.length}
                  </div>
                </div>
                {images.length > 1 && (
                  <div class="grid grid-cols-5 gap-2">
                    {images.slice(0, 5).map((img: string, i: number) => (
                      <button class="thumb-btn aspect-[16/10] rounded-lg overflow-hidden border-2 transition-all" data-index={i} style={i === 0 ? 'border-color: var(--color-primary)' : 'border-color: transparent'}>
                        <img src={img} alt={`${title} photo ${i + 1}`} class="w-full h-full object-cover" />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            ) : (
              <div class="aspect-[16/10] rounded-2xl overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                <svg class="w-20 h-20 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            )}
          </div>

          <!-- Mobile Title -->
          <div class="lg:hidden mb-6">
            <div class="flex gap-2 mb-2">
              <span class="bg-[var(--color-primary)] text-white text-xs font-semibold px-2.5 py-1 rounded">{condition || 'Used'}</span>
              <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-2.5 py-1 rounded">{year}</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 font-[family-name:var(--font-heading)]">{title}</h1>
            <div class="text-3xl font-bold text-[var(--color-primary)] mt-2 font-[family-name:var(--font-heading)]">£{price.toLocaleString()}</div>
          </div>

          <!-- Sticky Tab Navigation -->
          <div class="sticky top-[80px] lg:top-[90px] z-10 bg-white border-b border-gray-200 mb-8 lg:rounded-xl lg:border overflow-hidden">
            <div class="flex gap-1 overflow-x-auto scrollbar-hide" id="detail-tabs" style="scrollbar-width: none;">
              <button class="tab-btn active whitespace-nowrap" data-target="overview-section">Overview</button>
              <button class="tab-btn whitespace-nowrap" data-target="specs-section">Specifications</button>
              {features && features.length > 0 && (
                <button class="tab-btn whitespace-nowrap" data-target="features-section">Features</button>
              )}
            </div>
          </div>

          <!-- Overview -->
          <div id="overview-section" class="mb-8">
            <div class="bg-white rounded-2xl border border-gray-200 p-6">
              <h2 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Vehicle Description</h2>
              <div class="prose prose-sm max-w-none text-gray-600">
                <Content />
              </div>
            </div>
          </div>

          <!-- Specifications -->
          <div id="specs-section" class="mb-8">
            <div class="bg-white rounded-2xl border border-gray-200 p-6">
              <h2 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-5">Specifications</h2>
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                {specs.map(spec => (
                  <div class="bg-gray-50 rounded-xl p-4">
                    <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">{spec.label}</p>
                    <p class="text-sm font-semibold text-gray-900">{spec.value}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Features Checklist -->
          {features && features.length > 0 && (
            <div id="features-section" class="mb-8">
              <div class="bg-white rounded-2xl border border-gray-200 p-6">
                <h2 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-5">Features</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {features.map(feature => (
                    <div class="flex items-center gap-3">
                      <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span class="text-sm text-gray-700">{feature}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

        </div>

        <!-- Right Sidebar -->
        <div>
          <div class="lg:sticky lg:top-28 space-y-6">
            <!-- Price Card (desktop) -->
            <div class="hidden lg:block bg-white rounded-2xl border border-gray-200 p-6">
              <div class="flex gap-2 mb-3">
                <span class="bg-[var(--color-primary)] text-white text-xs font-semibold px-2.5 py-1 rounded">{condition || 'Used'}</span>
                <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-2.5 py-1 rounded">{bodyType}</span>
                <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-2.5 py-1 rounded">{year}</span>
              </div>
              <h1 class="text-xl font-bold text-gray-900 font-[family-name:var(--font-heading)]">{title}</h1>
              <div class="text-3xl font-bold text-[var(--color-primary)] mt-3 font-[family-name:var(--font-heading)]">£{price.toLocaleString()}</div>
              <p class="text-sm text-gray-500 mt-2 line-clamp-2">{description}</p>
            </div>

            <!-- Quick Specs -->
            <div class="bg-white rounded-2xl border border-gray-200 p-5">
              <h3 class="text-sm font-semibold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">Quick Specs</h3>
              <div class="space-y-2.5">
                {[
                  { l: 'Mileage', v: `${mileage.toLocaleString()} mi` },
                  { l: 'Fuel', v: fuel },
                  { l: 'Transmission', v: transmission },
                  { l: 'Body Type', v: bodyType },
                  { l: 'Color', v: color || 'N/A' },
                  { l: 'Drive', v: driveType || 'N/A' },
                ].map(s => (
                  <div class="flex justify-between items-center py-2 border-b border-gray-100 last:border-0">
                    <span class="text-sm text-gray-500">{s.l}</span>
                    <span class="text-sm font-semibold text-gray-900">{s.v}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Company Profile -->
            <div class="bg-white rounded-2xl border border-gray-200 p-5 text-center">
              <div class="w-16 h-16 bg-[var(--color-primary)] rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <h4 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">UK Vehicle Exporters</h4>
              <p class="text-xs text-gray-500 mt-1">Trusted UK Vehicle Exporter</p>
              <div class="flex items-center justify-center gap-1 mt-2">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
            </div>

            <!-- Contact CTAs -->
            <div class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 rounded-2xl p-6 text-center">
              <h3 class="text-white font-semibold font-[family-name:var(--font-heading)] text-lg mb-2">Interested?</h3>
              <p class="text-gray-400 text-sm mb-5">Get a free quote including shipping.</p>
              <a href={`/contact?vehicle=${encodeURIComponent(title)}`} class="block w-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white py-3 rounded-lg font-semibold transition-all text-sm mb-3">
                Enquire Now
              </a>
              <a href="tel:+441872491409" class="block w-full border border-white/20 hover:border-white/40 text-white py-3 rounded-lg font-medium transition-all text-sm">
                Call 01872 491409
              </a>
            </div>

            <!-- Export Badge -->
            <div class="bg-orange-50 border border-orange-200 rounded-2xl p-5">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[var(--color-primary)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                <div>
                  <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Export Ready</h4>
                  <p class="text-xs text-gray-600 mt-1">Includes V5C logbook, purchase invoice, and export certificate.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Desktop Photo Lightbox -->
      <div id="lightbox" class="hidden fixed inset-0 z-[9999] bg-black/90 backdrop-blur-sm items-center justify-center">
        <button id="lightbox-close" class="absolute top-5 right-5 w-11 h-11 bg-white/10 hover:bg-white/20 rounded-full flex items-center justify-center text-white transition-colors z-10" aria-label="Close">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
        <button id="lightbox-prev" class="absolute left-5 top-1/2 -translate-y-1/2 w-12 h-12 bg-white/10 hover:bg-white/20 rounded-full flex items-center justify-center text-white transition-colors z-10" aria-label="Previous">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button id="lightbox-next" class="absolute right-5 top-1/2 -translate-y-1/2 w-12 h-12 bg-white/10 hover:bg-white/20 rounded-full flex items-center justify-center text-white transition-colors z-10" aria-label="Next">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
        <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[85vh] object-contain rounded-lg shadow-2xl" />
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/70 text-sm font-medium">
          <span id="lightbox-counter"></span>
        </div>
      </div>

      <!-- Related Vehicles -->
      {related.length > 0 && (
        <div class="mt-16 pt-12 border-t border-gray-200">
          <h2 class="text-2xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-8">Similar Vehicles</h2>
          <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6">
            {related.map(v => (
              <VehicleCard
                slug={v.id}
                make={v.data.make}
                model={v.data.model}
                title={v.data.title}
                price={v.data.price}
                mileage={v.data.mileage}
                fuel={v.data.fuel}
                transmission={v.data.transmission}
                bodyType={v.data.bodyType}
                year={v.data.year}
                images={v.data.images}
                featured={v.data.featured}
                condition={v.data.condition}
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<!-- Gallery Script -->
{hasImages && images.length > 1 && (
  <script is:inline define:vars={{ images }}>
    var mainImg = document.getElementById('main-image');
    var counter = document.getElementById('img-counter');
    var prevBtn = document.getElementById('prev-btn');
    var nextBtn = document.getElementById('next-btn');
    var thumbs = document.querySelectorAll('.thumb-btn');
    var current = 0;

    function showImage(index) {
      current = index;
      mainImg.src = images[current];
      counter.textContent = String(current + 1);
      thumbs.forEach(function(t, i) {
        t.style.borderColor = i === current ? 'var(--color-primary)' : 'transparent';
      });
    }
    prevBtn && prevBtn.addEventListener('click', function() { showImage((current - 1 + images.length) % images.length); });
    nextBtn && nextBtn.addEventListener('click', function() { showImage((current + 1) % images.length); });
    thumbs.forEach(function(t) { t.addEventListener('click', function() { showImage(Number(t.dataset.index)); }); });
    showImage(0);

    // Desktop-only Lightbox
    var isDesktop = window.matchMedia('(min-width: 1024px)');
    var lightbox = document.getElementById('lightbox');
    var lightboxImg = document.getElementById('lightbox-img');
    var lightboxCounter = document.getElementById('lightbox-counter');
    var lightboxClose = document.getElementById('lightbox-close');
    var lightboxPrev = document.getElementById('lightbox-prev');
    var lightboxNext = document.getElementById('lightbox-next');
    var lightboxIndex = 0;

    function openLightbox(idx) {
      if (!isDesktop.matches) return;
      lightboxIndex = idx;
      lightboxImg.src = images[lightboxIndex];
      lightboxCounter.textContent = (lightboxIndex + 1) + ' / ' + images.length;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function lightboxNav(dir) {
      lightboxIndex = (lightboxIndex + dir + images.length) % images.length;
      lightboxImg.src = images[lightboxIndex];
      lightboxCounter.textContent = (lightboxIndex + 1) + ' / ' + images.length;
    }

    // Click main image to open lightbox
    mainImg.style.cursor = isDesktop.matches ? 'zoom-in' : '';
    mainImg.addEventListener('click', function() { openLightbox(current); });

    // Click thumbnails to open lightbox
    thumbs.forEach(function(t) {
      t.addEventListener('dblclick', function() { openLightbox(Number(t.dataset.index)); });
    });

    lightboxClose && lightboxClose.addEventListener('click', closeLightbox);
    lightboxPrev && lightboxPrev.addEventListener('click', function() { lightboxNav(-1); });
    lightboxNext && lightboxNext.addEventListener('click', function() { lightboxNav(1); });

    // Close on backdrop click
    lightbox && lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) closeLightbox();
    });

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') lightboxNav(-1);
      if (e.key === 'ArrowRight') lightboxNav(1);
    });

    // Update cursor on resize
    isDesktop.addEventListener('change', function() {
      mainImg.style.cursor = isDesktop.matches ? 'zoom-in' : '';
      if (!isDesktop.matches) closeLightbox();
    });
  </script>
)}

<!-- Tab Navigation Script -->
<script>
  const tabs = document.querySelectorAll('#detail-tabs .tab-btn');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const target = (tab as HTMLElement).dataset.target;
      if (target) {
        const el = document.getElementById(target);
        el?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>
