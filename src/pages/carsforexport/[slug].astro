---
import { getCollection } from 'astro:content';

function slugify(str: string) {
  return str.toLowerCase().replace(/ /g, '-');
}

export async function getStaticPaths() {
  const vehicles = await getCollection('vehicles');
  return vehicles.map(vehicle => ({
    params: { slug: vehicle.id },
    props: { vehicle },
  }));
}

const { vehicle } = Astro.props;
const makeSlug = slugify(vehicle.data.make);
const modelSlug = slugify(vehicle.data.model);
const newUrl = `/carsforexport/${makeSlug}/${modelSlug}/${vehicle.id}`;

return Astro.redirect(newUrl, 301);
---
