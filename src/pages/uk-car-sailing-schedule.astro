---
import Layout from '../layouts/Layout.astro';
import schedules from '../data/sailing-schedules.json';

// Everything on this page is generated from src/data/sailing-schedules.json.
// Weekly routine: correct the rows in "sailings", bump "updated". No markup changes.

const { updated, source, sailings } = schedules;

const today = new Date();
const todayISO = today.toISOString().slice(0, 10);
const daysSince = Math.floor((today.getTime() - new Date(updated).getTime()) / 86400000);
const isStale = daysSince > 7;

const fmtDate = (d: string) =>
  d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';

// Transit is derived so there is one less field to keep in step each week.
const transitDays = (ets: string, eta: string) =>
  ets && eta ? Math.round((new Date(eta).getTime() - new Date(ets).getTime()) / 86400000) : null;

const rows = sailings
  .map(s => ({ ...s, transit: transitDays(s.ets, s.eta), past: s.ets < todayISO }))
  .sort((a, b) => String(a.ets).localeCompare(String(b.ets)));

const upcoming = rows.filter(r => !r.past).length;
const exampleCount = rows.filter(r => r.example).length;
const loadPorts = [...new Set(rows.map(r => r.loadPort).filter(Boolean))].sort();
// Shown as "Country, Port" but stored as "Port, Country": the trailing country
// segment is load-bearing for the per-country pages, lane inference and dedupe,
// so this flip is display-only.
const flipDest = (d: string) => {
  const i = d.lastIndexOf(',');
  return i === -1 ? d : `${d.slice(i + 1).trim()}, ${d.slice(0, i).trim()}`;
};

// Grouped into <optgroup> so a country appears once as a heading with its ports
// indented beneath, rather than repeating for every port.
//
// The option VALUE stays the full "Country, Port" string because that is what
// the row's data-dest holds and the filter compares against; only the visible
// label is shortened to the port.
//
// localeCompare, not the default sort: accented country names (Côte d'Ivoire,
// Curaçao, Réunion) otherwise order oddly within their letter group.
const destinationGroups = (() => {
  const byCountry = new Map();
  for (const r of rows) {
    const full = flipDest(r.destination);
    if (!full) continue;
    const i = full.indexOf(',');
    const country = i === -1 ? full : full.slice(0, i).trim();
    const port = i === -1 ? full : full.slice(i + 1).trim();
    if (!byCountry.has(country)) byCountry.set(country, new Map());
    byCountry.get(country).set(full, port);
  }
  return [...byCountry]
    .map(([country, ports]) => ({
      country,
      ports: [...ports]
        .map(([value, label]) => ({ value, label }))
        .sort((a, b) => a.label.localeCompare(b.label)),
    }))
    .sort((a, b) => a.country.localeCompare(b.country));
})();

---

<Layout
  title="UK Car Sailing Schedule – Vehicle Shipping Dates | UK Vehicle Exporters"
  description="Working list of vehicle export sailings by load port, destination and departure date, reviewed and updated weekly."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">UK Car Sailing Schedule</span>
      </nav>
      <h1 class="text-3xl lg:text-5xl font-bold text-white font-[family-name:var(--font-heading)] max-w-3xl">UK Car Sailing Schedule</h1>
      <p class="text-gray-400 mt-4 max-w-2xl leading-relaxed">
        Sailings from UK and European ports by destination and departure date. Dates are indicative and must be reconfirmed with the carrier before a booking is committed.
      </p>

      <div class="flex flex-wrap items-center gap-3 mt-8">
        <span class={`inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold ${isStale ? 'bg-amber-500/15 text-amber-300 border border-amber-500/30' : 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'}`}>
          <span class={`w-2 h-2 rounded-full ${isStale ? 'bg-amber-400' : 'bg-emerald-400'}`}></span>
          Updated {fmtDate(updated)}
          {daysSince > 0 && <span class="font-normal opacity-80">· {daysSince} day{daysSince === 1 ? '' : 's'} ago</span>}
        </span>
        <span class="inline-flex items-center gap-2 bg-white/5 border border-white/10 text-gray-300 px-4 py-2 rounded-xl text-sm">
          {upcoming} upcoming sailing{upcoming === 1 ? '' : 's'} · {rows.length} listed
        </span>
      </div>
      {isStale && (
        <p class="text-amber-300/90 text-sm mt-3">Not refreshed in over a week. Check the carrier schedules before quoting.</p>
      )}
    </div>
  </section>

  <!-- Controls -->
  <!-- Sticky stack from lg up: the site nav goes position:fixed (81px) once you
       scroll, so the filter bar sits below it and the table header below that.
       Left non-sticky on mobile, where this bar is 345px tall stacked. -->
  <section class="py-6 bg-white border-b border-gray-100 lg:sticky lg:top-[81px] lg:z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Mobile: two columns, with Search and Load UK Ports sharing the first
           row and Destination spanning both beneath, since its option labels are
           long. Reverts to a single flex row from lg. -->
      <div class="grid grid-cols-2 gap-4 lg:flex lg:flex-row lg:items-end">
        <div class="relative lg:flex-1 lg:max-w-sm">
          <label class="block text-xs font-medium text-gray-500 mb-1.5">Search</label>
          <input
            type="search"
            id="sail-search"
            placeholder="Vessel, port, destination, carrier"
            class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 outline-none focus:border-[var(--color-primary)] transition-colors"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1.5">Load UK Ports</label>
          <select id="sail-port" class="w-full lg:w-auto bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-[var(--color-primary)] transition-colors">
            <option value="">All UK Ports</option>
            {loadPorts.map(p => <option value={p}>{p}</option>)}
          </select>
        </div>
        <div class="col-span-2 lg:col-span-1">
          <label class="block text-xs font-medium text-gray-500 mb-1.5">Destination</label>
          <select id="sail-dest" class="w-full lg:w-auto bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-900 outline-none focus:border-[var(--color-primary)] transition-colors">
            <option value="">All destinations</option>
            {destinationGroups.map(g => (
              <optgroup label={g.country}>
                {g.ports.map(p => <option value={p.value}>{p.label}</option>)}
              </optgroup>
            ))}
          </select>
        </div>
        <label class="col-span-2 lg:col-span-1 flex items-center gap-2 text-sm text-gray-600 lg:pb-2.5 cursor-pointer">
          <input type="checkbox" id="sail-hide-past" checked class="w-4 h-4 accent-[var(--color-primary)]" />
          Hide departed
        </label>
      </div>
      <p id="sail-count" class="text-xs text-gray-400 mt-3"></p>
    </div>
  </section>

  <!-- Sailings table -->
  <section class="py-10 lg:py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {exampleCount > 0 && (
        <div class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-5 text-sm text-amber-900">
          <strong class="font-semibold">{exampleCount} example row{exampleCount === 1 ? '' : 's'} shown.</strong>
          These are placeholders to demonstrate the layout, not real sailings. Replace them in <code class="text-xs bg-amber-100 px-1.5 py-0.5 rounded">src/data/sailing-schedules.json</code>.
        </div>
      )}

      <!-- overflow-x-auto makes this a scroll container, which would trap a sticky
           header; from lg up the table fits, so overflow is released and the
           header can pin to the page instead, just below the sticky controls. -->
      <!-- scroll-mt clears the sticky nav (and, from lg, the filter bar too) when
           a page change scrolls back to the top of the table. -->
      <div id="sail-wrap" class="border border-gray-200 rounded-xl overflow-x-auto lg:overflow-visible scroll-mt-24 lg:scroll-mt-[230px]">
        <table class="w-full text-sm min-w-[620px]" id="sail-table">
          <thead>
            <tr class="bg-gray-50 text-left">
              <th class="px-4 py-3 bg-gray-50 shadow-[inset_0_-1px_0_#e5e7eb] lg:sticky lg:top-[222px] lg:z-10"><button type="button" class="sail-sort font-semibold text-gray-500 text-xs uppercase tracking-wide hover:text-[var(--color-primary)] transition-colors" data-sort="ets">Departure Date</button></th>
              <th class="px-4 py-3 bg-gray-50 shadow-[inset_0_-1px_0_#e5e7eb] lg:sticky lg:top-[222px] lg:z-10"><button type="button" class="sail-sort font-semibold text-gray-500 text-xs uppercase tracking-wide hover:text-[var(--color-primary)] transition-colors" data-sort="port">UK Port</button></th>
              <th class="px-4 py-3 bg-gray-50 shadow-[inset_0_-1px_0_#e5e7eb] lg:sticky lg:top-[222px] lg:z-10"><button type="button" class="sail-sort font-semibold text-gray-500 text-xs uppercase tracking-wide hover:text-[var(--color-primary)] transition-colors" data-sort="dest">Destination / Port</button></th>
              <th class="px-4 py-3 bg-gray-50 shadow-[inset_0_-1px_0_#e5e7eb] lg:sticky lg:top-[222px] lg:z-10"><button type="button" class="sail-sort font-semibold text-gray-500 text-xs uppercase tracking-wide hover:text-[var(--color-primary)] transition-colors" data-sort="eta">Arrival Date</button></th>
              <th class="px-4 py-3 bg-gray-50 shadow-[inset_0_-1px_0_#e5e7eb] lg:sticky lg:top-[222px] lg:z-10 font-semibold text-gray-500 text-xs uppercase tracking-wide">Transit Time</th>
              <th class="px-4 py-3 bg-gray-50 shadow-[inset_0_-1px_0_#e5e7eb] lg:sticky lg:top-[222px] lg:z-10 font-semibold text-gray-500 text-xs uppercase tracking-wide">Vessel / Ship</th>
            </tr>
          </thead>
          <tbody id="sail-body">
            {rows.map(r => (
              <tr
                class={`sail-row border-b border-gray-100 last:border-0 hover:bg-gray-50/70 transition-colors ${r.past ? 'opacity-45' : ''}`}
                data-port={r.loadPort}
                data-dest={flipDest(r.destination)}
                data-past={String(r.past)}
                data-ets={r.ets}
                data-eta={r.eta || ''}
                data-search={`${r.vessel} ${r.loadPort} ${r.destination} ${r.carrier} ${r.voyage} ${r.lane}`.toLowerCase()}
              >
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="font-semibold text-gray-900">{fmtDate(r.ets)}</span>
                  {r.past && <span class="block text-[11px] text-gray-400">departed</span>}
                </td>
                <td class="px-4 py-3 text-gray-900 whitespace-nowrap">{r.loadPort}</td>
                <td class="px-4 py-3 text-gray-900 font-medium whitespace-nowrap">{flipDest(r.destination)}</td>
                <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{fmtDate(r.eta)}</td>
                <!-- The Channel Islands crossings land the same day, so a bare
                     "0 days" would read as missing data rather than 3 hours. -->
                <td class="px-4 py-3 text-gray-500 whitespace-nowrap">{r.transit === null ? '—' : r.transit === 0 ? 'Same day' : `${r.transit} day${r.transit === 1 ? '' : 's'}`}</td>
                <td class="px-4 py-3 text-gray-700 whitespace-nowrap">
                  {r.vessel}
                  {r.example && <span class="ml-2 text-[10px] font-bold uppercase tracking-wide text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded">Example</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Pagination. Built by the script so the page still lists every sailing
           for crawlers if JS never runs; without JS all rows stay visible and
           this bar stays hidden. -->
      <nav id="sail-pager" class="hidden mt-5 flex-col sm:flex-row sm:items-center sm:justify-between gap-3" aria-label="Schedule pages">
        <p id="sail-range" class="text-sm text-gray-500"></p>
        <div class="flex items-center gap-1">
          <button type="button" id="sail-prev" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 border border-gray-200 hover:border-[var(--color-primary)]/40 hover:text-[var(--color-primary)] disabled:opacity-40 disabled:pointer-events-none transition-colors">Previous</button>
          <div id="sail-pages" class="flex items-center gap-1"></div>
          <button type="button" id="sail-next" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 border border-gray-200 hover:border-[var(--color-primary)]/40 hover:text-[var(--color-primary)] disabled:opacity-40 disabled:pointer-events-none transition-colors">Next</button>
        </div>
      </nav>

      <p id="sail-empty" class="hidden text-center text-gray-400 text-sm py-12">No sailings match those filters.</p>
      {rows.length === 0 && (
        <p class="text-center text-gray-400 text-sm py-12">No sailings recorded yet. Add rows to src/data/sailing-schedules.json.</p>
      )}

      <!-- Small print, kept with the table it qualifies rather than given its
           own band: it is one disclaimer, not a section. Runs the full width so
           it sits on a single line; no nowrap, so it still wraps on mobile
           instead of forcing the page to scroll sideways. -->
      <p class="text-xs font-bold italic text-gray-400 leading-relaxed mt-6">**{source.note}**</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="pt-3 pb-16 lg:pb-20 bg-[var(--color-dark)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)]">Need Space on a Sailing?</h2>
      <p class="text-gray-400 mt-3 max-w-xl mx-auto">Tell us the destination and the vehicle and we will confirm the next available sailing and rate.</p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all mt-6">
        Get a Shipping Quote
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>
</Layout>

<script>
  const search = document.getElementById('sail-search') as HTMLInputElement;
  const portSel = document.getElementById('sail-port') as HTMLSelectElement;
  const destSel = document.getElementById('sail-dest') as HTMLSelectElement;
  const hidePast = document.getElementById('sail-hide-past') as HTMLInputElement;
  const body = document.getElementById('sail-body')!;
  const countEl = document.getElementById('sail-count')!;
  const emptyEl = document.getElementById('sail-empty')!;
  const rows = () => Array.from(body.querySelectorAll<HTMLElement>('.sail-row'));

  const pager = document.getElementById('sail-pager')!;
  const rangeEl = document.getElementById('sail-range')!;
  const pagesEl = document.getElementById('sail-pages')!;
  const prevBtn = document.getElementById('sail-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('sail-next') as HTMLButtonElement;
  const wrap = document.getElementById('sail-wrap')!;

  const PAGE_SIZE = 20;
  let page = 1;
  // Rows passing the filters, in current sort order. Paging slices this rather
  // than re-filtering, so the two concerns stay independent: `matched` is what
  // the filters chose, the slice is what this page shows.
  let matched: HTMLElement[] = [];

  /** Page buttons, windowed around the current page so 60 pages stay usable. */
  function pageNumbers(current: number, total: number) {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const out: (number | '…')[] = [1];
    const from = Math.max(2, current - 1);
    const to = Math.min(total - 1, current + 1);
    if (from > 2) out.push('…');
    for (let i = from; i <= to; i++) out.push(i);
    if (to < total - 1) out.push('…');
    out.push(total);
    return out;
  }

  function render() {
    const total = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
    page = Math.min(page, total);
    const start = (page - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;

    // Hide everything, then reveal this page's slice. Toggling only across
    // `matched` would leave filtered-out rows visible, since nothing else
    // touches them.
    rows().forEach(row => row.classList.add('hidden'));
    matched.slice(start, end).forEach(row => row.classList.remove('hidden'));

    countEl.textContent = matched.length
      ? `Showing ${start + 1}–${Math.min(end, matched.length)} of ${matched.length} sailings`
      : `Showing 0 of ${rows().length} sailings`;
    rangeEl.textContent = `Page ${page} of ${total}`;

    pager.classList.toggle('hidden', matched.length <= PAGE_SIZE);
    pager.classList.toggle('flex', matched.length > PAGE_SIZE);
    prevBtn.disabled = page === 1;
    nextBtn.disabled = page === total;

    pagesEl.replaceChildren(...pageNumbers(page, total).map(n => {
      if (n === '…') {
        const span = document.createElement('span');
        span.className = 'px-1 text-sm text-gray-400';
        span.textContent = '…';
        return span;
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = String(n);
      btn.className = n === page
        ? 'min-w-[38px] px-3 py-2 rounded-lg text-sm font-semibold bg-[var(--color-primary)] text-white'
        : 'min-w-[38px] px-3 py-2 rounded-lg text-sm font-medium text-gray-600 border border-gray-200 hover:border-[var(--color-primary)]/40 hover:text-[var(--color-primary)] transition-colors';
      if (n === page) btn.setAttribute('aria-current', 'page');
      btn.addEventListener('click', () => goTo(n));
      return btn;
    }));
  }

  function goTo(n: number) {
    page = n;
    render();
    wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function apply({ keepPage = false } = {}) {
    const term = search.value.trim().toLowerCase();
    const port = portSel.value;
    const dest = destSel.value;

    matched = rows().filter(row =>
      (!term || (row.dataset.search || '').includes(term)) &&
      (!port || row.dataset.port === port) &&
      (!dest || row.dataset.dest === dest) &&
      (!hidePast.checked || row.dataset.past !== 'true'));

    // A narrower filter can leave fewer pages than the one being viewed, so
    // start over unless the caller is only re-sorting.
    if (!keepPage) page = 1;
    emptyEl.classList.toggle('hidden', matched.length > 0 || rows().length === 0);
    render();
  }

  // Column sorting: departure and arrival sort by date, ports alphabetically.
  let sortKey = 'ets';
  let sortAsc = true;
  document.querySelectorAll<HTMLButtonElement>('.sail-sort').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort!;
      sortAsc = key === sortKey ? !sortAsc : true;
      sortKey = key;
      const sorted = rows().sort((a, b) => {
        const av = key === 'ets' ? a.dataset.ets! : key === 'eta' ? a.dataset.eta! : key === 'port' ? a.dataset.port! : a.dataset.dest!;
        const bv = key === 'ets' ? b.dataset.ets! : key === 'eta' ? b.dataset.eta! : key === 'port' ? b.dataset.port! : b.dataset.dest!;
        return sortAsc ? av.localeCompare(bv) : bv.localeCompare(av);
      });
      sorted.forEach(r => body.appendChild(r));
      // Re-sorting changes which rows fall on page 1, so re-slice. The page
      // number is kept: sorting is a re-ordering, not a new result set.
      apply({ keepPage: true });
    });
  });

  prevBtn.addEventListener('click', () => goTo(page - 1));
  nextBtn.addEventListener('click', () => goTo(page + 1));

  [search, portSel, destSel, hidePast].forEach(el => {
    el.addEventListener(el === search ? 'input' : 'change', () => apply());
  });
  apply();
</script>
