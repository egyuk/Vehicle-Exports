---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ShipOrExportIntro from '../components/ShipOrExportIntro.astro';
import BrandLogos from '../components/BrandLogos.astro';
import VehiclesByBodyType from '../components/VehiclesByBodyType.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ShippingCalculator from '../components/ShippingCalculator.astro';
import CTASection from '../components/CTASection.astro';
import CompareCars from '../components/CompareCars.astro';
import CarReviews from '../components/CarReviews.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import LatestBlog from '../components/LatestBlog.astro';
---

<Layout
  title="UK Vehicle Exporters - Quality Vehicle Export from the UK"
  description="UK vehicle export specialists. We source cars, vans and 4x4s in the UK and ship them worldwide by RoRo and container, from quote to quayside."
>
  <Hero />
  <ShipOrExportIntro />
  <BrandLogos />
  <WhyChooseUs />
  <VehiclesByBodyType />
  <ShippingCalculator />
  <CTASection />
  <CompareCars />
  <CarReviews />
  <LatestBlog />
  <PartnerLogos />
</Layout>
