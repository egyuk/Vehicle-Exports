        </a>
        <a href="/carsforexport" class="inline-flex items-center gap-2 border-2 border-white/20 hover:border-[var(--color-primary)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Browse Export-Ready Cars
        </a>
      </div>
    </div>
  </section>

  <!-- Key Facts -->
  <section class="relative -mt-8 z-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-6">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          {quickFacts.map((fact) => (
            <div class="text-center">
