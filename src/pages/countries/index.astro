---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allCountries = await getCollection('countries');
// Only show top-level regions on the index page
const countries = allCountries.filter(c => !c.data.parentSlug);
---

<Layout title="Export Destinations - AutoDeal">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Global Reach</span>
      <h1 class="text-4xl lg:text-5xl font-bold text-white mt-3 font-[family-name:var(--font-heading)]">Export Destinations</h1>
      <p class="text-gray-400 mt-4 max-w-2xl mx-auto text-lg">We export quality UK vehicles to destinations worldwide. Select a region to learn more about our services.</p>
    </div>
  </section>

  <!-- Countries Grid -->
  <section class="py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {countries.map((country) => (
          <a href={`/countries/${country.data.slug}`} class="group bg-white border border-gray-100 rounded-2xl overflow-hidden hover:shadow-lg hover:border-[var(--color-primary)]/20 transition-all duration-300">
            <!-- Image Area -->
            <div class="aspect-[16/9] bg-gradient-to-br from-gray-100 to-gray-200 relative overflow-hidden">
              {country.data.heroImage ? (
                <img src={country.data.heroImage} alt={country.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-12 h-12 text-gray-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
              )}
              <span class="absolute top-3 left-3 bg-[var(--color-primary)] text-white text-xs font-semibold px-3 py-1 rounded-full">
                {country.data.region}
              </span>
            </div>

            <!-- Content -->
            <div class="p-6">
              <h2 class="text-xl font-bold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors font-[family-name:var(--font-heading)]">
                {country.data.title}
              </h2>
              <p class="text-sm text-gray-500 mt-2 line-clamp-2">{country.data.description}</p>

              <!-- Quick Facts -->
              <div class="flex items-center gap-4 mt-4 pt-4 border-t border-gray-100">
                <div class="flex items-center gap-1.5 text-xs text-gray-500">
                  <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  {country.data.shippingTime}
                </div>
                <div class="flex items-center gap-1.5 text-xs text-gray-500">
                  <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  {country.data.ports.length} ports
                </div>
              </div>

              <!-- Brands -->
              <div class="flex gap-1.5 mt-4 overflow-x-auto scrollbar-hide" style="scrollbar-width: none;">
                {country.data.popularBrands.slice(0, 3).map((brand) => (
                  <span class="bg-gray-50 text-xs text-gray-500 px-2 py-1 rounded whitespace-nowrap shrink-0">{brand}</span>
                ))}
                {country.data.popularBrands.length > 3 && (
                  <span class="bg-gray-50 text-xs text-gray-500 px-2 py-1 rounded whitespace-nowrap shrink-0">+{country.data.popularBrands.length - 3}</span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
