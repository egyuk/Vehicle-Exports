---
// Car shipping from the UK to China. Generated from
// _country-template.astro on 2026-09-03 and safe to edit by hand.
//
// UK-SIDE SCOPE: this page covers what we do — sourcing, tax-free supply, UK
// customs and documentation, and getting the car onto the ship. Destination
// duty, taxes and registration are the importer's responsibility and belong on
// /import-uk-cars/. Do not add them here.
//
// Ports, UK load ports, carriers and transit come from
// src/data/sailing-schedules.json; prices come from src/data/shipping-rates.ts
// via <CountryCosts>. Both refresh on their own, so leave them alone.
import CountryPageLayout from '../../layouts/CountryPageLayout.astro';
import SailingSchedule from '../../components/SailingSchedule.astro';
import CountryCosts from '../../components/CountryCosts.astro';
import CountryBookingTerms from '../../components/CountryBookingTerms.astro';
import CountryServices from '../../components/CountryServices.astro';
import CountrySourcing from '../../components/CountrySourcing.astro';
import CountryTaxFree from '../../components/CountryTaxFree.astro';
import { fromPriceFor } from '../../data/shipping-prices';

const countryName = 'China';
const destinationPorts = ['Xinsha', 'Xingang', 'Shanghai'];
const popularBrands = ['Volkswagen', 'BMW', 'Mercedes-Benz', 'Audi', 'Land Rover', 'Porsche'];
const fromPrice = fromPriceFor(countryName);

const quickFacts = [
  { label: 'Shipping Time', value: '4-8 weeks', sub: 'From Southampton' },
  { label: 'Delivery Ports', value: 'Xinsha, Xingang, Shanghai', sub: '' },
  { label: 'Shipping From', value: '£590', sub: 'Approximate, per vehicle' },
  { label: 'Shipping Lines', value: 'EUKOR', sub: 'and 2 other lines' },
];

const tocLinks = [
  { href: '#costs', label: 'Costs & pricing' },
  { href: '#sailings', label: 'Sailing schedule' },
  { href: '#about', label: 'Shipping to China' },
  { href: '#why-ship', label: 'Our Other Services' },
  { href: '#vat-qualifying', label: 'Tax-Free Vehicle Supply & VAT Reclaims' },
  { href: '#faq', label: 'FAQs' },
];

// Answers restate facts already on this page — keep the two in step.
const faqs = [
  {
    q: `How much does it cost to ship a car from the UK to China?`,
    a: `RoRo shipping starts from around £590 per vehicle, and a 20ft container from about £1,179. Those are indicative rates from our published rate table and move with the market, so call us for the latest. A full export quote also covers the UK-side work: customs clearance, port handling, DVLA paperwork and export documentation.`,
  },
  {
    q: `How long does shipping from the UK to China take?`,
    a: `Current carrier schedules show roughly 4 to 8 weeks port to port, sailing from Southampton. Transit varies with the routing and how many ports the vessel calls at on the way. The live sailing schedule on this page shows the actual dates for each upcoming sailing.`,
  },
  {
    q: `Which UK ports do sailings to China depart from?`,
    a: `Southampton, with EUKOR, Wallenius Wilhelmsen and Hyundai Glovis. We collect vehicles from any UK address and deliver them to the departure port.`,
  },
  {
    q: `Which ports can my car be shipped to in China?`,
    a: `Xinsha, Xingang and Shanghai. Which one your vehicle sails to depends on the service and the date, and we confirm it when the booking is made.`,
  },
  {
    q: `Can I pack personal items in the car?`,
    a: `Not with RoRo — carriers require the vehicle to be empty. If you want to ship personal effects or multiple vehicles together, choose private container shipping instead.`,
  },
  {
    q: `Who handles import duty and registration when the car arrives in China?`,
    a: `That side is the importer's responsibility and the rules vary by country. Our price covers everything up to and including the sailing from the UK; destination import fees are not included. We can introduce you to a customs agent at the arrival port.`,
  },
];
---

<CountryPageLayout
  title={`Car Shipping UK to China | From £590`}
  description="Ship a car from the UK to China (Xinsha, Xingang). From £590. 4-8 weeks transit. Costs, ports and live sailing dates."
  countryName={countryName}
  quickFacts={quickFacts}
  tocLinks={tocLinks}
  popularBrands={popularBrands}
  destinationPorts={destinationPorts}
  fromPrice={fromPrice}
  faqs={faqs}
>
  <CountryCosts countryName={countryName} destinationPorts={destinationPorts} />

  <SailingSchedule
    country={countryName}
    id="sailings"
    standalone={false}
    heading={`Sailing Schedule to China`}
  />

  <div id="about">
    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Shipping to China</h2>
    <p class="text-gray-600 leading-relaxed mb-4">Chinese appetite for British and German luxury is genuine but strictly left-hand drive and routed through licensed importers, with long-wheelbase saloons and Range Rovers leading the grey trade and used-car imports effectively closed to private buyers.</p>

    <div data-lhd-note class="border border-gray-200 bg-gray-50 rounded-xl p-5 mb-4">
      <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-2">No plates for RHD</h3>
      <p class="text-gray-600 leading-relaxed text-sm">China registers left-hand-drive vehicles only, so a car bought in the UK cannot be plated or driven there. China drives on the right and right-hand-drive vehicles cannot be registered at all, which means a British car will never become road-legal no matter what you spend getting it across. If it is a particular German or British marque you want, say so and we will source it in left-hand drive here or in Europe and export it exactly as we would any other order.</p>
      <a href="/contact" class="inline-flex items-center gap-1.5 text-sm text-[var(--color-primary)] font-semibold hover:underline mt-3">
        Tell us what you are looking for
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
    <p class="text-gray-600 leading-relaxed">
      We work directly with the shipping lines serving China, delivering to Xinsha, Xingang and Shanghai, and handle the whole
      UK side for you: sourcing the vehicle, tax-free and VAT-qualifying supply where it applies, collection,
      UK customs clearance and export documentation, and loading onto the ship. Sailings leave from Southampton.
    </p>
  </div>

  <CountryBookingTerms />

  <CountryServices />

  <CountrySourcing countryName={countryName} />

  <CountryTaxFree countryName={countryName} />
</CountryPageLayout>
