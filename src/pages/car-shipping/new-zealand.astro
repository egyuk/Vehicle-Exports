---
// Car shipping from the UK to New Zealand. Generated from
// _country-template.astro on 2026-09-03 and safe to edit by hand.
//
// UK-SIDE SCOPE: this page covers what we do — sourcing, tax-free supply, UK
// customs and documentation, and getting the car onto the ship. Destination
// duty, taxes and registration are the importer's responsibility and belong on
// /import-uk-cars/. Do not add them here.
//
// Ports, UK load ports, carriers and transit come from
// src/data/sailing-schedules.json; prices come from src/data/shipping-rates.ts
// via <CountryCosts>. Both refresh on their own, so leave them alone.
import CountryPageLayout from '../../layouts/CountryPageLayout.astro';
import SailingSchedule from '../../components/SailingSchedule.astro';
import CountryCosts from '../../components/CountryCosts.astro';
import CountryBookingTerms from '../../components/CountryBookingTerms.astro';
import CountryServices from '../../components/CountryServices.astro';
import CountrySourcing from '../../components/CountrySourcing.astro';
import CountryTaxFree from '../../components/CountryTaxFree.astro';
import { fromPriceFor } from '../../data/shipping-prices';

const countryName = 'New Zealand';
const destinationPorts = ['Nelson', 'Auckland', 'Lyttelton', 'Wellington'];
const popularBrands = ['Toyota', 'Ford', 'Mitsubishi', 'Nissan', 'Land Rover', 'BMW', 'Mercedes-Benz'];
const fromPrice = fromPriceFor(countryName);

const quickFacts = [
  { label: 'Shipping Time', value: '2-10 weeks', sub: 'From Southampton and 2 other UK ports' },
  { label: 'Delivery Ports', value: 'Nelson, Auckland, Lyttelton, Wellington', sub: '' },
  { label: 'Shipping From', value: '£851', sub: 'Approximate, per vehicle' },
  { label: 'Shipping Lines', value: 'Wallenius Wilhelmsen', sub: 'and 1 other line' },
];

const tocLinks = [
  { href: '#costs', label: 'Costs & pricing' },
  { href: '#sailings', label: 'Sailing schedule' },
  { href: '#about', label: 'Shipping to New Zealand' },
  { href: '#why-ship', label: 'Our Other Services' },
  { href: '#vat-qualifying', label: 'Tax-Free Vehicle Supply & VAT Reclaims' },
  { href: '#faq', label: 'FAQs' },
];

// Answers restate facts already on this page — keep the two in step.
const faqs = [
  {
    q: `How much does it cost to ship a car from the UK to New Zealand?`,
    a: `RoRo shipping starts from around £851 per vehicle, and a 20ft container from about £1,334. Those are indicative rates from our published rate table and move with the market, so call us for the latest. A full export quote also covers the UK-side work: customs clearance, port handling, DVLA paperwork and export documentation.`,
  },
  {
    q: `How long does shipping from the UK to New Zealand take?`,
    a: `Current carrier schedules show roughly 2 to 10 weeks port to port, sailing from Southampton, Newcastle and Bristol. Transit varies with the routing and how many ports the vessel calls at on the way. The live sailing schedule on this page shows the actual dates for each upcoming sailing.`,
  },
  {
    q: `Which UK ports do sailings to New Zealand depart from?`,
    a: `Southampton, Newcastle and Bristol, with Wallenius Wilhelmsen and Höegh Autoliners. We collect vehicles from any UK address and deliver them to the departure port.`,
  },
  {
    q: `Which ports can my car be shipped to in New Zealand?`,
    a: `Nelson, Auckland, Lyttelton and Wellington. Which one your vehicle sails to depends on the service and the date, and we confirm it when the booking is made.`,
  },
  {
    q: `Can I pack personal items in the car?`,
    a: `Not with RoRo — carriers require the vehicle to be empty. If you want to ship personal effects or multiple vehicles together, choose private container shipping instead.`,
  },
  {
    q: `Who handles import duty and registration when the car arrives in New Zealand?`,
    a: `That side is the importer's responsibility and the rules vary by country. Our price covers everything up to and including the sailing from the UK; destination import fees are not included. We can introduce you to a customs agent at the arrival port.`,
  },
];
---

<CountryPageLayout
  title={`Car Shipping UK to New Zealand | From £851`}
  description="Ship a car from the UK to New Zealand (Nelson, Auckland). From £851. 2-10 weeks transit. Costs, ports and live sailing dates."
  countryName={countryName}
  quickFacts={quickFacts}
  tocLinks={tocLinks}
  popularBrands={popularBrands}
  destinationPorts={destinationPorts}
  fromPrice={fromPrice}
  faqs={faqs}
>
  <CountryCosts countryName={countryName} destinationPorts={destinationPorts} />

  <SailingSchedule
    country={countryName}
    id="sailings"
    standalone={false}
    heading={`Sailing Schedule to New Zealand`}
  />

  <div id="about">
    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Shipping to New Zealand</h2>
    <p class="text-gray-600 leading-relaxed mb-4">Japan is the default source for volume used stock, so UK sellers compete on what Japan cannot supply — Defenders, Jaguars, classic Minis, European prestige and pre-1986 classics that escape the newer emissions and frontal-impact rules — and every car must arrive steam-cleaned to MPI biosecurity standard (underbody, wheel arches, any soil) or it is held at the port, then pass entry certification with Clean Car CO2 charges applied on registration.</p>
    <p class="text-gray-600 leading-relaxed">
      We work directly with the shipping lines serving New Zealand, delivering to Nelson, Auckland, Lyttelton and Wellington, and handle the whole
      UK side for you: sourcing the vehicle, tax-free and VAT-qualifying supply where it applies, collection,
      UK customs clearance and export documentation, and loading onto the ship. Sailings leave from Southampton, Newcastle and Bristol.
    </p>
  </div>

  <CountryBookingTerms />

  <CountryServices />

  <CountrySourcing countryName={countryName} />

  <CountryTaxFree countryName={countryName} />
</CountryPageLayout>
