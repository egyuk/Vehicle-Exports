---
import Layout from '../../layouts/Layout.astro';
// The two rate tables moved to src/data/shipping-rates.ts on 2026-09-03 so the
// country pages can read the same figures. This page renders them unchanged.
import { roroPrices, containerPrices } from '../../data/shipping-rates';

const costFactors = [
  "the location of your country – the further away you are from the UK, the more expensive the cost of shipping your vehicle to your country;",
  "The vehicle shipping costs will also reflect the size of the vehicle being exported. A normal coupe or saloon car will incur a lower rate than than an SUV, Caravan or Truck;",
  "Pre-Export inspections set by your government will also add to the cost of export and shipping e.g. the Kenya government demands that all vehicles to be exported from UK to Kenya must undergo inspection with QISJ, its appointed inspection representative; and",
  "Finally, the method of shipping will be the largest factor in your quote. RoRo, or Roll on Roll Off, will obviously be cheaper than putting your vehicle in a secured container using an aircraft to deliver the vehicle.",
];

const serviceLevels = [
  "Door to Door (from the UK address to your address in your country)",
  "Door to Port (from the UK address to your local port in your country)",
  "Port to Port (from the UK port to your local Port in your country)",
  "Port to Door (from the UK port to your address in your country)",
];


---

<Layout
  title="Approximate UK Car Shipping Prices | UK Vehicle Exporters"
  description="Approximate RoRo and container vehicle shipping prices from the UK to ports worldwide. Get an accurate quote by contacting UK Vehicle Exporters."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/car-shipping" class="hover:text-[var(--color-primary)] transition-colors">UK Car Shipping</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">Shipping Rates</span>
      </nav>
      <span class="inline-block bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-semibold px-4 py-1.5 rounded-full border border-[var(--color-primary)]/20 mb-4">
        Approximate Prices — Call for Latest Rates
      </span>
      <h1 class="text-3xl lg:text-5xl font-bold text-white font-[family-name:var(--font-heading)] max-w-3xl">Vehicle Shipping & Export Prices</h1>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Get a Shipping Quote
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="/shipping-cars" class="inline-flex items-center gap-2 border-2 border-white/20 hover:border-[var(--color-primary)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Browse Export-Ready Cars
        </a>
      </div>
    </div>
  </section>

  <!-- What determines cost -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-6">Shipping Your Vehicle from the UK Is Determined by Various Factors:</h2>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-600 leading-relaxed">{costFactors[0]}</span>
        </li>
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <div class="text-gray-600 leading-relaxed">
            <span>the level of service required i.e</span>
            <ul class="mt-2 ml-4 space-y-1 list-disc marker:text-[var(--color-primary)]">
              {serviceLevels.map(level => <li>{level}</li>)}
            </ul>
            <span class="block mt-2 text-sm text-gray-500">* Door to Port and Port to Port are the most common methods of shipping used by clients;</span>
          </div>
        </li>
        {costFactors.slice(1).map(item => (
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span class="text-gray-600 leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- RoRo -->
  <section class="pt-3 pb-16 lg:pb-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-gray-600 leading-relaxed mb-6">
        RORO shipping is a the most popular way of transporting vehicles from the UK to other countries, in a fast and efficient manner by using specialised ships called "vehicle carriers". RORO shipping methods are mostly used for all types of motorised, rolling and even static cargo, which include cars, trucks, boats, buses, motor homes, travel trailers, tractors, excavators, cranes, and other high & heavy equipment and machinery.
      </p>
      <p class="text-gray-600 leading-relaxed mb-3">RORO vehicle shipping is popular with clients for two reasons:</p>
      <ul class="space-y-3">
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-600 leading-relaxed">It is the cheapest method of international shipping. Exclusive container service is usually more expensive, while air shipping your vehicle is always several times more expensive.</span>
        </li>
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-600 leading-relaxed">Preparing for RoRo service takes the least amount of time. Your vehicle will simply need to be driven up and down the ramps for loading and unloading into the ships / vehicle carriers, so it will need to be able to be mechanically propelled. It allows your vehicle to be available and drivable as quickly as possible after the ship arrives at your local port because the unloading process is simple and quick compared to the tedious process of loading and unloading a car in and out of a container.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Container Shipping -->
  <section class="pt-3 pb-16 lg:pb-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-gray-600 leading-relaxed mb-8">
        Most clients that use Container Shipping, prefer this method of shipping due to high value vehicles, classic cars, or for those who want to ship their cars as well as some of their personal goods and household items. We operates weekly container shipping service, and can collect your vehicle or you can deliver to one of our designated depots. We can also arrange to deliver the container to your address and lower the container to ground level to enable the loading of your car and other items. See out shipping options and services below.
      </p>

      <h3 class="text-lg font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-2">Most Common Container Sizes</h3>
      <p class="text-gray-600 leading-relaxed mb-6">
        Any extra space in the container, including the inside of the vehicle, may be used to store anything else you wish to send with your vehicle. The most common sizes for containers used to send goods and cars are 20ft and 40ft, their dimmensions of which are as follows:
      </p>
      <div class="grid sm:grid-cols-2 gap-4 mb-6">
        <div class="bg-gray-50 border border-gray-100 rounded-xl p-5">
          <h4 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-1.5">20ft Shipping Container</h4>
          <p class="text-sm text-gray-500 leading-relaxed mb-3">Suitable for: 1-2 bedroom moves or a car with only a few boxes.</p>
          <dl class="text-sm space-y-1">
            <div class="flex justify-between gap-2"><dt class="text-gray-400">Size (L x W x H)</dt><dd class="text-gray-700 text-right">19′ 10.5″ x 8′ 0″ x 8′ 6″ (6.1m x 2.4m x 2.6m)</dd></div>
            <div class="flex justify-between gap-2"><dt class="text-gray-400">Total internal volume</dt><dd class="text-gray-700 text-right">1,169 ft³ (33.1 m³)</dd></div>
            <div class="flex justify-between gap-2"><dt class="text-gray-400">Net shipping load</dt><dd class="text-gray-700 text-right">61,289 lb (28,200 kg)</dd></div>
          </dl>
        </div>
        <div class="bg-gray-50 border border-gray-100 rounded-xl p-5">
          <h4 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-1.5">40ft Shipping Container</h4>
          <p class="text-sm text-gray-500 leading-relaxed mb-3">Suitable for: 3-5 bedroom moves or a car plus a typical two bedroom move.</p>
          <dl class="text-sm space-y-1">
            <div class="flex justify-between gap-2"><dt class="text-gray-400">Size (L x W x H)</dt><dd class="text-gray-700 text-right">40′ 0″ x 8′ 0″ x 8′ 6″ (12.2m x 2.4m x 2.6m)</dd></div>
            <div class="flex justify-between gap-2"><dt class="text-gray-400">Total internal volume</dt><dd class="text-gray-700 text-right">2,385 ft³ (67.5 m³)</dd></div>
            <div class="flex justify-between gap-2"><dt class="text-gray-400">Net shipping load</dt><dd class="text-gray-700 text-right">57,759 lb (26,600 kg)</dd></div>
          </dl>
        </div>
      </div>
      <p class="text-gray-600 leading-relaxed">
        You also have the option to share a containers with someone else sending their vehicle. These are usually 40ft containers.
      </p>
    </div>
  </section>

  <!-- Search -->
  <section class="pt-3 pb-6 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <label for="rate-search" class="block text-sm font-medium text-gray-700 mb-2">Search by country or port</label>
      <div class="relative">
        <svg class="w-5 h-5 text-gray-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input id="rate-search" type="search" placeholder="e.g. Kenya, Mombasa, USA…" class="w-full pl-12 pr-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-[var(--color-primary)] transition-colors" />
      </div>
    </div>
  </section>

  <!-- RoRo Prices -->
  <section class="pt-3 pb-16 lg:pb-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">RoRo Shipping Prices <span class="text-sm font-normal text-gray-400">— Approximately, call for latest rates</span></h2>
      <div class="overflow-x-auto rounded-xl border border-gray-100 bg-white max-h-[600px] overflow-y-auto">
        <table class="w-full text-sm rate-table" data-table="roro">
          <thead class="sticky top-0 z-10">
            <tr class="bg-gray-50 text-left">
              <th class="px-4 py-3 font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Country</th>
              <th class="px-4 py-3 font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Port</th>
              <th class="px-4 py-3 font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Vehicle Shipping Cost</th>
            </tr>
          </thead>
          <tbody>
            {roroPrices.map((row, i) => (
              <tr class:list={["border-t border-gray-100 rate-row", i % 2 === 1 && "bg-gray-50/50"]} data-search={`${row.country} ${row.port}`.toLowerCase()}>
                <td class="px-4 py-3 text-gray-900 font-medium">{row.country}</td>
                <td class="px-4 py-3 text-gray-600">{row.port}</td>
                <td class="px-4 py-3 text-[var(--color-primary)] font-semibold whitespace-nowrap">{row.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p id="roro-empty" class="hidden text-center text-gray-400 text-sm py-6">No matching destinations found.</p>
    </div>
  </section>

  <!-- Container Prices -->
  <section class="pt-3 pb-16 lg:pb-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Container Shipping Prices <span class="text-sm font-normal text-gray-400">— Approximately, call for latest rates</span></h2>
      <div class="overflow-x-auto rounded-xl border border-gray-100 bg-gray-50 max-h-[600px] overflow-y-auto">
        <table class="w-full text-sm rate-table" data-table="container">
          <thead class="sticky top-0 z-10">
            <tr class="bg-gray-100 text-left">
              <th class="px-4 py-3 font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Country</th>
              <th class="px-4 py-3 font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Port</th>
              <th class="px-4 py-3 font-semibold text-gray-900 font-[family-name:var(--font-heading)]">20ft Container</th>
              <th class="px-4 py-3 font-semibold text-gray-900 font-[family-name:var(--font-heading)]">40ft Container</th>
            </tr>
          </thead>
          <tbody>
            {containerPrices.map((row, i) => (
              <tr class:list={["border-t border-gray-100 rate-row", i % 2 === 1 && "bg-white"]} data-search={`${row.country} ${row.port}`.toLowerCase()}>
                <td class="px-4 py-3 text-gray-900 font-medium">{row.country}</td>
                <td class="px-4 py-3 text-gray-600">{row.port}</td>
                <td class="px-4 py-3 text-[var(--color-primary)] font-semibold whitespace-nowrap">{row.c20}</td>
                <td class="px-4 py-3 text-[var(--color-primary)] font-semibold whitespace-nowrap">{row.c40}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p id="container-empty" class="hidden text-center text-gray-400 text-sm py-6">No matching destinations found.</p>
      <p class="text-xs text-gray-400 mt-4">Prices are approximate and exclude duties, taxes, collection and redelivery. Contact us for an accurate, up-to-date quote.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="pt-3 pb-16 lg:pb-20 bg-[var(--color-dark)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)]">Don't See Your Destination?</h2>
      <p class="text-gray-400 mt-3 max-w-xl mx-auto">Get in touch and we'll provide an accurate shipping quote for your vehicle and destination.</p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all mt-6">
        Get a Shipping Quote
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>
</Layout>

<script>
  const searchInput = document.getElementById('rate-search') as HTMLInputElement;
  const tables = document.querySelectorAll<HTMLTableElement>('.rate-table');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    tables.forEach(table => {
      let visibleCount = 0;
      table.querySelectorAll<HTMLTableRowElement>('.rate-row').forEach(row => {
        const match = !query || (row.dataset.search || '').includes(query);
        row.classList.toggle('hidden', !match);
        if (match) visibleCount++;
      });
      const emptyId = table.dataset.table === 'roro' ? 'roro-empty' : 'container-empty';
      document.getElementById(emptyId)?.classList.toggle('hidden', visibleCount > 0);
    });
  });
</script>
