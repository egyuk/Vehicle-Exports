---
// Car shipping from the UK to Guernsey. Generated from
// _country-template.astro on 2026-09-03 and safe to edit by hand.
//
// UK-SIDE SCOPE: this page covers what we do — sourcing, tax-free supply, UK
// customs and documentation, and getting the car onto the ship. Destination
// duty, taxes and registration are the importer's responsibility and belong on
// /import-uk-cars/. Do not add them here.
//
// Ports, UK load ports, carriers and transit come from
// src/data/sailing-schedules.json; prices come from src/data/shipping-rates.ts
// via <CountryCosts>. Both refresh on their own, so leave them alone.
import CountryPageLayout from '../../layouts/CountryPageLayout.astro';
import SailingSchedule from '../../components/SailingSchedule.astro';
import CountryCosts from '../../components/CountryCosts.astro';
import CountryBookingTerms from '../../components/CountryBookingTerms.astro';
import CountryServices from '../../components/CountryServices.astro';
import CountrySourcing from '../../components/CountrySourcing.astro';
import CountryTaxFree from '../../components/CountryTaxFree.astro';
import { fromPriceFor } from '../../data/shipping-prices';

const countryName = 'Guernsey';
const destinationPorts = ['St Peter Port'];
const popularBrands = ['Volkswagen', 'BMW', 'Mercedes-Benz', 'Land Rover', 'Mini', 'Toyota', 'Ford'];
const fromPrice = fromPriceFor(countryName);

const quickFacts = [
  { label: 'Shipping Time', value: '1-2 weeks', sub: 'From Portsmouth and Poole' },
  { label: 'Delivery Port', value: 'St Peter Port', sub: '' },
  { label: 'Shipping From', value: 'Call for price', sub: 'Quoted per booking' },
  { label: 'Shipping Line', value: 'Condor Ferries', sub: 'RoRo and container' },
];

const tocLinks = [
  { href: '#costs', label: 'Costs & pricing' },
  { href: '#sailings', label: 'Sailing schedule' },
  { href: '#about', label: 'Shipping to Guernsey' },
  { href: '#why-ship', label: 'Our Other Services' },
  { href: '#vat-qualifying', label: 'Tax-Free Vehicle Supply & VAT Reclaims' },
  { href: '#faq', label: 'FAQs' },
];

// Answers restate facts already on this page — keep the two in step.
const faqs = [
  {
    q: `How much does it cost to ship a car from the UK to Guernsey?`,
    a: `We quote Guernsey per booking rather than from a fixed rate card, because the cost depends on the vehicle, the sailing and the departure port. Call us on 01872 491409 and we will give you an itemised quote covering the UK-side work: customs clearance, port handling, DVLA paperwork and export documentation.`,
  },
  {
    q: `How long does shipping from the UK to Guernsey take?`,
    a: `Current carrier schedules show roughly 1 to 2 weeks port to port, sailing from Portsmouth and Poole. Transit varies with the routing and how many ports the vessel calls at on the way. The live sailing schedule on this page shows the actual dates for each upcoming sailing.`,
  },
  {
    q: `Which UK ports do sailings to Guernsey depart from?`,
    a: `Portsmouth and Poole, with Condor Ferries. We collect vehicles from any UK address and deliver them to the departure port.`,
  },
  {
    q: `Which ports can my car be shipped to in Guernsey?`,
    a: `St Peter Port. Which one your vehicle sails to depends on the service and the date, and we confirm it when the booking is made.`,
  },
  {
    q: `Can I pack personal items in the car?`,
    a: `Not with RoRo — carriers require the vehicle to be empty. If you want to ship personal effects or multiple vehicles together, choose private container shipping instead.`,
  },
  {
    q: `Who handles import duty and registration when the car arrives in Guernsey?`,
    a: `That side is the importer's responsibility and the rules vary by country. Our price covers everything up to and including the sailing from the UK; destination import fees are not included. We can introduce you to a customs agent at the arrival port.`,
  },
];
---

<CountryPageLayout
  title={`Car Shipping UK to Guernsey`}
  description="Ship a car from the UK to Guernsey (St Peter Port). 1-2 weeks transit. Costs, ports and live sailing dates."
  countryName={countryName}
  quickFacts={quickFacts}
  tocLinks={tocLinks}
  popularBrands={popularBrands}
  destinationPorts={destinationPorts}
  fromPrice={fromPrice}
  faqs={faqs}
>
  <CountryCosts countryName={countryName} destinationPorts={destinationPorts} />

  <SailingSchedule
    country={countryName}
    id="sailings"
    standalone={false}
    heading={`Sailing Schedule to Guernsey`}
  />

  <div id="about">
    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Shipping to Guernsey</h2>
    <p class="text-gray-600 leading-relaxed mb-4">No VAT on the island makes a UK car land cheaply, but first-registration duty is scaled on CO2, so low-emission hybrids and EVs are the sweet spot — and with a 35 mph island-wide limit and narrow lanes, buyers want compact premium cars rather than high-mileage motorway saloons.</p>
    <p class="text-gray-600 leading-relaxed">
      We work directly with the shipping lines serving Guernsey, delivering to St Peter Port, and handle the whole
      UK side for you: sourcing the vehicle, tax-free and VAT-qualifying supply where it applies, collection,
      UK customs clearance and export documentation, and loading onto the ship. Sailings leave from Portsmouth and Poole.
    </p>
  </div>

  <CountryBookingTerms />

  <CountryServices />

  <CountrySourcing countryName={countryName} />

  <CountryTaxFree countryName={countryName} />
</CountryPageLayout>
