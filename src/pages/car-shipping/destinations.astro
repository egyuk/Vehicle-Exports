---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface CountryLink {
  name: string;
  href: string;
}

// Master list of individual destination countries, grouped by continent.
// This is the full list (including lower-volume destinations like Bangladesh)
// — the main nav "Countries" dropdown only surfaces a curated subset.
const continentCountries: Record<string, CountryLink[]> = {
  Africa: [
    { name: 'Botswana', href: '/car-shipping/botswana' },
    { name: 'Ghana', href: '/car-shipping/ghana' },
    { name: 'Kenya', href: '/car-shipping/kenya' },
    { name: 'Namibia', href: '/car-shipping/namibia' },
    { name: 'South Africa', href: '/car-shipping/south-africa' },
    { name: 'Tanzania', href: '/car-shipping/tanzania' },
    { name: 'Uganda', href: '/car-shipping/uganda' },
  ],
  Asia: [
    { name: 'Bangladesh', href: '/car-shipping/bangladesh' },
    { name: 'Hong Kong', href: '/car-shipping/hong-kong' },
    { name: 'Indonesia', href: '/car-shipping/indonesia' },
    { name: 'Malaysia', href: '/car-shipping/malaysia' },
    { name: 'Singapore', href: '/car-shipping/singapore' },
    { name: 'Sri Lanka', href: '/car-shipping/sri-lanka' },
    { name: 'Thailand', href: '/car-shipping/thailand' },
  ],
  Caribbean: [
    { name: 'Barbados', href: '/car-shipping/barbados' },
    { name: 'Cayman Islands', href: '/car-shipping/cayman-islands' },
    { name: 'Trinidad and Tobago', href: '/car-shipping/trinidad-and-tobago' },
  ],
  Europe: [
    { name: 'Cyprus', href: '/car-shipping/cyprus' },
    { name: 'Great Britain', href: '/car-shipping/great-britain' },
  ],
  'Middle East': [],
  'North America': [
    { name: 'Canada', href: '/car-shipping/canada' },
    { name: 'USA', href: '/usa-import-america-car-shipping' },
  ],
  Oceania: [
    { name: 'Australia', href: '/car-shipping/australia' },
    { name: 'New Zealand', href: '/car-shipping/new-zealand' },
  ],
};

// Regional overview guides (written content), matched into their continent by `region`.
// A continent can have more than one guide (e.g. Asia has a general guide plus a
// Hong Kong-specific one), so group into arrays rather than overwriting by key.
const allGuides = await getCollection('countries');
const topLevelGuides = allGuides.filter(c => !c.data.parentSlug);
const guidesByContinent = new Map<string, typeof topLevelGuides>();
for (const guide of topLevelGuides) {
  const existing = guidesByContinent.get(guide.data.region) ?? [];
  existing.push(guide);
  guidesByContinent.set(guide.data.region, existing);
}

const continents = Object.entries(continentCountries).map(([name, countries]) => ({
  name,
  countries,
  guides: guidesByContinent.get(name) ?? [],
}));
---

<Layout title="Export Destinations - UK Vehicle Exporters">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Global Reach</span>
      <h1 class="text-4xl lg:text-5xl font-bold text-white mt-3 font-[family-name:var(--font-heading)]">Export Destinations</h1>
      <p class="text-gray-400 mt-4 max-w-2xl mx-auto text-lg">We export quality UK vehicles to destinations worldwide, organised by continent below.</p>
    </div>
  </section>

  <!-- Countries by Continent -->
  <section class="py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      {continents.map((continent) => (
        <div>
          <h2 class="text-2xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-5 pb-3 border-b border-gray-100">Car Shipping and Export to {continent.name}</h2>

          {(() => {
            const guideCards = continent.guides.map((guide) => (
              <a href={`/car-shipping/${guide.data.slug}`} class="group bg-white border border-gray-100 rounded-2xl overflow-hidden hover:shadow-lg hover:border-[var(--color-primary)]/20 transition-all duration-300">
                <div class="aspect-[16/9] bg-gradient-to-br from-gray-100 to-gray-200 relative overflow-hidden">
                  {guide.data.heroImage ? (
                    <img src={guide.data.heroImage} alt={guide.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center">
                      <svg class="w-12 h-12 text-gray-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                  )}
                  <span class="absolute top-3 left-3 bg-[var(--color-primary)] text-white text-xs font-semibold px-3 py-1 rounded-full">
                    {guide.data.region}
                  </span>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors font-[family-name:var(--font-heading)]">
                    {guide.data.title}
                  </h3>
                  <p class="text-sm text-gray-500 mt-2 line-clamp-2">{guide.data.description}</p>
                </div>
              </a>
            ));

            const countryPills = (
              <div class="grid grid-cols-2 gap-3 content-start">
                {continent.countries.map((country) => (
                  <a href={country.href} class="flex items-center gap-2 px-4 py-3 bg-gray-50 hover:bg-orange-50/70 rounded-xl text-sm font-medium text-gray-700 hover:text-[var(--color-primary)] transition-colors">
                    <svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    {country.name}
                  </a>
                ))}
              </div>
            );

            // Guide + countries: guide keeps its original card size, countries fill the rest of the row.
            if (continent.guides.length > 0 && continent.countries.length > 0) {
              return (
                <div class="flex flex-col lg:flex-row gap-6">
                  <div class="lg:w-80 lg:shrink-0 space-y-4">{guideCards}</div>
                  <div class="flex-1">{countryPills}</div>
                </div>
              );
            }

            // Guide only (e.g. Middle East, no countries yet): full-width guide grid.
            if (continent.guides.length > 0) {
              return <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{guideCards}</div>;
            }

            // Countries only (no matching guide yet): full-width country grid.
            if (continent.countries.length > 0) {
              return (
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                  {continent.countries.map((country) => (
                    <a href={country.href} class="flex items-center gap-2 px-4 py-3 bg-gray-50 hover:bg-orange-50/70 rounded-xl text-sm font-medium text-gray-700 hover:text-[var(--color-primary)] transition-colors">
                      <svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                      {country.name}
                    </a>
                  ))}
                </div>
              );
            }

            return null;
          })()}
        </div>
      ))}
    </div>
  </section>
</Layout>
