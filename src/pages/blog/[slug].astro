---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(post => !post.data.draft)
    .map(post => ({
      params: { slug: post.data.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, author, category, image, slug } = post.data;

// Format date
function formatDate(d: Date): string {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

// Get related posts (same category, exclude current)
const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => !p.data.draft && p.data.slug !== slug && p.data.category === category)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Layout title={`${title} - UK Vehicle Exporters Blog`} description={description}>
  <!-- Breadcrumb -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/blog" class="hover:text-[var(--color-primary)] transition-colors">Blog</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white truncate">{title}</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-bold text-white font-[family-name:var(--font-heading)] leading-tight">{title}</h1>
      <p class="text-gray-400 mt-2 max-w-xl">{description}</p>
    </div>
  </section>

  <article class="py-8 lg:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-[1fr_340px] lg:gap-12">

        <!-- Main Content -->
        <div>
          <!-- Post Header -->
          <header class="mb-8">
            <div class="flex items-center gap-4 text-sm text-gray-500 pb-6 border-b border-gray-200">
              <a href={`/blog?category=${encodeURIComponent(category)}`} class="bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-semibold px-3 py-1 rounded-full hover:bg-[var(--color-primary)]/20 transition-colors">
                {category}
              </a>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                {author}
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                {formatDate(date)}
              </span>
            </div>
          </header>

          <!-- Featured Image -->
          {image && (
            <div class="mb-8 rounded-2xl overflow-hidden">
              <img src={image} alt={title} class="w-full h-auto object-cover" />
            </div>
          )}

          <!-- Post Body -->
          <div class="prose prose-lg max-w-none text-gray-600 prose-headings:text-gray-900 prose-headings:font-[family-name:var(--font-heading)] prose-h2:text-2xl prose-h3:text-lg prose-a:text-[var(--color-primary)] prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-800 prose-li:marker:text-[var(--color-primary)] prose-table:text-sm prose-th:bg-gray-50 prose-th:p-3 prose-td:p-3 prose-table:border prose-th:border-gray-200 prose-td:border-gray-200">
            <Content />
          </div>

          <!-- Share + Back -->
          <div class="mt-10 pt-8 border-t border-gray-200 flex items-center justify-between">
            <a href="/blog" class="flex items-center gap-2 text-sm text-gray-500 hover:text-[var(--color-primary)] transition-colors font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              Back to all posts
            </a>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="mt-10 lg:mt-0">
          <div class="lg:sticky lg:top-28 space-y-6">

            <!-- CTA -->
            <div class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 rounded-2xl p-6 text-center">
              <h3 class="text-white font-semibold font-[family-name:var(--font-heading)] text-lg mb-2">Ready to Export?</h3>
              <p class="text-gray-400 text-sm mb-5">Browse our inventory of quality UK vehicles ready for international shipping.</p>
              <a href="/carsforexport" class="block w-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white py-3 rounded-xl font-semibold transition-all hover:shadow-lg hover:shadow-[var(--color-primary)]/25 text-sm">
                Browse Vehicles
              </a>
            </div>

            <!-- Categories -->
            <div class="bg-white rounded-2xl border border-gray-200 p-5">
              <h3 class="text-sm font-semibold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">Categories</h3>
              <div class="space-y-2">
                <a href="/blog" class="block text-sm text-gray-500 hover:text-[var(--color-primary)] transition-colors py-1">All Posts</a>
                <a href="/blog?category=Export+Guide" class="block text-sm text-gray-500 hover:text-[var(--color-primary)] transition-colors py-1">Export Guide</a>
                <a href="/blog?category=Vehicle+Reviews" class="block text-sm text-gray-500 hover:text-[var(--color-primary)] transition-colors py-1">Vehicle Reviews</a>
                <a href="/blog?category=Tips+%26+Advice" class="block text-sm text-gray-500 hover:text-[var(--color-primary)] transition-colors py-1">Tips & Advice</a>
                <a href="/blog?category=Industry+News" class="block text-sm text-gray-500 hover:text-[var(--color-primary)] transition-colors py-1">Industry News</a>
                <a href="/blog?category=Company+Updates" class="block text-sm text-gray-500 hover:text-[var(--color-primary)] transition-colors py-1">Company Updates</a>
              </div>
            </div>

            <!-- Contact Info -->
            <div class="bg-orange-50 border border-orange-200 rounded-2xl p-5">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[var(--color-primary)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <div>
                  <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Have Questions?</h4>
                  <p class="text-xs text-gray-600 mt-1">Get in touch with our team for personalised advice on vehicle exports.</p>
                  <a href="/contact" class="inline-block mt-2 text-xs font-semibold text-[var(--color-primary)] hover:underline">Contact Us</a>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <!-- Related Posts -->
      {related.length > 0 && (
        <div class="mt-16 pt-12 border-t border-gray-200">
          <h2 class="text-2xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-8">Related Posts</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {related.map(r => (
              <a href={`/blog/${r.data.slug}`} class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg hover:border-[var(--color-primary)]/20 transition-all duration-300">
                <div class="relative aspect-[16/9] bg-gray-100 overflow-hidden">
                  {r.data.image ? (
                    <img src={r.data.image} alt={r.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-orange-50 to-orange-100">
                      <svg class="w-10 h-10 text-[var(--color-primary)]/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                      </svg>
                    </div>
                  )}
                  <span class="absolute top-3 left-3 bg-[var(--color-primary)] text-white text-xs font-semibold px-3 py-1 rounded-full">{r.data.category}</span>
                </div>
                <div class="p-5">
                  <p class="text-xs text-gray-400 mb-2">{formatDate(r.data.date)}</p>
                  <h3 class="font-semibold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors font-[family-name:var(--font-heading)] leading-tight">{r.data.title}</h3>
                  <p class="text-sm text-gray-500 mt-2 line-clamp-2">{r.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Layout>
