---
import Layout from '../layouts/Layout.astro';

// Auto-computes the upcoming quarter label (e.g. "October–December 2026") from the build date,
// so this heading stays current without manual edits on future rebuilds.
// NOTE: this only updates the *label* — the vessel names/transit times below are static
// content and still need a human (or a real carrier data feed) to refresh them each quarter.
function getUpcomingQuarterLabel(date = new Date()) {
  const quarterMonths = [
    ['January', 'March'],
    ['April', 'June'],
    ['July', 'September'],
    ['October', 'December'],
  ];
  const currentQuarter = Math.floor(date.getMonth() / 3);
  const nextQuarter = (currentQuarter + 1) % 4;
  const nextYear = currentQuarter === 3 ? date.getFullYear() + 1 : date.getFullYear();
  const [start, end] = quarterMonths[nextQuarter];
  return `${start}–${end} ${nextYear}`;
}
const sailingScheduleLabel = getUpcomingQuarterLabel();

const shippingCosts = [
  { destination: 'Baltimore', saloon: '£1,176', suv: '£1,376' },
  { destination: 'Brunswick', saloon: '£1,176', suv: '£1,376' },
  { destination: 'Charleston', saloon: '£1,176', suv: '£1,431' },
  { destination: 'Galveston', saloon: '£1,360', suv: '£1,431' },
  { destination: 'New York', saloon: '£1,288', suv: '£1,700' },
  { destination: 'Norfolk', saloon: '£1,288', suv: '£1,700' },
  { destination: 'Jacksonville', saloon: '£1,080', suv: '£1,398' },
  { destination: 'Port Hueneme', saloon: '£1,547', suv: '£1,677' },
  { destination: 'San Diego', saloon: '£1,547', suv: '£1,677' },
  { destination: 'Tacoma', saloon: '£1,468', suv: '£1,876' },
];

---

<Layout
  title="Car Shipping to USA – Import a Vehicle to America | UK Vehicle Exporters"
  description="UK Vehicle Exporters provides weekly car shipping by Container and RoRo from the UK to the USA, direct from all main UK ports."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">USA Car Shipping Import</span>
      </nav>
      <span class="inline-block bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-semibold px-4 py-1.5 rounded-full border border-[var(--color-primary)]/20 mb-4">
        USA Shipping Importing Cars to America
      </span>
      <h1 class="text-3xl lg:text-5xl font-bold text-white font-[family-name:var(--font-heading)] max-w-3xl">Car Import, Export and Shipping to America (USA)</h1>
      <p class="text-gray-400 mt-4 max-w-2xl text-lg">
        Exporting your vehicle from the UK to the United States of America
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Get a Shipping Quote
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="/shipping-cars" class="inline-flex items-center gap-2 border-2 border-white/20 hover:border-[var(--color-primary)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Browse Export-Ready Cars
        </a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-gray-600 leading-relaxed">
        UK Vehicle Exporters, provides weekly Car Shipping by Container and RoRo from the UK to the USA, and offer our professional shipping services direct from all main UK ports to and from the USA. We can handle the whole process for you and put you in touch with one of our network of agents throughout the USA who offer customs clearance and delivery services to all US states.
      </p>
    </div>
  </section>

  <!-- RoRo & Container -->
  <section class="pt-3 pb-16 lg:pb-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div>
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">RoRo Vehicle Shipping to USA</h2>
        <p class="text-gray-600 leading-relaxed">
          We offer Roll on Roll off services for cars, SUVs, autos, motorhomes, trucks, vans and buses. All sailings are direct from the UK ports of Liverpool or Southampton to all Ro Ro ports in the United States which include: Freeport, Baltimore, New York, Norfolk, Brunswick, Miami, Charleston, Galveston, Jacksonville, Port Hueneme and Tacoma.
        </p>
      </div>
      <div>
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Container Car Export to America</h2>
        <p class="text-gray-600 leading-relaxed">
          We also provide containerised vehicle shipping to the United States of America for vehicles to be secured and shipped inside their own dedicated 20ft or 40ft shipping containers. We operate a weekly container shipping schedule with departures from the main UK ports of Bristol, Felixstowe, Grangemouth, Liverpool and London Gateway.
        </p>
      </div>
    </div>
  </section>

  <!-- Shipping Costs -->
  <section class="pt-3 pb-16 lg:pb-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">How Much Does It Cost to Ship / Import a Vehicle from the UK to the USA?</h2>
      <p class="text-gray-600 leading-relaxed mb-6">
        Please see below for indicative vehicle shipping costs from the UK to most ports in the US. Our rates are current at the time of writing but may vary depending on the exact destination and vehicle dimensions. Please check with us prior to booking. Rates are port to port shipping only, and exclude duties and taxes, car collection costs, and redelivery (if required) at the destination.
      </p>
      <h3 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">{sailingScheduleLabel} Sailing Schedule to USA</h3>
      <p class="text-gray-600 leading-relaxed mb-6">
        We operate regular weekly RoRo and container sailings to the USA throughout {sailingScheduleLabel}. Contact us for the latest vessel schedule, transit times and availability for your destination port.
      </p>
      <div class="overflow-x-auto rounded-xl border border-gray-100 bg-white">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 text-left">
              <th class="px-4 py-3 font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Destination</th>
              <th class="px-4 py-3 font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Standard Saloon Car</th>
              <th class="px-4 py-3 font-semibold text-gray-900 font-[family-name:var(--font-heading)]">SUV / 4×4</th>
            </tr>
          </thead>
          <tbody>
            {shippingCosts.map((row, i) => (
              <tr class:list={["border-t border-gray-100", i % 2 === 1 && "bg-gray-50/50"]}>
                <td class="px-4 py-3 text-gray-900 font-medium">{row.destination}</td>
                <td class="px-4 py-3 text-[var(--color-primary)] font-semibold">{row.saloon}</td>
                <td class="px-4 py-3 text-[var(--color-primary)] font-semibold">{row.suv}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pt-3 pb-16 lg:pb-20 bg-[var(--color-dark)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)]">Ready to Ship Your Car to the USA?</h2>
      <p class="text-gray-400 mt-3 max-w-xl mx-auto">Get in touch for an up-to-date quote on shipping your vehicle from the UK to any US port.</p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all mt-6">
        Get a Shipping Quote
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>
</Layout>
