---
import Layout from '../layouts/Layout.astro';

const specialities = [
  'New & Used Vehicle Exports from the UK',
  'Tax Free Vehicle Supply and VAT Refunds',
  'Car Sourcing and Brokarage Services',
  'Car Shipping & Customs Clarance',
  'Vehicle Collection / Delivery',
  'Pre-Export Inspection',
  'Pre-Purchase Checks',
  'Parts Supply',
  'Documents',
];
const widestSpecialityIndex = specialities.reduce(
  (maxIdx, item, i, arr) => (item.length > arr[maxIdx].length ? i : maxIdx),
  0
);

---

<Layout
  title="About UK Vehicle Exporters"
  description="Who we are: a UK vehicle export company sourcing cars, vans and commercials for customers worldwide and shipping them by RoRo and container."
>
  <!-- Banner -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">About Us</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-bold text-white font-[family-name:var(--font-heading)]">Your Trusted Vehicle Export Partner</h1>
      <p class="text-gray-400 mt-2 max-w-xl">Quality vehicles from the UK, delivered worldwide with transparency and care.</p>
    </div>
  </section>

  <!-- Ship or Export Intro + Export Specialities - 2 column -->
  <section class="py-8 lg:py-10 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 font-[family-name:var(--font-heading)]">
            <span class="text-[var(--color-primary)]">Vehicle Exporters</span> from the UK
          </h2>
          <p class="text-gray-600 mt-6 leading-relaxed">
            UK Vehicle Exporters are experienced specialists in Sourcing, Supplying, and Exporting vehicles (including – motorbikes, cars, SUVs, vans, trucks, buses, coaches, tractors and farm or plant machinery), and exporting them to private or commercial clients (including car dealers and NGOs). We have access to a network of UK car auctions, car dealers as well as direct private individuals across the UK. All our cars go through rigorous checks and are 198-point inspected before they are exported out of the UK. Services we offer include: Vehicle Sourcing & Supplying, Vehicle Purchase on your behalf, Vehicle Shipping and Exports, Vehicle Collection & Delivery, VAT / Tax Refunds on Vehicle Exports, UK Export & Customs Documentation
          </p>
        </div>
        <div>
          <h3 class="text-base font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-2">Our Export Specialities</h3>
          <div class="flex flex-col lg:inline-flex gap-1 w-full lg:w-auto">
            {specialities.map((item, i) => (
              i === widestSpecialityIndex ? (
                <div class="h-7 rounded-md bg-[var(--color-primary)] px-3 flex items-center w-full lg:w-auto">
                  <span class="text-white text-[11px] font-bold font-[family-name:var(--font-heading)] whitespace-nowrap">{item}</span>
                </div>
              ) : (
                <div class="relative h-7 w-full rounded-md bg-gray-100 overflow-hidden">
                  <div class="absolute inset-y-0 left-0 flex items-center bg-[var(--color-primary)] rounded-md px-3 max-w-full w-fit">
                    <span class="text-white text-[11px] font-bold font-[family-name:var(--font-heading)] whitespace-nowrap">{item}</span>
                  </div>
                </div>
              )
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us - 2 column -->
  <section class="pt-3 pb-16 lg:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="rounded-2xl overflow-hidden aspect-[4/3]">
          <img src="https://images.unsplash.com/photo-1568605117036-5fe5e7bab0b7?w=800&q=80" alt="Quality vehicles" class="w-full h-full object-cover" />
        </div>
        <div>
          <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Who We Are</span>
          <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">Why Choose UK Vehicle Exporters</h2>
          <p class="text-gray-600 mt-4 leading-relaxed">
            UK Vehicle Exporters is a specialist vehicle export company based in Cornwall, England, sourcing and shipping quality vehicles worldwide. With years of experience, we've built a reputation for reliability, transparency, and exceptional service.
          </p>
          <p class="text-gray-600 mt-4 leading-relaxed">
            We are also recognised and listed on the UK Government's Department for International Trade (Great.gov UK Vehicle Exporters Profile).
          </p>

          <div class="grid sm:grid-cols-2 gap-4 mt-8">
            {[
              'Pre-Export Inspection / Customs',
              'VAT Vehicle Export Refunds',
              'Vehicle Parts / Accessories',
              'Vehicle Upgrades & Styling',
              'Car Sourcing & Supplying',
              'Car Collection / Delivery',
            ].map(item => (
              <div class="flex items-center p-4 bg-gray-50 rounded-xl">
                <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)] leading-snug">{item}</h4>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="pt-3 pb-16 lg:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Why Choose Us?</span>
        <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">What Sets Us Apart</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          'Export ANY Car from anywhere in the UK',
          'Specialist Experts for Decades',
          'We offer complete dealer to door service',
          'Background Checks on every vehicle',
          'We ship your documents by DHL / UPS',
          'Secure transactions for your funds',
          'Backed by our dedicated support staff',
          'BIG savings from advertised prices',
        ].map(item => (
          <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
            <svg class="w-5 h-5 text-[var(--color-primary)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <p class="text-sm text-gray-700 leading-snug">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 bg-[var(--color-dark)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">500+</div>
          <div class="text-sm text-gray-400 mt-1">Vehicles Exported</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">50+</div>
          <div class="text-sm text-gray-400 mt-1">Countries Served</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">98%</div>
          <div class="text-sm text-gray-400 mt-1">Client Satisfaction</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">10+</div>
          <div class="text-sm text-gray-400 mt-1">Years Experience</div>
        </div>
      </div>
    </div>
  </section>

</Layout>
