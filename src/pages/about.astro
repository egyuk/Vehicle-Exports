---
import Layout from '../layouts/Layout.astro';

const team = [
  { name: 'James Mitchell', role: 'Managing Director', img: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=300&h=300&q=80&fit=crop' },
  { name: 'Sarah Thompson', role: 'Sales Manager', img: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300&h=300&q=80&fit=crop' },
  { name: 'David Chen', role: 'Logistics Coordinator', img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&q=80&fit=crop' },
  { name: 'Emma Wilson', role: 'Customer Relations', img: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=300&h=300&q=80&fit=crop' },
];

const testimonials = [
  { name: 'Ahmed K.', location: 'Dubai, UAE', text: 'AutoDeal made the entire process seamless. The car arrived in perfect condition and the documentation was spot on.', rating: 5 },
  { name: 'Michael O.', location: 'Lagos, Nigeria', text: 'Best export service I have used. Fair pricing, great communication, and the vehicle was exactly as described.', rating: 5 },
  { name: 'Jean-Pierre M.', location: 'Mombasa, Kenya', text: 'Third time buying from AutoDeal. Consistent quality and reliable shipping every single time. Highly recommended.', rating: 5 },
];
---

<Layout title="About Us - AutoDeal">
  <!-- Banner -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">About Us</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-bold text-white font-[family-name:var(--font-heading)]">Your Trusted Vehicle Export Partner</h1>
      <p class="text-gray-400 mt-2 max-w-xl">Quality vehicles from the UK, delivered worldwide with transparency and care.</p>
    </div>
  </section>

  <!-- Why Choose Us - 2 column -->
  <section class="py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="rounded-2xl overflow-hidden aspect-[4/3]">
          <img src="https://images.unsplash.com/photo-1568605117036-5fe5e7bab0b7?w=800&q=80" alt="Quality vehicles" class="w-full h-full object-cover" />
        </div>
        <div>
          <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Who We Are</span>
          <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">Why Choose AutoDeal</h2>
          <p class="text-gray-600 mt-4 leading-relaxed">
            AutoDeal is a UK-based vehicle export company specializing in sourcing and shipping quality vehicles worldwide. With years of experience, we've built a reputation for reliability, transparency, and exceptional service.
          </p>

          <div class="grid sm:grid-cols-2 gap-4 mt-8">
            <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
              <div class="w-10 h-10 bg-[var(--color-primary)]/10 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Quality Inspected</h4>
                <p class="text-xs text-gray-500 mt-1">Every vehicle undergoes multi-point inspection.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
              <div class="w-10 h-10 bg-[var(--color-primary)]/10 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Global Shipping</h4>
                <p class="text-xs text-gray-500 mt-1">Export to 50+ countries worldwide.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
              <div class="w-10 h-10 bg-[var(--color-primary)]/10 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Transparent Pricing</h4>
                <p class="text-xs text-gray-500 mt-1">No hidden fees. Full cost breakdown included.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
              <div class="w-10 h-10 bg-[var(--color-primary)]/10 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Expert Support</h4>
                <p class="text-xs text-gray-500 mt-1">Dedicated team from selection to delivery.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 bg-[var(--color-dark)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">500+</div>
          <div class="text-sm text-gray-400 mt-1">Vehicles Exported</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">50+</div>
          <div class="text-sm text-gray-400 mt-1">Countries Served</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">98%</div>
          <div class="text-sm text-gray-400 mt-1">Client Satisfaction</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[var(--color-primary)] font-[family-name:var(--font-heading)]">10+</div>
          <div class="text-sm text-gray-400 mt-1">Years Experience</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Our Team</span>
        <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">Meet Our Agents</h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {team.map(member => (
          <div class="text-center group">
            <div class="aspect-square rounded-2xl overflow-hidden mb-4 bg-gray-100">
              <img src={member.img} alt={member.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">{member.name}</h3>
            <p class="text-sm text-gray-500 mt-0.5">{member.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-[var(--color-primary)] text-sm font-semibold uppercase tracking-wider">Testimonials</span>
        <h2 class="text-3xl font-bold text-gray-900 mt-2 font-[family-name:var(--font-heading)]">What Our Clients Say</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {testimonials.map(t => (
          <div class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-lg transition-all">
            <div class="flex gap-1 mb-4">
              {[1,2,3,4,5].map(() => (
                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">"{t.text}"</p>
            <div>
              <p class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">{t.name}</p>
              <p class="text-xs text-gray-500">{t.location}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="py-12 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm text-gray-400 uppercase tracking-wider mb-8 font-medium">Trusted Partner Brands</p>
      <div class="grid grid-cols-4 lg:grid-cols-8 gap-6 items-center">
        {['Toyota', 'BMW', 'Mercedes', 'Audi', 'Ford', 'Nissan', 'Land Rover', 'Kia'].map(brand => (
          <div class="flex items-center justify-center p-4 grayscale hover:grayscale-0 opacity-40 hover:opacity-100 transition-all duration-300">
            <span class="text-sm font-bold text-gray-600 font-[family-name:var(--font-heading)] tracking-wide">{brand}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
