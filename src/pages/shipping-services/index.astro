---
import Layout from '../../layouts/Layout.astro';
import { shippingServices } from '../../data/shippingServices';
---

<Layout
  title="Shipping Services | UK Vehicle Exporters"
  description="Every way we ship from the UK: RoRo, containers, classics, motorhomes, coaches, plant machinery and household goods — worldwide."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">Shipping Services</span>
      </nav>
      <h1 class="text-3xl lg:text-5xl font-bold text-white font-[family-name:var(--font-heading)] max-w-3xl">Shipping Services</h1>
      <p class="text-gray-400 mt-4 text-lg leading-relaxed max-w-2xl">
        Whatever you need to move from the UK — a car, a classic, a coach, a tractor or a whole household — there's a service below that ships it.
      </p>
    </div>
  </section>

  <!-- Services grid -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {shippingServices.map(s => (
          <a href={`/shipping-services/${s.slug}`} class="group bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-lg transition-all">
            <h2 class="text-lg font-semibold text-gray-900 group-hover:text-[var(--color-primary)] leading-snug transition-colors font-[family-name:var(--font-heading)]">{s.name}</h2>
            <p class="text-sm text-gray-500 mt-2 leading-snug">{s.shortDesc}</p>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-primary)] mt-4">
              Learn more
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
        <a href="/car-shipping" class="group bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-lg transition-all">
          <h2 class="text-lg font-semibold text-gray-900 group-hover:text-[var(--color-primary)] leading-snug transition-colors font-[family-name:var(--font-heading)]">Car Shipping</h2>
          <p class="text-sm text-gray-500 mt-2 leading-snug">RoRo and container shipping to any country from the UK — rates, ports and destinations.</p>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-primary)] mt-4">
            Learn more
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-12 bg-[var(--color-dark)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)] mb-3">Not Sure Which Service You Need?</h2>
      <p class="text-gray-400 max-w-xl mx-auto mb-6">Tell us what you're shipping and where it's going — we'll recommend the right method and confirm the price.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Contact Our Export Team
        </a>
        <a href="tel:+441872491409" class="inline-flex items-center gap-2 border-2 border-white/20 hover:border-[var(--color-primary)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Call 01872 491409
        </a>
      </div>
    </div>
  </section>
</Layout>
