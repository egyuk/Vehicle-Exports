---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact UK Vehicle Exporters"
  description="Talk to our UK vehicle export team about sourcing, shipping rates and sailing dates. Phone, email and enquiry form, plus our UK office address."
>
  <!-- Banner -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">Contact</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-bold text-white font-[family-name:var(--font-heading)]">Contact Us</h1>
      <p class="text-gray-400 mt-2 max-w-xl">Have a question or need a quote? We'd love to hear from you.</p>
    </div>
  </section>

  <!-- Get In Touch (verbatim from vehicleexports.co.uk/contact-us/) -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl border border-gray-100 p-6 sm:p-8 shadow-sm mb-12">
        <h2 class="text-xl font-bold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">GET IN TOUCH WITH US</h2>
        <p class="font-semibold text-gray-900 mb-2">Are you looking for:</p>
        <ul class="list-disc list-inside text-gray-600 text-sm space-y-1 mb-4">
          <li>Vehicle export or shipping quotes?</li>
          <li>advice regarding the rules and regulations of exporting vehicles from the UK?</li>
          <li>details on export procedures and how to properly ship your vehicle out of the UK?</li>
        </ul>
        <p class="text-gray-600 text-sm mb-4">Please complete the Contact Form giving as much details as possible. Our UK Vehicle Exporters agents will get back to you within hours and can advise on any of the following:</p>
        <div class="grid sm:grid-cols-2 gap-x-8">
          <ul class="list-disc list-inside text-gray-600 text-sm space-y-1">
            <li>Vehicle Sourcing & Supplying</li>
            <li>Vehicle Collection and Delivery</li>
            <li>Pre-Export Inspection / Customs</li>
            <li>VAT Vehicle Export Refunds</li>
          </ul>
          <ul class="list-disc list-inside text-gray-600 text-sm space-y-1">
            <li>Shipping and Freight Rates</li>
            <li>Export Guidance and Advice</li>
            <li>Vehicle Parts / Accessories</li>
            <li>Vehicle Upgrades & Styling</li>
          </ul>
        </div>
      </div>

      <!-- Form + Map -->
      <div class="grid lg:grid-cols-2 gap-8 items-stretch">
        <!-- Form -->
        <div class="bg-white border border-gray-100 rounded-2xl p-6 sm:p-8 shadow-sm h-full">
          <h2 class="text-xl font-bold text-gray-900 mb-2 font-[family-name:var(--font-heading)]">Send Us a Message</h2>
          <p class="text-sm text-gray-500 mb-6">Fill out the form and we'll get back to you within 24 hours.</p>
          <form class="space-y-5" onsubmit="event.preventDefault()">
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Name</label>
                <input type="text" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" placeholder="Your name" />
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Email</label>
                <input type="email" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" placeholder="your@email.com" />
              </div>
            </div>
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Phone</label>
                <input type="tel" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" placeholder="+44 ..." />
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Subject</label>
                <input type="text" id="subject-input" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all" placeholder="How can we help?" />
              </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase tracking-wider">Message</label>
              <textarea rows="5" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)] outline-none transition-all resize-none" placeholder="Tell us about the vehicle you're looking for..."></textarea>
            </div>
            <button type="submit" class="w-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white py-3.5 rounded-lg font-semibold transition-all hover:shadow-lg text-sm">
              Send Message
            </button>
          </form>
        </div>

        <!-- Map / Info -->
        <div class="flex flex-col gap-6 h-full">
          <!-- Google Map -->
          <div class="bg-gray-100 rounded-2xl overflow-hidden aspect-[4/3] lg:aspect-auto lg:h-[300px]">
            <iframe
              src="https://www.google.com/maps?q=Penstraze+Business+Park,+Penstraze,+Truro,+Cornwall,+TR4+8PN&output=embed"
              class="w-full h-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="UK Vehicle Exporters office location"
            ></iframe>
          </div>

          <!-- WhatsApp / Quick Contact -->
          <div class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 rounded-2xl p-6 text-center flex-1 flex flex-col items-center justify-center">
            <h3 class="text-white font-semibold font-[family-name:var(--font-heading)] text-lg mb-2">Need a Quick Response?</h3>
            <p class="text-gray-400 text-sm mb-5">WhatsApp us for your car export and shipping enquiries.</p>
            <a href="https://wa.me/441872491409" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white px-6 py-3 rounded-lg font-semibold transition-all text-sm">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat on WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-12 items-stretch">
        <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center hover:shadow-md transition-shadow h-full flex flex-col justify-center">
          <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5 text-[var(--color-primary)]" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Call Us</h3>
          <a href="tel:+441872491409" class="text-sm text-gray-500 mt-1 block hover:text-[var(--color-primary)]">01872 491409</a>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center hover:shadow-md transition-shadow h-full flex flex-col justify-center">
          <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5 text-[var(--color-primary)]" fill="currentColor" viewBox="0 0 24 24"><path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/><path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Email Us</h3>
          <a href="mailto:sales@vehicleexports.co.uk" class="text-sm text-gray-500 mt-1 block hover:text-[var(--color-primary)]">sales@vehicleexports.co.uk</a>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center hover:shadow-md transition-shadow h-full flex flex-col justify-center">
          <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5 text-[var(--color-primary)]" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Visit Us</h3>
          <p class="text-sm text-gray-500 mt-1">Penstraze Business Park, Truro, Cornwall, TR4 8PN</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center hover:shadow-md transition-shadow h-full flex flex-col justify-center">
          <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5 text-[var(--color-primary)]" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 6a.75.75 0 00-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 000-1.5h-3.75V6z"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Working Hours</h3>
          <p class="text-sm text-gray-500 mt-1">Mon - Fri: 8AM - 6PM</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Pre-fill subject from URL params (e.g., from vehicle enquiry)
  const params = new URLSearchParams(window.location.search);
  const vehicle = params.get('vehicle');
  if (vehicle) {
    const subjectInput = document.getElementById('subject-input') as HTMLInputElement;
    if (subjectInput) subjectInput.value = `Enquiry about ${vehicle}`;
  }
</script>
