---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';
---

<Layout
  title="Car Export Services | UK Vehicle Exporters"
  description="Vehicle sourcing, tax-free supply, RoRo and container shipping, purchase brokerage, UK collection and customs clearance — the full UK vehicle export service."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">Car Export Services</span>
      </nav>
      <h1 class="text-3xl lg:text-5xl font-bold text-white font-[family-name:var(--font-heading)] max-w-3xl">Car Export Services</h1>
      <p class="text-gray-400 mt-4 max-w-2xl leading-relaxed">
        Everything needed to buy a vehicle in the UK and put it in your hands overseas — sourcing, tax-free supply, shipping, collection and customs — from one team.
      </p>
    </div>
  </section>

  <!-- Services grid -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(service => (
          <a href={`/services/${service.slug}`} class="group rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg transition-all">
            <div class="aspect-[16/10] overflow-hidden">
              <img src={service.image} alt={service.name} width="480" height="300" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-5">
              <h2 class="font-bold text-[var(--color-primary)] text-lg font-[family-name:var(--font-heading)] leading-snug">{service.name}</h2>
              <p class="text-sm text-gray-600 mt-2 leading-relaxed">{service.shortDesc}</p>
              <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors mt-4">
                Learn more
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-12 bg-[var(--color-dark)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)] mb-3">Not Sure Where to Start?</h2>
      <p class="text-gray-400 max-w-xl mx-auto mb-6">Tell us what you need and we'll walk you through the whole process, from sourcing to arrival.</p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
        Contact Our Export Team
      </a>
    </div>
  </section>
</Layout>
