---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map(service => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const related = services.filter(s => s.slug !== service.slug);

const site = Astro.site?.href?.replace(/\/$/, '') ?? 'https://vehicleexports.co.uk';
const pageUrl = site + Astro.url.pathname;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Car Export Services', item: site + '/services' },
    { '@type': 'ListItem', position: 3, name: service.name, item: pageUrl },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  serviceType: 'Vehicle export services',
  description: service.metaDescription,
  url: pageUrl,
  areaServed: 'Worldwide',
  provider: {
    '@type': 'Organization',
    name: 'UK Vehicle Exporters',
    url: site,
    telephone: '+44 1872 491409',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Penstraze Business Park',
      addressLocality: 'Truro',
      addressRegion: 'Cornwall',
      postalCode: 'TR4 8PN',
      addressCountry: 'GB',
    },
  },
};
---

<Layout title={`${service.name} | UK Vehicle Exporters`} description={service.metaDescription}>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/services" class="hover:text-[var(--color-primary)] transition-colors">Car Export Services</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">{service.name}</span>
      </nav>
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <h1 class="text-3xl lg:text-5xl font-bold text-white font-[family-name:var(--font-heading)]">{service.name}</h1>
          <p class="text-gray-400 mt-4 text-lg leading-relaxed">{service.intro}</p>
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
              Get a Free Quote
            </a>
            <a href="tel:+441872491409" class="inline-flex items-center gap-2 border-2 border-white/20 hover:border-[var(--color-primary)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
              Call 01872 491409
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img src={service.image} alt={service.name} width="600" height="375" class="rounded-2xl object-cover w-full aspect-[16/10] shadow-2xl" />
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- What you get + How it works -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-6">What You Get</h2>
        <ul class="space-y-4">
          {service.points.map(point => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[var(--color-primary)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span class="text-gray-600 leading-relaxed">{point}</span>
            </li>
          ))}
        </ul>
        {service.links.length > 0 && (
          <div class="mt-8 bg-gray-50 rounded-2xl p-6">
            <h3 class="font-semibold text-gray-900 mb-3 font-[family-name:var(--font-heading)]">Useful Links</h3>
            <ul class="space-y-2">
              {service.links.map(l => (
                <li>
                  <a href={l.href} class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] hover:underline">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    {l.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <div>
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-6">How It Works</h2>
        <ol class="space-y-6">
          {service.steps.map((step, i) => (
            <li class="flex gap-4">
              <span class="w-10 h-10 shrink-0 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] font-bold flex items-center justify-center font-[family-name:var(--font-heading)]">{i + 1}</span>
              <div>
                <h3 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">{step.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed mt-1">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Long-form guide, where the service has one. Sits between the service
       copy and the related-services grid so a reader who wants the detail
       finds it after the summary rather than instead of it. Only
       tax-free-car-exports carries one; every other service renders nothing
       here. -->
  {service.guide && (
    <section class="pt-3 pb-16 lg:pb-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">{service.guide.heading}</h2>
        {service.guide.lead && <p class="text-gray-600 leading-relaxed mb-8">{service.guide.lead}</p>}

        {service.guide.introBullets && (
          <ul class="space-y-4 mb-12">
            {service.guide.introBullets.map(item => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-gray-600 leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        )}

        <div class="space-y-12">
          {service.guide.sections.map(section => (
            <div>
              <h3 class="text-xl lg:text-2xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">{section.heading}</h3>
              <div class="space-y-6">
                {section.blocks.map(block => (
                  <div>
                    {block.title && <h4 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-2">{block.title}</h4>}
                    {block.text?.map(p => <p class="text-gray-600 leading-relaxed mb-3">{p}</p>)}
                    {block.bullets && (
                      <ul class="space-y-2 mb-3">
                        {block.bullets.map(b => (
                          <li class="flex items-start gap-3">
                            <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span class="text-gray-600 leading-relaxed">{b}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                    {block.after?.map(p => <p class="text-gray-600 leading-relaxed mb-3">{p}</p>)}
                    {block.note && <p class="text-gray-500 text-sm italic leading-relaxed">{block.note}</p>}
                  </div>
                ))}
              </div>
              {section.examples && (
                <div class="grid sm:grid-cols-3 gap-4 mt-6">
                  {section.examples.map((ex, i) => (
                    <div class="bg-gray-50 border border-gray-100 rounded-xl p-4">
                      <span class="text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wider">Example {i + 1}</span>
                      <p class="text-sm text-gray-600 leading-relaxed mt-2">{ex}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related services -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-8">Our Other Export Services</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {related.map(s => (
          <a href={`/services/${s.slug}`} class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all">
            <div class="aspect-[16/10] overflow-hidden">
              <img src={s.image} alt={s.name} width="320" height="200" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-4">
              <h3 class="text-sm font-semibold text-gray-900 group-hover:text-[var(--color-primary)] leading-snug transition-colors font-[family-name:var(--font-heading)]">{s.name}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-12 bg-[var(--color-dark)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-white font-[family-name:var(--font-heading)] mb-3">Ready to Get Started?</h2>
      <p class="text-gray-400 max-w-xl mx-auto mb-6">Tell us the vehicle and the destination — we'll confirm the price, the paperwork and the next available sailing.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Contact Our Export Team
        </a>
        <a href="tel:+441872491409" class="inline-flex items-center gap-2 border-2 border-white/20 hover:border-[var(--color-primary)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Call 01872 491409
        </a>
      </div>
    </div>
  </section>
</Layout>
