---
import Layout from '../layouts/Layout.astro';

const quickFacts = [
  { label: 'Shipping Time', value: '3-7 days', sub: 'RoRo, Irish Sea crossing' },
  { label: 'Delivery Ports', value: 'Dublin, Rosslare, Cork', sub: '' },
  { label: 'Irish VAT', value: '23%', sub: 'Charged on customs value' },
  { label: 'Import Duty', value: 'Often 0%', sub: 'Via Returning Goods Relief' },
];

const tocLinks = [
  { href: '#why-ship', label: 'Why ship with UK Vehicle Exporters' },
  { href: '#costs', label: 'Costs & pricing' },
  { href: '#shipping', label: 'Shipping across the Irish Sea' },
  { href: '#import-duty', label: 'Avoiding import duty' },
  { href: '#vat-qualifying', label: 'VAT-qualifying vehicles' },
  { href: '#irish-vat', label: 'Irish VAT explained' },
  { href: '#vrt', label: 'Vehicle Registration Tax' },
  { href: '#ncts', label: 'NCTS & registration' },
  { href: '#arrival', label: 'Arrival in Ireland' },
];

const popularBrands = ['Land Rover', 'MINI', 'BMW', 'Mercedes-Benz', 'Audi', 'Porsche', 'Toyota'];
---

<Layout
  title="Car Shipping to Ireland | UK Vehicle Export - UK Vehicle Exporters"
  description="UK Vehicle Exporters ships quality VAT-qualifying vehicles from the UK to Ireland. Learn about costs, shipping options, import duty relief, Irish VAT, VRT and NCTS registration."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">Car Shipping to Ireland</span>
      </nav>
      <span class="inline-block bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-semibold px-4 py-1.5 rounded-full border border-[var(--color-primary)]/20 mb-4">
        UK to Ireland Export Specialists
      </span>
      <h1 class="text-3xl lg:text-5xl font-bold text-white font-[family-name:var(--font-heading)] max-w-3xl">Car Shipping to Ireland</h1>
      <p class="text-gray-400 mt-4 max-w-2xl text-lg">
        UK Vehicle Exporters sources and exports quality VAT-qualifying vehicles from the UK to Ireland. We handle vehicle
        selection, shipping, VAT and duty relief, and Irish registration support, so you can buy with confidence.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Get a Shipping Quote
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="/carsforexport" class="inline-flex items-center gap-2 border-2 border-white/20 hover:border-[var(--color-primary)] text-white px-6 py-3 rounded-xl font-semibold transition-all">
          Browse Export-Ready Cars
        </a>
      </div>
    </div>
  </section>

  <!-- Key Facts -->
  <section class="relative -mt-8 z-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-6">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          {quickFacts.map((fact) => (
            <div class="text-center">
              <div class="text-xs font-medium text-gray-400 uppercase tracking-wider">{fact.label}</div>
              <div class="text-lg font-bold text-gray-900 mt-1 font-[family-name:var(--font-heading)]">{fact.value}</div>
              {fact.sub && <div class="text-xs text-gray-400 mt-0.5">{fact.sub}</div>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Content -->
        <div class="lg:col-span-2 min-w-0 space-y-14">

          <div id="why-ship">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Why Ship Your Car from the UK to Ireland with UK Vehicle Exporters</h2>
            <p class="text-gray-600 leading-relaxed">
              Buying and exporting a car to Ireland doesn't need to be stressful. UK Vehicle Exporters specialises in sourcing
              and exporting VAT-qualifying vehicles from the UK, with trusted shipping partners covering the Irish
              Sea route and support at every stage, from vehicle selection through to Irish registration.
            </p>
            <div class="grid sm:grid-cols-3 gap-4 mt-6">
              <div class="p-4 bg-gray-50 rounded-xl">
                <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Buy from our stock</h4>
                <p class="text-xs text-gray-500 mt-1">Choose from our export-ready UK vehicles.</p>
              </div>
              <div class="p-4 bg-gray-50 rounded-xl">
                <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">Sourced to order</h4>
                <p class="text-xs text-gray-500 mt-1">Tell us what you need, we'll find it in the UK market.</p>
              </div>
              <div class="p-4 bg-gray-50 rounded-xl">
                <h4 class="font-semibold text-gray-900 text-sm font-[family-name:var(--font-heading)]">You find it, we export it</h4>
                <p class="text-xs text-gray-500 mt-1">Spotted a car elsewhere? We can buy and export it for you.</p>
              </div>
            </div>
          </div>

          <div id="costs">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">What Does It Cost to Import a Car to Ireland?</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              The total cost depends on the vehicle and shipping method, but there are no hidden surprises when
              UK Vehicle Exporters handles it for you. Typical cost considerations include:
            </p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-gray-600"><strong class="text-gray-900">Vehicle price</strong> — VAT-qualifying cars can reduce cost by avoiding UK VAT</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-gray-600"><strong class="text-gray-900">Shipping</strong> — usually £250-£700 depending on vehicle size and crossing</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-gray-600"><strong class="text-gray-900">Import duty</strong> — normally 10%, but often reduced or removed entirely</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-gray-600"><strong class="text-gray-900">Irish VAT</strong> — 23%, applied on the customs value of the vehicle</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-[var(--color-primary)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-gray-600"><strong class="text-gray-900">VRT & NCTS fees</strong> — based on the vehicle's Irish market valuation</span>
              </li>
            </ul>
            <p class="text-gray-600 leading-relaxed mt-4">
              We provide a clear, itemised export quote before you commit to anything — just speak to our team.
            </p>
          </div>

          <div id="shipping">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Shipping Across the Irish Sea</h2>
            <p class="text-gray-600 leading-relaxed mb-6">
              We work with trusted shipping partners to arrange regular, reliable vehicle deliveries from the UK
              to Ireland.
            </p>
            <div class="grid sm:grid-cols-2 gap-4 mb-6">
              <div class="border border-gray-100 rounded-xl p-5">
                <div class="w-10 h-10 bg-[var(--color-primary)]/10 rounded-lg flex items-center justify-center mb-3">
                  <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 17h1l1-5h14l1 5h1m-4 0a2 2 0 11-4 0m-4 0a2 2 0 11-4 0M5 12V7a2 2 0 012-2h10a2 2 0 012 2v5"/></svg>
                </div>
                <h4 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Roll-on / Roll-off (RoRo)</h4>
                <p class="text-sm text-gray-500 mt-1">Ideal for most vehicles — simple, fast, and cost-effective. Typically 3-7 days.</p>
              </div>
              <div class="border border-gray-100 rounded-xl p-5">
                <div class="w-10 h-10 bg-[var(--color-primary)]/10 rounded-lg flex items-center justify-center mb-3">
                  <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7H4a1 1 0 00-1 1v8a1 1 0 001 1h16a1 1 0 001-1V8a1 1 0 00-1-1zM8 7V5a1 1 0 011-1h6a1 1 0 011 1v2M12 7v10M7 12h10"/></svg>
                </div>
                <h4 class="font-semibold text-gray-900 font-[family-name:var(--font-heading)]">Container Shipping</h4>
                <p class="text-sm text-gray-500 mt-1">Extra security, or for multiple vehicles and personal items. Typically 7-14 days.</p>
              </div>
            </div>
            <p class="text-gray-600 leading-relaxed">
              <strong class="text-gray-900">Delivery ports:</strong> Dublin, Rosslare, Cork. We handle every detail
              with our shipping partners — just choose your vehicle and leave the rest to us.
            </p>
          </div>

          <div id="import-duty">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Avoiding the 10% Import Duty</h2>
            <p class="text-gray-600 leading-relaxed mb-6">
              Many vehicles exported from the UK to Ireland do not pay the standard 10% import duty, provided the
              rules are applied correctly. This is where experience really matters.
            </p>

            <h3 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-2">Returning Goods Relief (RGR)</h3>
            <p class="text-gray-600 leading-relaxed mb-4">
              RGR allows certain vehicles being imported into Ireland from the UK to avoid the standard 10% import
              duty, provided they originally came from the EU and are effectively "returning" to it. In practice,
              this means:
            </p>
            <ol class="space-y-3 mb-4">
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">1</span>
                <span class="text-gray-600"><strong class="text-gray-900">The car was originally manufactured in the EU</strong> — built in a country such as Germany, Spain, Italy, or France.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">2</span>
                <span class="text-gray-600"><strong class="text-gray-900">It left the EU less than 3 years ago</strong> — the key timing rule. If more than three years have passed, RGR normally won't apply.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">3</span>
                <span class="text-gray-600"><strong class="text-gray-900">It hasn't been modified outside the EU</strong> — normal wear and servicing are fine, but significant modifications could affect eligibility.</span>
              </li>
            </ol>
            <p class="text-gray-600 leading-relaxed mb-6">If eligible, import duty is reduced to 0%.</p>

            <h3 class="text-lg font-semibold text-gray-900 font-[family-name:var(--font-heading)] mb-2">UK Preferential Origin</h3>
            <p class="text-gray-600 leading-relaxed">
              Some UK-built vehicles may qualify for reduced or zero import duty even when entering the EU from the
              UK — typically prestige, 4x4, and performance models such as Land Rovers and MINIs, manufactured in
              the UK with at least 65% UK-origin components. During your quote, we'll confirm whether the vehicle
              you're interested in qualifies.
            </p>
          </div>

          <div id="vat-qualifying">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">VAT-Qualifying Vehicles & VAT Reclaim</h2>
            <p class="text-gray-600 leading-relaxed">
              In addition to potential import duty savings through RGR, some buyers also benefit from purchasing a
              VAT-qualifying vehicle — an area UK Vehicle Exporters specialises in. A VAT-qualifying car is one where VAT was
              charged when it was first purchased by a business and has not been reclaimed. For export buyers,
              this can allow the 20% UK VAT to be reclaimed, helping to reduce the overall cost of the vehicle.
            </p>
          </div>

          <div id="irish-vat">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Understanding Irish VAT</h2>
            <p class="text-gray-600 leading-relaxed mb-4">Irish VAT is charged at <strong class="text-gray-900">23%</strong>, payable on the customs value of the vehicle, which includes:</p>
            <ul class="space-y-2 mb-4">
              <li class="flex items-center gap-2 text-gray-600"><svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>The car's purchase price</li>
              <li class="flex items-center gap-2 text-gray-600"><svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Shipping and transport costs</li>
              <li class="flex items-center gap-2 text-gray-600"><svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Import duty (if applicable)</li>
            </ul>
            <p class="text-sm text-gray-500 bg-gray-50 rounded-xl p-4">
              <strong class="text-gray-900">Note:</strong> VAT is calculated after any applicable import duty is
              added, so it compounds with the total cost.
            </p>
          </div>

          <div id="vrt">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Vehicle Registration Tax (VRT)</h2>
            <p class="text-gray-600 leading-relaxed mb-4">VRT is calculated in Ireland based on:</p>
            <ul class="space-y-2 mb-4">
              <li class="flex items-center gap-2 text-gray-600"><svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>The vehicle's Irish market value (OMSP)</li>
              <li class="flex items-center gap-2 text-gray-600"><svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>CO2 emissions</li>
              <li class="flex items-center gap-2 text-gray-600"><svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>NOx emissions</li>
            </ul>
            <p class="text-gray-600 leading-relaxed">
              Lower-emission cars mean lower VRT, and electric vehicles can receive up to <strong class="text-gray-900">€5,000</strong> in VRT relief.
              We'll help you estimate VRT before the car leaves the UK, so there are no surprises on arrival.
            </p>
          </div>

          <div id="ncts">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">NCTS Inspection & Registration</h2>
            <p class="text-gray-600 leading-relaxed mb-6">
              The National Car Testing Service (NCTS) inspects imported vehicles to verify their details, calculate
              VRT, and issue an Irish registration number. This inspection is mandatory for all imported vehicles.
            </p>
            <ol class="space-y-3">
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">1</span>
                <span class="text-gray-600"><strong class="text-gray-900">Book inspection</strong> — within 30 days of arrival</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">2</span>
                <span class="text-gray-600"><strong class="text-gray-900">Prepare documents</strong> — logbook, proof of purchase, customs clearance, and ID</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">3</span>
                <span class="text-gray-600"><strong class="text-gray-900">Vehicle inspection</strong> — checks emissions, odometer, and condition</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">4</span>
                <span class="text-gray-600"><strong class="text-gray-900">Pay VRT</strong> — calculated during the inspection</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">5</span>
                <span class="text-gray-600"><strong class="text-gray-900">Receive registration</strong> — fit Irish plates after registration</span>
              </li>
            </ol>
            <p class="text-gray-600 leading-relaxed mt-6">
              You're responsible for booking the NCTS inspection, but our team is on hand to answer any questions
              you have at this stage.
            </p>
          </div>

          <div id="arrival">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Arrival in Ireland: What Happens Next</h2>
            <p class="text-gray-600 leading-relaxed mb-4">Once your vehicle arrives in Ireland:</p>
            <ul class="space-y-2">
              <li class="flex items-center gap-2 text-gray-600"><svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Customs clearance is handled by your agent</li>
              <li class="flex items-center gap-2 text-gray-600"><svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Any taxes are settled correctly</li>
              <li class="flex items-center gap-2 text-gray-600"><svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>NCTS inspection is completed</li>
              <li class="flex items-center gap-2 text-gray-600"><svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Irish plates, tax, and insurance are arranged</li>
            </ul>
            <p class="text-gray-600 leading-relaxed mt-4">
              At every stage, we're on hand to guide you — even after the car has left the UK.
            </p>
          </div>

        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- On this page -->
          <div class="bg-gray-50 rounded-2xl p-6">
            <h3 class="font-semibold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">On This Page</h3>
            <ul class="space-y-2.5">
              {tocLinks.map((link) => (
                <li>
                  <a href={link.href} class="flex items-center gap-2 text-sm text-gray-600 hover:text-[var(--color-primary)] transition-colors">
                    <svg class="w-3.5 h-3.5 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Popular Brands -->
          <div class="bg-gray-50 rounded-2xl p-6">
            <h3 class="font-semibold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">Popular Brands for Ireland</h3>
            <div class="flex flex-wrap gap-2">
              {popularBrands.map((brand) => (
                <span class="bg-white border border-gray-200 text-sm text-gray-700 px-3 py-1.5 rounded-full whitespace-nowrap">{brand}</span>
              ))}
            </div>
          </div>

          <!-- Destination Ports -->
          <div class="bg-gray-50 rounded-2xl p-6">
            <h3 class="font-semibold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">Destination Ports</h3>
            <ul class="space-y-2">
              {['Dublin', 'Rosslare', 'Cork'].map((port) => (
                <li class="flex items-center gap-2 text-sm text-gray-600">
                  <svg class="w-4 h-4 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  {port}
                </li>
              ))}
            </ul>
          </div>

          <!-- Related Reading -->
          <div class="bg-gray-50 rounded-2xl p-6">
