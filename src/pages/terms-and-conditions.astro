---
import LegalPage from '../components/LegalPage.astro';

// These terms deliberately restate what the rest of the site already tells a
// customer, rather than importing generic boilerplate that would contradict it:
//  - the included / excluded lists mirror CountryCosts.astro, which renders the
//    same two lists on all 84 country pages
